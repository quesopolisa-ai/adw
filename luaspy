UI.value_key = function(Value, depth)
	depth = depth or 0
	if type(Value) == "table" then
		if depth > 3 then
			return "{...}"
		end

		local keys = { }
		for key, inner in next, Value do
			table.insert(keys, tostring(key) .. "=" .. UI.value_key(inner, depth + 1))
		end

		table.sort(keys)
		return "{" .. table.concat(keys, ",") .. "}"
	end

	return typeof(Value) .. ":" .. tostring(Value)
end

UI.rule_matches = function(rule, total, ...)
	if rule.Count and rule.Count ~= total then
		return false
	end

	for index, Mode in rule.Modes do
		local Value = (select(index, ...))
		if Mode == "type" then
			if typeof(Value) ~= rule.Types[index] then
				return false
			end
		elseif Mode == "value" and UI.value_key(Value) ~= rule.Values[index] then
			return false
		end
	end

	return true
end

