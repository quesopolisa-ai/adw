UI.net_find = function(module)
	if not active or typeof(module) ~= "Instance" or X.check_caller() then
		return
	end

	local caller = X.get_calling_script()
	if typeof(caller) ~= "Instance" or caller == module then
		return
	end

	local entry = UI.net_loaders[caller]
	if not entry then
		entry = {Count = 0, Hint = 0, Seen = setmetatable({ }, {__mode = "k"})}
		UI.net_loaders[caller] = entry
	end

	if entry.Seen[module] then
		return
	end

	entry.Seen[module] = true
	entry.Count += 1
	if UI.net_hinted(module.Name) then
		entry.Hint += 1
	end

	local Min = tonumber(Settings.NetFinderMin) or 8
	if entry.Count >= Min and not entry.Told then
		entry.Told = true
		task.defer(function()
			local ok, path = pcall(path_of, caller)
			set_status("network finder: " .. (ok and path or caller.Name) .. " loads " .. entry.Count .. "+ modules")
		end)
	end
end

