UI.scan_log_readers = function()
	if not getconnections then
		set_status("no getconnections in this executor: only new MessageOut connections are seen")
		return
	end

	local ok, list = pcall(getconnections, UI.log_service.MessageOut)
	if not ok or type(list) ~= "table" then
		set_status("couldn't read the existing MessageOut connections")
		return
	end

	local seen, disabled = 0, 0
	local raw = raw_debug_info or debug.info
	for _, Connection in list do
		local ok_function, Function = pcall(function() return Connection.Function end)
		if ok_function and type(Function) == "function" and not UI.own_callbacks[Function] then
			local ok_source, source = pcall(raw, Function, "s")
			if not (ok_source and type(source) == "string" and string.find(source, "CoreGui", 1, true)) then
				local from_executor = UI.is_executor_function(Function)
				seen += 1
				if (Settings.LogReaders or Settings.Connections) and not (from_executor and not Settings.Executor) then
					pcall(shared.capture_connect, "Connect", UI.log_service.MessageOut, Function, true)
				end

				if Settings.BlockLogReaders and UI.block_applies(from_executor) and not UI.disabled_readers[Connection] then
					if pcall(function() Connection.Disable(Connection) end) then
						UI.disabled_readers[Connection] = true
						disabled += 1
					end
				end
			end
		end
	end

	set_status("MessageOut: " .. seen .. " existing connection" .. (seen == 1 and "" or "s") .. (Settings.BlockLogReaders and (", " .. disabled .. " disabled") or ""))
end

UI.restore_log_readers = function()
	local count = 0
	for Connection in UI.disabled_readers do
		pcall(function() Connection.Enable(Connection) end)
		UI.disabled_readers[Connection] = nil
		count += 1
	end

	if count > 0 then
		set_status("re-enabled " .. count .. " MessageOut connection" .. (count == 1 and "" or "s"))
	end
end

