UI.log_allowed = function(type_name)
	local Mode = Settings.LogTypes
	if Mode == "errors only" then
		return type_name == "Error"
	elseif Mode == "warnings + errors" then
		return type_name == "Warning" or type_name == "Error"
	elseif Mode == "no info" then
		return type_name ~= "Info"
	end

	return true
end

UI.log_line = function(Message, message_type, stamp)
	local type_name = "Output"
	if typeof(message_type) == "EnumItem" then
		type_name = (string.gsub(message_type.Name, "^Message", ""))
	end

	if not UI.log_allowed(type_name) then
		return
	end

	Message = tostring(Message)
	if ignored[Message] or name_ignored(Message) then
		return
	end

	local before = #queue
	push(Message, type_name, "logservice", nil, false, 2, Message, type_name)
	if type(stamp) == "number" and #queue > before then
		local ok, Text = pcall(os.date, "%H:%M:%S", stamp)
		if ok then
			queue[#queue].Time = Text
		end
	end
end

UI.load_log_backlog = function()
	local ok, history = pcall(function()
		return UI.log_service.GetLogHistory(UI.log_service)
	end)

	if not ok or type(history) ~= "table" then
		set_status("couldn't read the existing output (LogService:GetLogHistory)")
		return
	end

	local loaded = 0
	for index = math.max(1, #history - 499), #history do
		local entry = history[index]
		if type(entry) == "table" then
			UI.log_line(entry.message, entry.messageType, entry.timestamp)
			loaded += 1
		end
	end

	set_status("loaded " .. loaded .. " lines of existing output")
end

do
	local log_busy = false
	local handler = function(Message, message_type)
		if log_busy or not active or paused or not Settings.LogService then
			return
		end

		log_busy = true
		pcall(UI.log_line, Message, message_type)
		log_busy = false
	end

	UI.own_callbacks[handler] = true
	Connect(UI.log_service.MessageOut, handler)
end

