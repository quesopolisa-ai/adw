function __R.install_connections()
	local errors = { }
	local probe = Instance.new("BindableEvent")
	local signal = probe.Event
	if not shared.Installed.ConnectionsNC and X.get_namecall_method then
		local old
		local ok_meta, meta = pcall(function() return getrawmetatable(signal) end)
		local raw = ok_meta and meta and (rawget(meta, "__namecall") or meta.__namecall) or nil
		if type(raw) ~= "function" then
			raw = nil
		end

		local Hook = X.new_c_closure(function(Self, ...)
			local Method = X.get_namecall_method()
			if shared.ConnectionsOn and __R.connect_methods[Method] then
				local captured, block = pcall(shared.capture_connect, Method, Self, ...)
				if setnamecallmethod then
					setnamecallmethod(Method)
				end

				if captured and block == true then
					Self = UI.dummy_event()
				end
			end

			local forward = old
			if forward then
				return forward(Self, ...)
			end

			return Self[Method](Self, ...)
		end)

		local tries = {
			function() return X.hook_function(assert(raw, "no signal __namecall"), Hook) end,
			function() return X.with_identity(hookmetamethod)(signal, "__namecall", Hook) end,
			function()
				local meta = getrawmetatable(signal)
				if setreadonly then
					setreadonly(meta, false)
				end

				local original = meta.__namecall
				meta.__namecall = Hook
				return original
			end,
		}

		for index, try in tries do
			local ok, result = pcall(try)
			if ok then
				old = type(result) == "function" and result or nil
				shared.Installed.ConnectionsNC = true
				if not old then
					table.insert(errors, "nc" .. index .. ": no original returned (using __index fallback)")
				end

				break
			end

			table.insert(errors, "nc" .. index .. ": " .. tostring(result))
		end
	end

	if not shared.Installed.Connections and X.hook_function then
		for _, Name in {"Connect", "Once", "ConnectParallel"} do
			local ok, Error = pcall(function()
				local old
				old = X.hook_function(signal[Name], X.new_c_closure(function(Self, ...)
					if shared.ConnectionsOn then
						local captured, block = pcall(shared.capture_connect, Name, Self, ...)
						if captured and block == true then
							Self = UI.dummy_event()
						end
					end

					return old(Self, ...)
				end))
			end)

			if ok then
				shared.Installed.Connections = true
			else
				table.insert(errors, Name .. ": " .. tostring(Error))
			end
		end
	end

	probe.Destroy(probe)
	local worked = shared.Installed.ConnectionsNC == true or shared.Installed.Connections == true
	if not worked or not shared.Installed.ConnectionsNC then
		shared.ConnectError = table.concat(errors, " | ")
	end

	return worked
end

