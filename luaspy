UI.tidy = function(code)
	local services = { }
	local seen = { }
	local function use(Name)
		if not seen[Name] then
			seen[Name] = true
			table.insert(services, Name)
		end
	end

	local code, characters = string.gsub(code, 'game:GetService%("Players"%)%.LocalPlayer%.Character', "character")
	local code, players = string.gsub(code, 'game:GetService%("Players"%)%.LocalPlayer', "lp")
	code = string.gsub(code, 'game:GetService%("([%w_]+)"%)', function(Name)
		use(Name)
		return (Name == "MarketplaceService" and "market_place" or string.lower(string.gsub(Name, "(%l)(%u)", "%1_%2")))
	end)

	local need_lp = characters > 0 or players > 0
	if need_lp then
		use("Players")
	end

	if #services == 0 then
		return code
	end

	table.sort(services, function(A, B)
		if A == "Players" or B == "Players" then
			return A == "Players" and B ~= "Players"
		end

		return A < B
	end)

	local lines = {"local get_service = game.GetService"}
	for _, Name in services do
		table.insert(lines, "local " .. (Name == "MarketplaceService" and "market_place" or string.lower(string.gsub(Name, "(%l)(%u)", "%1_%2"))) .. " = get_service(game, '" .. Name .. "')")
	end

	if need_lp then
		table.insert(lines, "local lp = players.LocalPlayer")
	end

	if characters > 0 then
		table.insert(lines, "local character = lp.Character")
	end

	return table.concat(lines, "\n") .. "\n\n" .. code
end

UI.read_field = function(buf, Offset, Type, Len)
	local R = UI.buffer_read
	local function fmt(Value)
		return string.format("%.5g", Value)
	end

	if Type == "vec3" or Type == "vec2" then
		local count = Type == "vec3" and 3 or 2
		if Offset + count * 4 > Len then
			return nil, "out of bytes"
		end

		local parts = { }
		for index = 0, count - 1 do
			table.insert(parts, fmt(R.readf32(buf, Offset + index * 4)))
		end

		return (Type == "vec3" and "Vector3.new(" or "Vector2.new(") .. table.concat(parts, ", ") .. ")", count * 4
	elseif Type == "bool" then
		if Offset + 1 > Len then
			return nil, "out of bytes"
		end

		return tostring(R.readu8(buf, Offset) ~= 0), 1
	elseif Type == "string" then
		if Offset + 2 > Len then
			return nil, "out of bytes"
		end

		local size = R.readu16(buf, Offset)
		if Offset + 2 + size > Len then
			return nil, "out of bytes"
		end

		return string.format("%q", R.readstring(buf, Offset + 2, size)), 2 + size
	end

	local field = UI.buffer_fields[Type]
	if not field then
		return nil, "unknown type " .. Type
	end

	if Offset + field[1] > Len then
		return nil, "out of bytes"
	end

	local Value = R[field[2]](buf, Offset)
	return string.find(field[2], "readf", 1, true) and fmt(Value) or tostring(Value), field[1]
end

UI.schema_for = function(Name)
	if not Name then
		return nil
	end

	for entry in string.gmatch(tostring(Settings.PacketSchemas), "[^;]+") do
		local key, rel, spec = string.match(entry, "^%s*([%w_]+)%s*=%s*(%a*)%s*:?%s*(.-)%s*$")
		if key == Name then
			return rel ~= "" and string.lower(rel) or "reliable", spec
		end
	end

	return nil
end

UI.safe_get = function(Table, key)
	local ok, Value = pcall(rawget, Table, key)
	if ok and Value ~= nil then
		return Value
	end

	ok, Value = pcall(function() return Table[key] end)
	return ok and Value or nil
end

UI.auto_index = function()
	local filter = tostring(Settings.PacketModules or "")
	if UI.auto_cache and UI.auto_cache.filter == filter and (#UI.auto_cache.List > 0 or os.clock() - UI.auto_cache.Time < 10) then
		return UI.auto_cache
	end

	local index = {List = { }, ById = { }, ByNum = { }, ByName = { }, filter = filter, Time = os.clock()}
	UI.auto_cache = index
	local get = getupvalues or (debug and debug.getupvalues)
	local names = { }
	pcall(function()
		for _, object in game.GetDescendants(game.GetService(game, "ReplicatedStorage")) do
			if object.IsA(object, "ModuleScript") and object.Name == "ByteNet" then
				for key, Value in require(object) do
					if type(Value) == "table" then
						names[Value] = tostring(key)
					end
				end

				break
			end
		end
	end)

	local function fields(Type)
		if type(Type) ~= "table" or not get then
			return nil
		end

		for _, fn in {Type.read, Type.write} do
			if type(fn) == "function" then
				local ok, ups = pcall(get, fn)
				for _, up in ok and ups or { } do
					if type(up) == "table" and up ~= Type and not names[up] and up.read == nil and next(up) ~= nil then
						local list, all = { }, true
						for key, Value in up do
							if type(key) == "string" and type(Value) == "table" and (names[Value] or Value.read) then
								table.insert(list, key)
							else
								all = false
							end
						end

						if all and #list > 0 then
							table.sort(list)
							return list, up
						end
					end
				end
			end
		end

		return nil
	end

	local function describe(Type, depth)
		if names[Type] then
			return UI.auto_names[string.lower(names[Type])] or names[Type]
		end

		if depth > 4 or type(Type) ~= "table" then
			return "?"
		end

		local list, up = fields(Type)
		if list then
			local parts = { }
			for _, key in list do
				table.insert(parts, key .. ": " .. describe(up[key], depth + 1))
			end

			return "{" .. table.concat(parts, ", ") .. "}"
		end

		for _, fn in {Type.read, Type.write} do
			if type(fn) == "function" and get then
				local ok, ups = pcall(get, fn)
				for _, up in ok and ups or { } do
					if type(up) == "table" and up ~= Type and (names[up] or up.read) then
						return "wrapper<" .. describe(up, depth + 1) .. ">"
					end
				end
			end
		end

		local keys = { }
		for key in Type do
			if #keys < 6 then
				table.insert(keys, tostring(key))
			end
		end

		return "?{" .. table.concat(keys, ",") .. "}"
	end

	local function balanced(Text, from)
		local open = string.find(Text, "[%(%{]", from)
		if not open or open - from > 80 then
			return nil
		end

		local depth = 0
		for position = open, math.min(#Text, open + 3000) do
			local Char = string.sub(Text, position, position)
			if Char == "(" or Char == "{" then
				depth += 1
			elseif Char == ")" or Char == "}" then
				depth -= 1
				if depth == 0 then
					return string.sub(Text, open, position)
				end
			end
		end

		return nil
	end

	local function definition(source, Name)
		local start, after = string.find(source, "[%s,{%.]" .. string.gsub(Name, "%p", "%%%0") .. "%s*=%s*[^=]")
		after = after and after - 1
		if not start then
			start, after = string.find(source, "%[%s*[\"']" .. string.gsub(Name, "%p", "%%%0") .. "[\"']%s*%]%s*=%s*")
		end

		return start and balanced(source, after + 1) or nil
	end

	local function resolve_type(source, word)
		local Lower = string.lower(word)
		if UI.auto_names[Lower] or Lower == "nothing" then
			return UI.auto_names[Lower] or Lower
		end

		local alias = string.match(source, "local%s+" .. word .. "%s*=%s*[%w_]+%.([%a][%w]*)")
		if alias then
			return UI.auto_names[string.lower(alias)] or string.lower(alias)
		end

		return word
	end

	local function table_fields(source, var)
		local list, seen = { }, { }
		local function add(key, expr)
			local word = string.match(expr, "([%a][%w]*)$")
			if word and not seen[key] then
				seen[key] = true
				table.insert(list, {key, resolve_type(source, word)})
			end
		end

		local body = string.match(source, "local%s+" .. var .. "%s*=%s*(%b{})")
		if body and not string.find(string.sub(body, 2, -2), "{", 1, true) then
			for key, expr in string.gmatch(string.sub(body, 2, -2), "([%w_]+)%s*=%s*([%w_%.]+)") do
				add(key, expr)
			end
		end

		for key, expr in string.gmatch(source, var .. "%.([%w_]+)%s*=%s*([%w_%.]+)") do
			add(key, expr)
		end

		table.sort(list, function(A, B) return A[1] < B[1] end)
		return list
	end

	local function parse_args(definition, source)
		local Value = string.find(definition, "value%s*=")
		if not Value then
			return { }, true
		end

		local fn, var = string.match(definition, "value%s*=%s*([%w_%.]+)%s*%(%s*([%w_]+)%s*%)")
		if fn then
			local fn_name = string.match(fn, "([%a][%w]*)$")
			local real = fn_name == "struct" and "struct" or string.match(source, "local%s+" .. fn_name .. "%s*=%s*[%w_]+%.([%a][%w]*)")
			if real == "struct" then
				local list = table_fields(source, var)
				if #list > 0 then
					return list, true
				end
			end

			return nil
		end

		local word = string.match(definition, "value%s*=%s*([%w_%.]+)%s*[,}]")
		if word then
			local Type = resolve_type(source, string.match(word, "([%a][%w]*)$") or word)
			if Type == "nothing" then
				return { }, true
			end

			return {{"value", Type}}, true
		end

		local body = string.match(definition, "value%s*=%s*[%w_%.]-struct%s*%(?%s*(%b{})")
		local list = { }
		if body then
			local inner = string.sub(body, 2, -2)
			if string.find(inner, "[%(%{]") then
				return nil
			end

			for key, Type in string.gmatch(inner, "([%w_]+)%s*=%s*[%w_%.]-([%a][%w]*)%s*[,;\n]") do
				table.insert(list, {key, Type})
			end

			local last = string.match(inner, "([%w_]+)%s*=%s*[%w_%.]-([%a][%w]*)%s*$")
			if last then
				table.insert(list, {last, string.match(inner, "[%w_%.]-([%a][%w]*)%s*$")})
			end

			local seen, unique = { }, { }
			for _, item in list do
				if not seen[item[1]] then
					seen[item[1]] = true
					table.insert(unique, item)
				end
			end

			list = unique
			table.sort(list, function(A, B) return A[1] < B[1] end)
			return list, true
		end

		local single = string.match(definition, "value%s*=%s*[%w_%.]-([%a][%w]*)%s*[,}%)]")
		if single and not string.match(definition, "value%s*=%s*[%w_%.]-[%a][%w]*%s*%(") then
			return {{"value", single}}, true
		end

		return nil
	end

	local get_consts = getconstants or (debug and debug.getconstants)
	local leaves = {{"writef64", "f64"}, {"writef32", "f32"}, {"writei32", "i32"}, {"writeu32", "u32"}, {"writei16", "i16"}, {"writeu16", "u16"}, {"writei8", "i8"}, {"writeu8", "u8"}}
	local function consts(fn)
		local set, list = { }, { }
		local ok, found = pcall(get_consts or function() return { } end, fn)
		for _, Value in ok and type(found) == "table" and found or { } do
			if type(Value) == "string" then
				set[Value] = true
				table.insert(list, Value)
			end
		end

		return set, list
	end

	local function leaf(item)
		if type(item) == "table" then
			item = item.write or item.read
		end

		if type(item) ~= "function" then
			return nil
		end

		local set = consts(item)
		if set.writestring or set.readstring then
			return "string"
		end

		if set.Vector3 or (set.X and set.Y and set.Z) then
			return "vec3"
		end

		for _, pair in leaves do
			if set[pair[1]] or set["read" .. string.sub(pair[1], 6)] then
				return pair[2]
			end
		end

		return nil
	end

	local function struct_of(Table)
		local keys = { }
		for key in Table do
			if type(key) ~= "string" then
				return nil
			end

			table.insert(keys, key)
		end

		if #keys == 0 then
			return nil
		end

		table.sort(keys)
		local out = { }
		for _, key in keys do
			local Type = leaf(Table[key])
			if not Type then
				return nil
			end

			table.insert(out, {key, Type})
		end

		return out
	end

	local function paired_of(ups)
		for _, names in ups do
			if type(names) == "table" and #names > 0 then
				local all_strings = true
				for _, Name in names do
					all_strings = all_strings and type(Name) == "string"
				end

				if all_strings then
					for _, types in ups do
						if types ~= names and type(types) == "table" and #types == #names then
							local out = { }
							for index, Name in names do
								local Type = leaf(types[index])
								if not Type then
									out = nil
									break
								end

								table.insert(out, {Name, Type})
							end

							if out then
								return out
							end
						end
					end
				end
			end
		end

		return nil
	end

	local function probe(packet)
		if not get then
			return nil, "getupvalues is not available"
		end

		local seen, queue, head, fallback = { }, { }, 1, nil
		local Info = { }
		for _, fn in {UI.safe_get(packet, "send"), UI.safe_get(packet, "reader"), UI.safe_get(packet, "listen")} do
			if type(fn) == "function" then
				table.insert(queue, {fn, 1})
			end
		end

		while queue[head] do
			local fn, depth = queue[head][1], queue[head][2]
			head += 1
			if not seen[fn] then
				seen[fn] = true
				local ok, ups = pcall(get, fn)
				ups = ok and ups or { }
				local found = paired_of(ups)
				if found then
					return found
				end

				for index, up in ups do
					if #Info < 8 and head <= 4 then
						local keys = { }
						if type(up) == "table" then
							for key in up do
								if #keys < 5 then
									table.insert(keys, tostring(key))
								end
							end
						elseif type(up) == "function" then
							local _, constants = consts(up)
							for position = 1, math.min(5, #constants) do
								table.insert(keys, constants[position])
							end
						end

						table.insert(Info, "[" .. index .. "]" .. type(up) .. "{" .. table.concat(keys, ",") .. "}")
					end

					if type(up) == "table" then
						if up.write or up.read then
							local inner = up.write or up.read
							if type(inner) == "function" then
								local ok_in, inner_ups = pcall(get, inner)
								local struct = ok_in and paired_of(inner_ups)
								if struct then
									return struct
								end

								for _, inner_up in ok_in and inner_ups or { } do
									if type(inner_up) == "table" and not inner_up.write and not inner_up.read then
										local fields = struct_of(inner_up)
										if fields then
											return fields
										end
									end
								end

								fallback = fallback or leaf(up) and {{"value", leaf(up)}}
							end
						else
							local fields = struct_of(up)
							if fields then
								return fields
							end
						end
					elseif type(up) == "function" and depth < 4 then
						table.insert(queue, {up, depth + 1})
					end
				end
			end
		end

		return fallback, "upvalues of send: " .. table.concat(Info, " ")
	end

	local function is_type(Value)
		return type(Value) == "table" and (names[Value] ~= nil or Value.read ~= nil or Value.write ~= nil)
	end

	local function find_type(packet)
		if packet.value ~= nil then
			return packet.value
		end

		for _, field in packet do
			if is_type(field) then
				return field
			end
		end

		local sources = {packet}
		local meta = getmetatable(packet)
		if type(meta) == "table" and type(meta.__index) == "table" then
			table.insert(sources, meta.__index)
		end

		if get then
			for _, source in sources do
				for _, field in source do
					if type(field) == "function" then
						local ok_up, ups = pcall(get, field)
						for _, up in ok_up and ups or { } do
							if is_type(up) then
								return up
							end
						end
					end
				end
			end
		end

		return nil
	end

	for _, object in game.GetDescendants(game.GetService(game, "ReplicatedStorage")) do
		if object.IsA(object, "ModuleScript") then
			local ok, path = pcall(path_of, object)
			path = ok and path or object.GetFullName(object)
			local source
			if Settings.AutoPackets and (filter == "" or string.find(path, filter, 1, true) or string.find(object.GetFullName(object), filter, 1, true)) and type(decompile) == "function" then
				local ok_source, Text = pcall(decompile, object)
				source = ok_source and type(Text) == "string" and Text or nil
			end

			if filter == "" or string.find(path, filter, 1, true) or string.find(object.GetFullName(object), filter, 1, true) then
				local loaded, result = pcall(require, object)
				if loaded and type(result) == "table" then
					local Packets = type(result.packets) == "table" and result.packets or result
					local pairs = { }
					for Name, packet in Packets do
						table.insert(pairs, {Name, packet})
					end

					if type(result.queries) == "table" and result.queries ~= Packets then
						for Name, packet in result.queries do
							table.insert(pairs, {Name, packet, true})
						end
					end

					for _, pair in pairs do
						local ok_pair, pair_error = pcall(function()
						local Name, packet = pair[1], pair[2]
						if type(packet) == "table" and (UI.safe_get(packet, "reliabilityType") ~= nil or UI.safe_get(packet, "id") ~= nil or UI.safe_get(packet, "send") ~= nil or UI.safe_get(packet, "invoke") ~= nil or UI.safe_get(packet, "value") ~= nil) then
							local entry = {Name = tostring(Name), Query = pair[3] == true, Path = path, Rel = string.lower(tostring(UI.safe_get(packet, "reliabilityType") or "reliable")), Id = tonumber(UI.safe_get(packet, "id") or UI.safe_get(packet, "packetId") or UI.safe_get(packet, "Id")), Args = { }}
							local Value, simple, size = find_type(packet), true, 0
							if not entry.Id and get and type(UI.safe_get(packet, "send")) == "function" then
								local ok_send, send_ups = pcall(get, UI.safe_get(packet, "send"))
								for _, up in ok_send and send_ups or { } do
									if type(up) == "number" and up >= 0 and up < 256 and up == math.floor(up) then
										entry.Id = up
										break
									end
								end
							end

							entry.Type = Value
							entry.Packet = packet
							entry.Via = (type(result.packets) == "table" and result.packets[Name] == packet and "packets") or (type(result.queries) == "table" and result.queries[Name] == packet and "queries") or nil
							if Value == nil and source then
								local def = definition(source, entry.Name)
								if def then
									entry.Known = true
									entry.Def = string.sub((string.gsub(def, "%s+", " ")), 1, 400)
									local parsed = parse_args(def, source)
									if parsed then
										for _, arg in parsed do
											table.insert(entry.Args, {arg[1], UI.auto_names[string.lower(arg[2])] or arg[2]})
										end
									end
								end
							end

							if Value == nil and source and not entry.Def then
								local where = string.find(source, entry.Name, 1, true)
								entry.SourceInfo = "(no definition of " .. entry.Name .. " found in the decompiled source, " .. #source .. " chars" .. (where and (", first mention: " .. string.gsub(string.sub(source, math.max(1, where - 30), where + 160), "%s+", " ")) or ", name not in the source") .. ")"
							elseif not source then
								entry.SourceInfo = "(decompile unavailable or failed for this module)"
							end

							if Value == nil and #entry.Args == 0 and not entry.Def and type(UI.safe_get(packet, "send")) == "function" then
								local found, why = probe(packet)
								if found then
									entry.Args, entry.Known, entry.Probed = found, true, true
									entry.SourceInfo = nil
								else
									entry.SourceInfo = (entry.SourceInfo and (entry.SourceInfo .. " ") or "") .. "(" .. tostring(why) .. ")"
								end
							end

							entry.Known = entry.Known or Value ~= nil
							entry.HasSource = source ~= nil
							entry.Nums, entry.Raw = { }, { }
							for key, field in packet do
								table.insert(entry.Raw, tostring(key) .. ":" .. (type(field) == "number" and tostring(field) or type(field)))
								if type(field) == "number" and string.find(string.lower(tostring(key)), "id") and not entry.Id then
									entry.Id = field
								elseif type(field) == "function" and get then
									local ok_up, ups = pcall(get, field)
									for _, up in ok_up and ups or { } do
										if type(up) == "number" and up >= 0 and up < 256 and up == math.floor(up) then
											entry.Nums[up] = true
										end
									end
								end
							end

							if Value ~= nil then
								local list, up = fields(Value)
								if list then
									for _, key in list do
										table.insert(entry.Args, {key, describe(up[key], 1)})
									end
								else
									table.insert(entry.Args, {"value", describe(Value, 1)})
								end
							end

							local spec = { }
							for _, arg in entry.Args do
								simple = simple and (UI.auto_sizes[arg[2]] ~= nil or arg[2] == "string")
								size += UI.auto_sizes[arg[2]] or 0
								table.insert(spec, arg[1] .. "=" .. arg[2])
							end

							entry.Spec = simple and entry.Known and table.concat(spec, ",") or nil
							entry.Fixed = simple and entry.Known and size or nil
							for _, arg in entry.Args do
								if arg[2] == "string" then
									entry.Fixed = nil
								end
							end

							table.insert(index.List, entry)
							index.ByName[entry.Name] = index.ByName[entry.Name] or entry
							if entry.Id then
								index.ById[entry.Id] = entry
							else
								for number in entry.Nums do
									index.ByNum[number] = index.ByNum[number] or { }
									table.insert(index.ByNum[number], entry)
								end
							end
						end
						end)
						if not ok_pair then
							UI.auto_errors = UI.auto_errors or { }
							if #UI.auto_errors < 5 then
								table.insert(UI.auto_errors, tostring(pair[1]) .. ": " .. tostring(pair_error))
							end
						end
					end
				end
			end
		end
	end

	return index
end

UI.auto_entry = function(Id, Name, avail)
	local ok, index = pcall(UI.auto_index)
	if not ok then
		return nil
	end

	local candidates = { }
	if Id and index.ById[Id] then
		return index.ById[Id]
	end

	for _, entry in Id and index.ByNum[Id] or { } do
		table.insert(candidates, entry)
	end

	local best, score = nil, -1
	for _, entry in candidates do
		local points = 1
		if entry.Known then
			points = 2
			if entry.Fixed and avail then
				if entry.Fixed == avail then
					points = 5
				elseif entry.Fixed == 0 then
					points = 1
				elseif entry.Fixed < avail then
					points = 3
				else
					points = 0
				end
			end
		else
			points = 1.5
		end

		if points > score then
			best, score = entry, points
		end
	end

	if best then
		return best
	end

	return Name and index.ByName[Name] or nil
end

UI.read_spec = function(buf, Offset, entry, Len)
	local parts, used = { }, 0
	for _, arg in entry.Args do
		local Text, size = UI.read_field(buf, Offset + used, arg[2], Len)
		if not Text then
			return nil
		end

		used += size
		table.insert(parts, {arg[1], Text})
	end

	return parts, used
end

UI.member = function(Name)
	if string.match(Name, "^[%a_][%w_]*$") and not UI.keywords[Name] then
		return "." .. Name
	end

	return "[" .. string.format("%q", Name) .. "]"
end

UI.dot_syntax = function(code)
	code = string.gsub(code, "([{,%s])%[\"([%a_][%w_]*)\"%]%s*=", function(before, Name)
		return UI.keywords[Name] and (before .. "[\"" .. Name .. "\"] =") or (before .. Name .. " =")
	end)

	code = string.gsub(code, "([%w_%)%]])%[\"([%a_][%w_]*)\"%]", function(before, Name)
		return UI.keywords[Name] and (before .. "[\"" .. Name .. "\"]") or (before .. "." .. Name)
	end)

	return code
end

UI.auto_lines = function(entry, prefix)
	local lines = {prefix .. "[" .. entry.Name .. "] (" .. entry.Rel .. ")  module: " .. entry.Path}
	if entry.Def then
		table.insert(lines, prefix .. "    definition: " .. entry.Def)
	elseif entry.SourceInfo then
		table.insert(lines, prefix .. "    " .. entry.SourceInfo)
	end

	if #entry.Args == 0 then
		table.insert(lines, prefix .. "    " .. (entry.Known and (entry.Def and not string.find(entry.Def, "value%s*=") and "(no arguments)" or entry.Def and ("definition: " .. entry.Def) or "(no arguments)") or "(arguments unknown)"))
	end

	for _, arg in entry.Args do
		table.insert(lines, prefix .. "    " .. arg[1] .. ": " .. arg[2])
	end

	return lines
end

UI.find_layout = function(Id, avail)
	for entry in string.gmatch(tostring(Settings.BufferLayouts), "[^;]+") do
		local key, Name, spec = string.match(entry, "^%s*([%d%*]+)%s*=?%s*([%w_]*)%s*:%s*(.-)%s*$")
		if key and (key == "*" or tonumber(key) == Id) then
			Name = Name ~= "" and Name or nil
			if spec == "" and Name then
				local _, schema_spec = UI.schema_for(Name)
				spec = schema_spec
			end

			if spec and (spec ~= "" or (Name and UI.schema_for(Name))) then
				return spec, Name
			end
		end
	end

	if Settings.AutoPackets and Id then
		local entry = UI.auto_entry(Id, nil, avail)
		if entry and (entry.Spec or entry.Type) then
			return entry.Spec or "", entry.Name
		end
	end

	return nil
end

UI.guess_packet = function(buf, Len, position, header)
	local R = UI.buffer_read
	if header < 1 then
		return nil
	end

	local Id = R.readu8(buf, position)
	local size
	for Next = position + header + 1, Len - 1 do
		if R.readu8(buf, Next) == Id then
			local candidate = Next - position
			local same = (Len - position) % candidate == 0
			for start = position, Len - 1, candidate do
				same = same and R.readu8(buf, start) == Id
			end

			if same then
				size = candidate
				break
			end
		end
	end

	local End = position + (size or (Len - position))
	local Offset = position + header
	local shown, layout, fields = { }, { }, 0
	while Offset < End do
		local done = false
		if End - Offset >= 8 then
			local Value = R.readf64(buf, Offset)
			if Value == Value and math.abs(Value) >= 1e8 and math.abs(Value) <= 4e9 then
				table.insert(shown, string.format("f64 %.3f (a time?)", Value))
				table.insert(layout, "Time=f64")
				Offset += 8
				done = true
			end
		end

		if not done then
			fields += 1
			table.insert(shown, "u8 " .. R.readu8(buf, Offset))
			table.insert(layout, "Field" .. fields .. "=u8")
			Offset += 1
		end
	end

	local lines = {
		"--   guess" .. (size and (": " .. size .. " bytes per packet, " .. ((Len - position) // size) .. " in this buffer") or "") .. " -> " .. table.concat(shown, ", "),
		"--   try layout  " .. Id .. ":" .. table.concat(layout, ","),
	}

	return lines, size
end

UI.describe_buffer = function(buf, arg_index, reliability)
	local R = UI.buffer_read
	local Len = R.len(buf)
	local header = math.max(0, tonumber(Settings.BufferHeader) or 0)
	local lines = {string.format("-- buffer arg %d: %d bytes", arg_index, Len)}
	local position, guard = 0, 0
	local function hex(from)
		local bytes = { }
		for index = from, math.min(Len, from + 48) - 1 do
			table.insert(bytes, string.format("%02x", R.readu8(buf, index)))
		end

		return table.concat(bytes, " ") .. (Len - from > 48 and " ..." or "")
	end

	while position < Len and guard < 20 do
		guard += 1
		local Id = header > 0 and R.readu8(buf, position) or nil
		local layout, packet_name = UI.find_layout(Id, Len - position - header)
		if not layout then
			table.insert(lines, "--   " .. (Id and ("packet id " .. Id .. ", ") or "") .. "no layout (add  " .. (Id or "*") .. ":name=type,...  in settings). raw: " .. hex(position))
			local ok_guess, guess, guess_size = pcall(UI.guess_packet, buf, Len, position, header)
			if Settings.AutoPackets then
				local ok_auto, index = pcall(UI.auto_index)
				local entry = ok_auto and Id and index.ById[Id]
				if Settings.PacketDump and ok_auto then
					table.insert(lines, "--   packet dump (" .. #index.List .. " packets):")
					for _, candidate in index.List do
						table.insert(lines, "--     " .. candidate.Name .. " (" .. candidate.Rel .. ") id=" .. tostring(candidate.Id) .. " fixed=" .. tostring(candidate.Fixed) .. " raw={" .. table.concat(candidate.Raw, ",") .. "}")
						for _, arg in candidate.Args do
							table.insert(lines, "--         " .. arg[1] .. ": " .. arg[2])
						end
					end
				end

				if ok_auto and not entry and Id and index.ByNum[Id] then
					table.insert(lines, "--   module packets whose functions hold the number " .. Id .. " (probably the id):")
					for _, candidate in index.ByNum[Id] do
						for _, line in UI.auto_lines(candidate, "--     ") do
							table.insert(lines, line)
						end
					end
				elseif not ok_auto or #index.List == 0 then
					table.insert(lines, "--   packet modules: none found (path has to contain \"" .. tostring(Settings.PacketModules) .. "\")")
				elseif entry then
					table.insert(lines, "--   module packet:")
					for _, line in UI.auto_lines(entry, "--     ") do
						table.insert(lines, line)
					end
				else
					local count = 0
					for _, candidate in index.List do
						if guess_size and candidate.Fixed and candidate.Fixed + header == guess_size and count < 6 then
							count += 1
							if count == 1 then
								table.insert(lines, "--   module packets with a matching size (" .. guess_size .. " bytes, id not exposed by the module):")
							end

							for _, line in UI.auto_lines(candidate, "--     ") do
								table.insert(lines, line)
							end
						end
					end

					if count == 0 then
						table.insert(lines, "--   " .. #index.List .. " module packets known, none matches id " .. tostring(Id) .. (guess_size and (" / size " .. guess_size) or ""))
					end
				end
			end

			if ok_guess and guess then
				for _, line in guess do
					table.insert(lines, line)
				end
			end

			break
		end

		local schema_rel, schema_spec = UI.schema_for(packet_name)
		local auto = Settings.AutoPackets and Id and UI.auto_entry(Id, packet_name, Len - position - header) or nil
		if auto then
			reliability = auto.Rel
			for _, line in UI.auto_lines(auto, "--   module ") do
				table.insert(lines, line)
			end

			if auto.Type and type(auto.Type.read) == "function" then
				local ok_read, Value, used = pcall(auto.Type.read, buf, position + header)
				if ok_read and type(used) == "number" and used >= 0 then
					if used > Len - (position + header) then
						used -= position + header
					end

					if type(Value) == "table" then
						local keys = { }
						for key in Value do
							table.insert(keys, tostring(key))
						end

						table.sort(keys)
						for _, key in keys do
							local item = Value[key] ~= nil and Value[key] or Value[tonumber(key)]
							table.insert(lines, "--       " .. key .. ": " .. typeof(item) .. " = " .. tostring((serialize(item, 0))))
						end
					else
						table.insert(lines, "--       value: " .. typeof(Value) .. " = " .. tostring((serialize(Value, 0))))
					end

					position += header + used
					continue
				end
			elseif not auto.Known then
				table.insert(lines, "--       (argument types not found: " .. (auto.HasSource and "the packet's definition was not found in the decompiled module" or "decompile is not available or failed on the module") .. ")")
			elseif auto.Def and not auto.Spec then
				table.insert(lines, "--       definition: " .. auto.Def)
			end
		end

		if schema_rel then
			reliability = schema_rel
		end

		if Settings.ShowSchema and schema_rel then
			table.insert(lines, "--   schema [" .. packet_name .. "] (" .. schema_rel .. ")")
			if schema_spec == "" then
				table.insert(lines, "--       (no arguments)")
			else
				for piece in string.gmatch(schema_spec, "[^,]+") do
					local field_name, field_type = string.match(piece, "^%s*(.-)%s*=%s*(.-)%s*$")
					table.insert(lines, "--       " .. (field_name or piece) .. ": " .. (field_type or "?"))
				end
			end
		end

		if Settings.BufferFull then
			table.insert(lines, "--   [" .. (packet_name or ("packet " .. tostring(Id or "?"))) .. "] (" .. (reliability or "reliable") .. (Id and (", id " .. Id) or "") .. ")")
		else
			table.insert(lines, "--   packet" .. (packet_name and (" " .. packet_name) or "") .. (Id and (" id " .. Id) or "") .. ":")
		end

		local Offset, failed = position + header, false
		for piece in string.gmatch(layout, "[^,]+") do
			piece = string.match(piece, "^%s*(.-)%s*$")
			local Name, Type = string.match(piece, "^(.-)%s*=%s*(.+)$")
			Type = string.lower((Type or piece))
			Name = Name or Type
			local Text, size = UI.read_field(buf, Offset, Type, Len)
			if not Text then
				table.insert(lines, "--     " .. Name .. " = <" .. tostring(size) .. ">")
				failed = true
				break
			end

			table.insert(lines, "--     " .. Name .. (Settings.BufferFull and (": " .. Type .. " = ") or " = ") .. Text)
			Offset += size
		end

		if failed then
			break
		end

		position = Offset
	end

	if position < Len and guard >= 20 then
		table.insert(lines, "--   ... " .. (Len - position) .. " more bytes")
	end

	return lines
end

UI.buffer_call = function(Log)
	local buf
	for index = 1, Log.Count do
		if typeof(Log.Args[index]) == "buffer" then
			buf = Log.Args[index]
		end
	end

	if not buf then
		return nil
	end

	local R = UI.buffer_read
	local Len = R.len(buf)
	local header = math.max(0, tonumber(Settings.BufferHeader) or 0)
	local position, calls, mods, order = 0, { }, { }, { }
	local filter = Settings.BufferCodeMode == "filtergc"
	while position < Len and #calls < 20 do
		local entry = header > 0 and UI.auto_entry(R.readu8(buf, position), nil, Len - position - header) or nil
		if not entry or not entry.Known then
			return nil
		end

		local Value, used = "", 0
		if #entry.Args > 0 then
			if not entry.Spec then
				return nil
			end

			local parts, count = UI.read_spec(buf, position + header, entry, Len)
			if not parts then
				return nil
			end

			used = count
			if #parts == 1 and parts[1][1] == "value" then
				Value = parts[1][2]
			else
				local items = { }
				for _, part in parts do
					local number = tonumber(part[2])
					local Text = (number and string.find(string.lower(part[1]), "time")) and "workspace:GetServerTimeNow()" or part[2]
					table.insert(items, (string.sub(UI.member(part[1]), 1, 1) == "." and part[1] or ("[" .. string.format("%q", part[1]) .. "]")) .. " = " .. Text)
				end

				Value = "{" .. table.concat(items, ", ") .. "}"
			end
		end

		position += header + used
		if not filter and not mods[entry.Path] then
			mods[entry.Path] = #order + 1
			table.insert(order, entry.Path)
		end

		local Method = entry.Query and "invoke" or "send"
		local holder = filter and ("find_packet(" .. string.format("%q", entry.Name) .. ", " .. string.format("%q", Method) .. ")") or ((entry.Query and "queries_" or "packets_") .. mods[entry.Path] .. UI.member(entry.Name))
		local call = holder .. "." .. Method .. "(" .. Value .. ")"
		table.insert(calls, entry.Query and ("print(" .. call .. ")") or call)
	end

	if position ~= Len then
		return nil
	end

	local out = {"-- the same packets through the game's own modules (no raw buffer)"}
	if filter then
		table.insert(out, UI.packet_helper)
	else
		for number, path in order do
			table.insert(out, "local module_" .. number .. " = require(" .. path .. ")")
			table.insert(out, "local packets_" .. number .. " = module_" .. number .. ".packets or module_" .. number)
			table.insert(out, "local queries_" .. number .. " = module_" .. number .. ".queries or { }")
		end
	end

	table.insert(out, "")
	for _, call in calls do
		table.insert(out, call)
	end

	return table.concat(out, "\n")
end

UI.buffer_notes = function(Log)
	local lines = { }
	local ok_class, class = pcall(function() return Log.Remote.ClassName end)
	local reliability = (ok_class and class == "UnreliableRemoteEvent") and "unreliable" or "reliable"
	for index = 1, Log.Count do
		if typeof(Log.Args[index]) == "buffer" then
			local ok, result = pcall(UI.describe_buffer, Log.Args[index], index, reliability)
			if ok then
				for _, line in result do
					table.insert(lines, line)
				end
			end
		end
	end

	return lines
end

function __R.generate_raw(Log)
	if Log.Kind == "http" then
		local lines = {"-- generated by Larp Spy"}
		if Log.Executor then
			table.insert(lines, "-- sent by an executor script")
		elseif Log.Script then
			local ok, path = pcall(path_of, Log.Script)
			table.insert(lines, "-- caller: " .. (ok and path or name_of(Log.Script)))
		end

		table.insert(lines, "")
		local parts = { }
		for index = 1, Log.Count do
			table.insert(parts, (serialize(Log.Args[index], 0)))
		end

		local arg_text = table.concat(parts, ", ")
		local Method = Log.Method
		if Method == "request" then
			table.insert(lines, "local response = request(" .. arg_text .. ")\n\nprint(response.StatusCode, response.Body)")
		elseif Method == "RequestAsync" then
			table.insert(lines, 'local response = game:GetService("HttpService"):RequestAsync(' .. arg_text .. ")\n\nprint(response.StatusCode, response.Body)")
		elseif string.find(Method, "^Http") then
			table.insert(lines, "local response = game:" .. Method .. "(" .. arg_text .. ")\n\nprint(response)")
		else
			table.insert(lines, 'local response = game:GetService("HttpService"):' .. Method .. "(" .. arg_text .. ")\n\nprint(response)")
		end

		return UI.tidy(table.concat(lines, "\n"))
	end

	if Log.Kind == "logservice" then
		local Message = Log.Args and Log.Args[1]
		if type(Message) ~= "string" then
			Message = tostring(Log.Remote)
		end

		local Text = quote(Message)
		local line
		if Log.Method == "Warning" then
			line = "warn(" .. Text .. ")"
		elseif Log.Method == "Error" then
			line = "task.spawn(error, " .. Text .. ", 0)"
		else
			line = "print(" .. Text .. ")"
		end

		return UI.tidy(table.concat({
			"-- generated by Larp Spy",
			"-- LogService.MessageOut: " .. tostring(Log.Method) .. (Log.Time and ("  [" .. Log.Time .. "]") or ""),
			"",
			line,
		}, "\n"))
	end

	local context = {NeedsNil = false}
	local actor_thread
	local setup = { }
	local target = display_path(Log, context)
	local Unpack = Settings.Unpack
	local count = Log.Count
	local kind = Log.Kind
	if kind == "purchase" then
		target = 'game:GetService("MarketplaceService")'
	end

	if kind == "raknet" then
		return UI.raknet_code(Log)
	end

	if kind == "anim" and UI.anim_code then
		return UI.anim_code(Log.Args[1])
	end

	if Settings.RemoteVariable and kind ~= "require" and kind ~= "debuginfo" and kind ~= "create" and kind ~= "lib" and kind ~= "wait" then
		local variable = (kind == "kick" and "player") or (kind == "corestate" and "starterGui") or (kind == "teleport" and "teleportService") or (kind == "purchase" and "marketplaceService") or (kind == "bindable" and "bindable") or (Log.Signal and "signal") or (kind == "prompt" and "prompt") or (kind == "touch" and "part") or (kind == "click" and "detector") or (kind == "tool" and "tool") or (kind == "actormsg" and "actor") or "remote"
		table.insert(setup, "local " .. variable .. " = " .. target)
		target = variable
	end

	local setup_before = #setup
	local arg_text = ""
	if count > 0 and kind ~= "require" then
		local Style = Settings.CodeStyle
		if Style == "inline" then
			local parts = { }
			for index = 1, count do
				table.insert(parts, arg_code(Log, index, 0, context))
			end

			arg_text = table.concat(parts, ", ")
		elseif Style == "variables" then
			local names = { }
			for index = 1, count do
				table.insert(setup, "local arg" .. index .. " = " .. arg_code(Log, index, 0, context))
				table.insert(names, "arg" .. index)
			end

			arg_text = table.concat(names, ", ")
		else
			local holes = false
			local lines = {"local args = {"}
			for index = 1, count do
				local Value = Log.Args[index]
				if Value == nil then
					holes = true
				end

				if Style == "array" then
					table.insert(lines, "    " .. arg_code(Log, index, 1, context) .. ",")
				elseif Value ~= nil then
					table.insert(lines, "    [" .. index .. "] = " .. arg_code(Log, index, 1, context) .. ",")
				end
			end

			table.insert(lines, "}")
			if #setup > 0 then
				table.insert(setup, "")
			end

			table.insert(setup, table.concat(lines, "\n"))
			arg_text = holes and (Unpack .. "(args, 1, " .. count .. ")") or (Unpack .. "(args)")
		end
	end

	local up_list = Log.Args.Up or Log.UpFallback
	if count > 0 and kind ~= "require" and up_list and Settings.CodeStyle ~= "inline" then
		local functions, order = { }, { }
		local used = { }
		local changed = false
		local complex = false
		local bumps, bump_vars = { }, { }
		local function function_var(found)
			local key = found.Source .. "|" .. found.Name .. "|" .. tostring(found.Line)
			if not functions[key] then
				local var = string.match(found.Name, "^[%a_][%w_]*$") and found.Name or "game_function"
				if used[var] then
					var = var .. (used[var] + 1)
				end

				used[var] = (used[var] or 0) + 1
				functions[key] = {Var = var, Found = found}
				table.insert(order, key)
			end

			return functions[key].Var
		end

		local function changes(leaf)
			local history = Log.History
			if not history or #history < 2 then
				return false
			end

			if leaf.KeyLeaf then
				for _, record in history do
					local tbl = record.Args[leaf.Index]
					if type(tbl) ~= "table" or tbl[leaf.Key] == nil then
						return true
					end
				end

				return false
			end

			local first = nil
			for _, record in history do
				local Value = record.Args[leaf.Index]
				if leaf.Key ~= nil then
					Value = type(Value) == "table" and Value[leaf.Key] or nil
				end

				if first == nil then
					first = Value
				elseif Value ~= first then
					return true
				end
			end

			return false
		end

		local function step(leaf)
			local history = Log.History
			if not history or #history < 2 then
				return nil
			end

			local delta, previous = nil, nil
			for _, record in history do
				local Value = record.Args[leaf.Index]
				if leaf.Key ~= nil then
					Value = type(Value) == "table" and Value[leaf.Key] or nil
				end

				if type(Value) ~= "number" then
					return nil
				end

				if previous ~= nil then
					local difference = Value - previous
					if difference < 0 or (difference > 0 and delta ~= nil and difference ~= delta) then
						return nil
					end

					if difference > 0 then
						delta = difference
					end
				end

				previous = Value
			end

			return delta
		end

		for _, leaf in up_list do
			local current = Log.Args[leaf.Index]
			if leaf.KeyLeaf then
				current = leaf.Key
			elseif leaf.Key ~= nil then
				current = type(current) == "table" and current[leaf.Key] or nil
			end

			if (type(current) ~= "number" and type(current) ~= "string") or not changes(leaf) then
				continue
			end

			local found = leaf.Found[1]
			if leaf.KeyLeaf then
				for _, candidate in leaf.Found do
					if not candidate.KeyOf then
						found = candidate
						break
					end
				end
			end

			local var = function_var(found)
			if found.Field ~= nil or found.KeyOf or found.ToNumber then
				complex = true
			end

			if (type(current) == "number" or type(current) == "string") and found.Field == nil then
				for _, e in functions do
					if e.Var == var and e.Fallback == nil then
						e.Fallback = current
					end
				end
			end

			local expr = "debug.getupvalue(" .. var .. ", " .. found.Up .. ")"
			local access = ""
			if found.Field ~= nil then
				access = found.Field
				expr ..= access
			end

			if found.ToNumber then
				expr = "tonumber(" .. expr .. ")"
			end

			if found.KeyOf then
				expr = "(next(" .. expr .. "))"
			end

			local delta = type(current) == "number" and not found.ToNumber and step(leaf) or nil
			if delta then
				local bump_key = var .. "|" .. found.Up .. "|" .. tostring(found.Field)
				if not bump_vars[bump_key] then
					local base = (type(leaf.Key) == "string" and string.match(leaf.Key, "^[%a_][%w_]*$")) and leaf.Key or ("arg" .. leaf.Index)
					bump_vars[bump_key] = "next_" .. base
					table.insert(bumps, {Var = bump_vars[bump_key], Fn = var, Up = found.Up, Access = access, Delta = delta})
				end

				expr = bump_vars[bump_key]
			end

			local note = #leaf.Found > 1 and (" -- could also be upvalue " .. leaf.Found[2].Up) or ""
			if leaf.KeyLeaf then
				local token = "[" .. serialize(leaf.Key) .. "]"
				for index = setup_before + 1, #setup do
					local Text = setup[index]
					local start, stop = string.find(Text, token, 1, true)
					if start then
						setup[index] = string.sub(Text, 1, start - 1) .. "[" .. expr .. "]" .. string.sub(Text, stop + 1)
						changed = true
						break
					end
				end

				continue
			end

			local Value = serialize(current)
			local prefix
			if leaf.Key ~= nil then
				prefix = (type(leaf.Key) == "string" and string.match(leaf.Key, "^[%a_][%w_]*$")) and (leaf.Key .. " = ") or ("[" .. serialize(leaf.Key) .. "] = ")
			elseif Settings.CodeStyle == "variables" then
				prefix = "local arg" .. leaf.Index .. " = "
			elseif Settings.CodeStyle == "array" then
				prefix = "    "
			else
				prefix = "[" .. leaf.Index .. "] = "
			end

			local tail = Settings.CodeStyle == "variables" and leaf.Key == nil and "" or ","
			for index = setup_before + 1, #setup do
				local Text = setup[index]
				local start, stop = string.find(Text, prefix .. Value .. tail, 1, true)
				if start then
					setup[index] = string.sub(Text, 1, start - 1) .. prefix .. expr .. tail .. note .. string.sub(Text, stop + 1)
					changed = true
					break
				end
			end
		end

		if changed and #order > 0 and (complex or #bumps > 0) then
			local head = {
				"-- several copies of the function can exist (old ones are not collected yet): the one with the highest counter is the live one",
				"local function find_function(source, name, line, up, fuzzy)",
				"    local best, bestValue, loose, near, nearDiff",
				"    local list = filtergc and select(2, pcall(filtergc, \"function\", {IgnoreExecutor = true}))",
				"    if type(list) ~= \"table\" then list = getgc() end",
				"    for i = 1, #list do",
				"        local f = list[i]",
				"        if type(f) == \"function\" then",
				"            local l = debug.info(f, \"l\")",
				"            if l == line then",
				"                local src = debug.info(f, \"s\")",
				"                if src == source and debug.info(f, \"n\") == name then",
				"                    local ok, value = pcall(debug.getupvalue, f, up)",
				"                    if not up or not ok or type(value) ~= \"number\" then",
				"                        best = best or f",
				"                    elseif not bestValue or value > bestValue then",
				"                        best, bestValue = f, value",
				"                    end",
				"                elseif not loose and type(src) == \"string\" and src:find(source, 1, true) then",
				"                    loose = f",
				"                end",
				"            elseif fuzzy and type(l) == \"number\" and debug.info(f, \"s\") == source then",
				"                -- the game was updated and the line moved: closest function of the same script that has a number at that upvalue slot",
				"                local ok, value = pcall(debug.getupvalue, f, up)",
				"                if ok and type(value) == \"number\" and (not nearDiff or math.abs(l - line) < nearDiff) then",
				"                    near, nearDiff = f, math.abs(l - line)",
				"                end",
				"            end",
				"        end",
				"    end",
				"    return best or loose or near",
				"end",
				"",
			}

			for _, key in order do
				local entry = functions[key]
				table.insert(head, "local " .. entry.Var .. " = find_function(" .. string.format("%q", entry.Found.Source) .. ", " .. string.format("%q", entry.Found.Name) .. ", " .. tostring(entry.Found.Line) .. ", " .. tostring(entry.Found.Up) .. ", true) or error(" .. string.format("%q", "couldn't find " .. (entry.Found.Name ~= "" and entry.Found.Name or entry.Var) .. " (do the action in-game first)") .. ", 0)")
			end

			if #bumps > 0 then
				table.insert(head, "")
				for _, bump in bumps do
					if bump.Access ~= "" then
						table.insert(head, "local " .. bump.Var .. "_state = debug.getupvalue(" .. bump.Fn .. ", " .. bump.Up .. ")")
						table.insert(head, "local " .. bump.Var .. " = " .. bump.Var .. "_state" .. bump.Access .. " + " .. number(bump.Delta))
						table.insert(head, bump.Var .. "_state" .. bump.Access .. " = " .. bump.Var .. " -- keep the game's counter in step")
					else
						table.insert(head, "local " .. bump.Var .. " = debug.getupvalue(" .. bump.Fn .. ", " .. bump.Up .. ") + " .. number(bump.Delta))
						table.insert(head, "debug.setupvalue(" .. bump.Fn .. ", " .. bump.Up .. ", " .. bump.Var .. ") -- keep the game's counter in step")
					end
				end
			end

			table.insert(head, "")
			table.insert(setup, setup_before + 1, table.concat(head, "\n"))
		elseif changed and #order > 0 then
			local thread_index = tonumber(string.match(tostring(Log.Actor), "^actor thread (%d+)$"))
			if Log.Actor then
				actor_thread = thread_index or 1
			end

			local head = {
				actor_thread and "-- the call came from an actor: the whole script runs inside that actor thread (run_on_thread), so the game function, the upvalue and the remote are all in the same VM" or "-- the call came from the main thread: the upvalue and the remote are both used in this same VM",
				"",
				[=[local function grab_upvalue(source, line, up)
    local best, bestDiff
    for _, f in filtergc and filtergc("function", {IgnoreExecutor = true}) or getgc() do
        if type(f) == "function" then
            local src = debug.info(f, "s")
            if type(src) == "string" and (src == source or src:find(source, 1, true)) then
                local ok, upvalue = pcall(debug.getupvalue, f, up)
                local diff = math.abs(debug.info(f, "l") - line)
                -- the function closest to the captured line that has a value in that upvalue slot
                if ok and upvalue ~= nil and (bestDiff == nil or diff < bestDiff) then
                    best, bestDiff = upvalue, diff
                end
            end
        end
    end
    return best
end]=],
			}

			for _, key in order do
				local entry = functions[key]
				local Name = entry.Var .. "_up" .. tostring(entry.Found.Up)
				table.insert(head, "local " .. Name .. " = grab_upvalue(" .. string.format("%q", entry.Found.Source) .. ", " .. tostring(entry.Found.Line) .. ", " .. tostring(entry.Found.Up) .. ")")
				table.insert(head, "if " .. Name .. " == nil then return warn(\"not found\") end")
				for index, Text in setup do
					setup[index] = string.gsub(Text, "debug%.getupvalue%(" .. entry.Var .. ", " .. tostring(entry.Found.Up) .. "%)", function() return Name end)
				end
			end

			table.insert(head, "")
			table.insert(setup, setup_before + 1, table.concat(head, "\n"))
		end
	end

	local call
	if kind == "incoming" then
		call = "firesignal(" .. target .. ".OnClientEvent" .. (arg_text ~= "" and (", " .. arg_text) or "") .. ")"
	elseif kind == "require" then
		call = "require(" .. target .. ")"
	elseif kind == "debuginfo" then
		call = "debug.info(" .. arg_text .. ")"
	elseif kind == "create" or kind == "lib" or kind == "wait" then
		call = target .. "(" .. arg_text .. ")"
	elseif kind == "parentnil" then
		call = target .. ".Parent = nil"
	elseif kind == "guiclick" then
		local lines = { }
		for _, Name in UI.gui_signals(Log.Remote) do
			table.insert(lines, "firesignal(" .. target .. "." .. Name .. ")")
		end

		call = table.concat(lines, "\n")
	elseif kind == "touch" or kind == "click" then
		call = Log.Method .. "(" .. target .. (arg_text ~= "" and (", " .. arg_text) or "") .. ")"
	elseif kind == "prompt" then
		call ="fireproximityprompt(" .. target .. (arg_text ~= "" and (", " .. arg_text) or "") .. ")"
	elseif kind == "connection" then
		call = target .. ":" .. Log.Method .. "(" .. arg_text .. ")"
	elseif kind == "purchase" then
		local method_name = Log.Method
		if string.find(method_name, "Finished$") and not string.find(method_name, "^Signal") then
			call = "firesignal(" .. target .. "." .. method_name .. (arg_text ~= "" and (", " .. arg_text) or "") .. ")"
		elseif method_name == "UserOwnsGamePassAsync" or method_name == "PlayerOwnsAsset" then
			call = "local owns = " .. target .. ":" .. method_name .. "(" .. arg_text .. ")\n\nprint(owns)"
		else
			call = target .. ":" .. method_name .. "(" .. arg_text .. ")"
		end
	elseif Log.Signal then
		call = kind .. "(" .. target .. (arg_text ~= "" and (", " .. arg_text) or "") .. ")"
	elseif Settings.CallViaFunction and Log.Info and not Log.Actor and (kind == "event" or kind == "unreliable" or kind == "function") then
		local with_args = Settings.CallMode == "with args"
		local Info = with_args and Log.Info or (Log.Info.Outer or Log.Info)
		local no_args = not with_args
		if no_args then
			for index = #setup, 1, -1 do
				setup[index] = nil
			end
		end

		table.insert(setup, table.concat({
			"local function find_caller(source, name, line, params, vararg)",
			"    local options = {IgnoreExecutor = true}",
			"    options.Name = name",
			"    local ok, list = pcall(filtergc, \"function\", options)",
			"    if not ok or type(list) ~= \"table\" then list = getgc() end",
			"    local best, bestLine",
			"    for _, f in list do",
			"        if type(f) == \"function\" and debug.info(f, \"s\") == source and (not name or debug.info(f, \"n\") == name) then",
			"            local defined = debug.info(f, \"l\")",
			"            local count, var = debug.info(f, \"a\")",
			"            -- the captured line is where the function was running, so the function is the closest one that starts at or before it",
			"            if (not params or count == params) and var == vararg and defined <= line and (not bestLine or defined > bestLine) then",
			"                best, bestLine = f, defined",
			"            end",
			"        end",
			"    end",
			"    return best",
			"end",
			"",
			"local caller_function = find_caller(" .. string.format("%q", tostring(Info.Source)) .. ", " .. (Info.Name and string.format("%q", Info.Name) or "nil") .. ", " .. tostring(tonumber(Info.Line) or 0) .. ", " .. (Info.Params and tostring(Info.Params) or "nil") .. ", " .. tostring(Info.Vararg and true or false) .. ")",
			"if not caller_function then error(\"couldn't find the game function (do the action in-game first)\", 0) end",
			no_args and "-- mode \"no args\": the game function that leads to the remote is called without arguments, it sends them itself" or "-- mode \"with args\": the function that fired the remote is called with the captured arguments (a method would also need its self)",
		}, "\n"))
		call = "caller_function(" .. (no_args and "" or arg_text) .. ")"
	else
		call = target .. ":" .. (string.gsub(Log.Method, "^%l", string.upper)) .. "(" .. arg_text .. ")"
	end

	if kind == "getattr" and Settings.GetAttrCodeSet and count > 0 and Log.Method == "GetAttribute" then
		local bool_value = Settings.GetAttrBool == "flip" and "not result" or (Settings.GetAttrBool == "false" and "false" or "true")
		local number_value = number(tonumber(Settings.GetAttrNumber) or 100)
		local string_value = string.format("%q", tostring(Settings.GetAttrString or ""))
		call = table.concat({
			"local instance = " .. target,
			"local name = " .. arg_text,
			"local result = instance:GetAttribute(name)",
			"print(result)",
			"",
			"-- change the value",
			"if typeof(result) == \"boolean\" then",
			"    instance:SetAttribute(name, " .. BoolValue .. ")",
			"elseif typeof(result) == \"number\" then",
			"    instance:SetAttribute(name, " .. NumberValue .. ")",
			"elseif typeof(result) == \"string\" then",
			"    instance:SetAttribute(name, " .. StringValue .. ")",
			"end",
		}, "\n")
	end

	local returns = (kind == "function" or kind == "getattr" or kind == "loghistory" or kind == "require" or kind == "debuginfo" or (kind == "bindable" and Log.Method == "Invoke")) and not (kind == "getattr" and Settings.GetAttrCodeSet and count > 0)
	local wrap = Settings.Wrap
	local Delay = tonumber(Settings.LoopDelay) or 0
	local body
	if wrap == "loop" then
		local inner = call
		if Delay > 0 then
			inner ..= "\ntask.wait(" .. number(Delay) .. ")"
		end

		body = "for i = 1, " .. math.max(1, math.floor(tonumber(Settings.LoopCount) or 1)) .. " do\n" .. indent(inner) .. "\nend"
	elseif wrap == "while" then
		body = "while task.wait(" .. (Delay > 0 and number(Delay) or "") .. ") do\n" .. indent(call) .. "\nend"
	elseif wrap == "spawn" then
		body = "task.spawn(function()\n" .. indent(call) .. "\nend)"
	elseif wrap == "pcall" then
		body = "local ok, result = pcall(function()\n" .. indent((returns and "return " or "") .. call) .. "\nend)\n\nprint(ok, result)"
	elseif kind == "require" then
		body = "local module = " .. call .. "\n\nprint(module)"
	elseif returns then
		body = "local result = " .. call .. "\n\nprint(result)"
	else
		body = call
	end

	if Settings.DecodeBuffers and Settings.BufferCode then
		local ok_call, call_code = pcall(UI.buffer_call, Log)
		if ok_call and call_code then
			body = call_code
			for index = #setup, 1, -1 do
				table.remove(setup, index)
			end
		end
	end

	local header = {"-- generated by Larp Spy"}
	if Settings.CallerComment then
		if Log.Script then
			local ok, path = pcall(path_of, Log.Script)
			table.insert(header, "-- caller: " .. (ok and path or name_of(Log.Script)))
		end

		if Log.Info then
			local Info = Log.Info
			table.insert(header, string.format("-- caller function: %s  %s:%s  (%s param%s%s)", Info.Name or "<anonymous>", tostring(Info.Source), tostring(Info.Line), tostring(Info.Params or "?"), Info.Params == 1 and "" or "s", Info.Vararg and ", vararg" or ""))
			if Info.Stack and #Info.Stack > 0 then
				table.insert(header, "-- call stack (innermost first):")
				for index, frame in Info.Stack do
					if index > 15 then
						table.insert(header, "--   ... " .. (#Info.Stack - 15) .. " more")
						break
					end

					table.insert(header, string.format("--   %d. %s  %s:%s", index, frame.Name or "<anonymous>", UI.frame_path(frame.Source), tostring(frame.Line)))
				end
			end
		end

		if Log.Actor then
			table.insert(header, "-- actor: " .. Log.Actor)
		end
	end

	if Settings.TrackRenames then
		local renamed = UI.rename_comment(Log)
		if renamed then
			for _, line in renamed do
				table.insert(header, line)
			end
		end
	end

	if Settings.DecodeBuffers and count > 0 then
		for _, line in UI.buffer_notes(Log) do
			table.insert(header, line)
		end
	end

	if kind == "incoming" then
		table.insert(header, "-- incoming (server -> client): replays the event on your client")
	elseif kind == "kick" then
		table.insert(header, "-- a kick the game tried on you")
	elseif kind == "purchase" then
		table.insert(header, "-- MarketplaceService call (ownership check / purchase prompt)")
		local names = UI.purchase_arg_names[(string.gsub(Log.Method, "^Signal", ""))]
		if names then
			table.insert(header, "-- args: " .. names)
		end
	elseif kind == "connection" then
		table.insert(header, "-- the game connected a function to this signal" .. (Log.Owner and "" or " (signal owner not found, set it yourself)"))
	elseif Log.Signal then
		table.insert(header, "-- " .. kind .. " call from an executor script" .. (Log.Owner and "" or " (signal owner not found, set it yourself)"))
	end

	local setup_text = #setup > 0 and (table.concat(setup, "\n") .. "\n\n") or ""
	local returned = ""
	if kind == "connection" and Log.Owner then
		returned = "\n\n-- run the game's own handlers for this signal:\nfiresignal(" .. display_path(Log, context) .. ")"
	end

	if (kind == "require" or kind == "debuginfo") and Log.Result then
		local parts = { }
		for index = 1, Log.Result.n or #Log.Result do
			table.insert(parts, serialize(Log.Result[index]))
		end

		returned = "\n\n-- returned:\n-- " .. (string.gsub(table.concat(parts, ", "), "\n", "\n-- "))
	end

	local inner = (context.NeedsNil and UI.get_nil_helper or "") .. (context.NeedsResolver and UI.resolver_helper or "") .. UI.tidy(setup_text .. body .. returned)
	if kind == "lib" and (string.find(tostring(Log.Remote), "^require%(") or string.find(tostring(Log.Remote), "^find_packet%(")) then
		inner = string.gsub(inner, "(%[\"[%w_]*[Tt]ime[%w_]*\"%]%s*=%s*)%-?%d[%d%.eE%+%-]*", "%1workspace:GetServerTimeNow()")
		inner = string.gsub(inner, "([%w_]*[Tt]ime[%w_]*%s*=%s*)%-?%d[%d%.eE%+%-]*", "%1workspace:GetServerTimeNow()")
		inner = UI.dot_syntax(inner)
		if string.find(tostring(Log.Remote), "^find_packet%(") then
			inner = UI.packet_helper .. "\n\n" .. inner
		end
	end

	if actor_thread then
		local level = "=="
		while string.find(inner, "]" .. level .. "]", 1, true) do
			level ..= "="
		end

		inner = table.concat({
			"local thread_index = " .. actor_thread .. " -- getactorthreads()[thread_index]: if the egg code runs in another actor, change it",
			"",
			"local id, channel = create_comm_channel()",
			"channel.Event:Connect(function(...)",
			"    print(...)",
			"end)",
			"",
			"local code = [" .. level .. "[",
			"local id = ...",
			"local channel = get_comm_channel(id)",
			"local function print(...) channel:Fire(...) end",
			"local function warn(...) channel:Fire(...) end",
			"",
			"local ok, err = pcall(function()",
			indent(inner),
			"end)",
			"if not ok then channel:Fire(\"error:\", err) end",
			"]" .. level .. "]",
			"",
			"run_on_thread(getactorthreads()[thread_index], code, id)",
		}, "\n")
	end

	if Log.Actor and string.find(inner, "find_function", 1, true) and not string.find(inner, "]==]", 1, true) then
		local lines = {
			"-- the game function lives on the call stack of whichever Lua VM runs the game's code (this one, or an actor's own VM):",
			"-- the script runs in this VM and in every actor, and only the VM where the game really runs it catches the function and sends",
			"local run_on_actor = run_on_actor or (syn and syn.run_on_actor)",
			"local code = [==[",
			"local ok, err = pcall(function()",
			indent(inner),
			"end)",
			"if not ok then error(err, 0) end",
			"]==]",
			"",
		}

		if Log.Actor then
			table.insert(lines, "local label = " .. string.format("%q", Log.Actor))
			table.insert(lines, "local index = tonumber(label:match(\"^actor (%d+)$\"))")
			table.insert(lines, "local ran = false")
			table.insert(lines, "for i, actor in getactors() do")
			table.insert(lines, "    if (index and i == index) or (not index and (actor.Name == label or label == \"actor id \" .. actor:GetDebugId())) then")
			table.insert(lines, "        ran = true")
			table.insert(lines, "        task.spawn(run_on_actor, actor, code)")
			table.insert(lines, "    end")
			table.insert(lines, "end")
			table.insert(lines, "assert(ran, \"actor not found: \" .. label)")
		end

		inner = table.concat(lines, "\n")
	end

	return table.concat(header, "\n") .. "\n\n" .. inner
end

function __R.strip_comments(code)
	local out, length, index = { }, #code, 1
	local line_start = 1
	local function only_space()
		for position = line_start, #out do
			if not string.match(out[position], "^%s*$") then
				return false
			end
		end

		return true
	end

	while index <= length do
		local Char = string.sub(code, index, index)
		if Char == "\"" or Char == "'" then
			local stop = index + 1
			while stop <= length do
				local current = string.sub(code, stop, stop)
				if current == "\\" then
					stop += 2
				elseif current == Char or current == "\n" then
					break
				else
					stop += 1
				end
			end

			table.insert(out, string.sub(code, index, stop))
			index = stop + 1
		elseif Char == "[" and string.match(code, "^%[=*%[", index) then
			local level = #string.match(code, "^%[(=*)%[", index)
			local _, stop = string.find(code, "]" .. string.rep("=", level) .. "]", index, true)
			stop = stop or length
			table.insert(out, string.sub(code, index, stop))
			index = stop + 1
		elseif Char == "-" and string.sub(code, index + 1, index + 1) == "-" then
			local stop
			if string.match(code, "^%-%-%[=*%[", index) then
				local level = #string.match(code, "^%-%-%[(=*)%[", index)
				local _, close = string.find(code, "]" .. string.rep("=", level) .. "]", index, true)
				stop = (close or length) + 1
			else
				stop = (string.find(code, "\n", index, true) or length + 1)
			end

			if only_space() then
				for position = #out, line_start, -1 do
					out[position] = nil
				end

				index = stop + 1
			else
				while #out >= line_start and string.match(out[#out], "^[ \t]+$") do
					table.remove(out)
				end

				index = stop
			end
		else
			table.insert(out, Char)
			index += 1
			if Char == "\n" then
				line_start = #out + 1
			end
		end
	end

	return table.concat(out)
end

local function generate(Log)
	local code = __R.generate_raw(Log)
	if not Settings.StripComments then
		return code
	end

	local head = string.sub(code, 1, #banner) == banner
	local body = head and string.sub(code, #banner + 1) or code
	local stripped = string.gsub(string.gsub(__R.strip_comments((head and "\n" or "") .. body), "\n\n\n+", "\n\n"), "^\n+", "")
	return (head and (banner .. "\n\n") or "") .. stripped
end

local function unstack(Log)
	local per = stacks[Log.Remote]
	if per then
		for key, Value in per do
			if Value == Log then
				per[key] = nil
			end
		end

		if next(per) == nil then
			stacks[Log.Remote] = nil
		end
	end
end

local function signature(Log)
	local parts = {tostring(Log.Remote), Log.Method, Log.Kind, tostring(Log.Actor), Log.Count}
	for index = 1, Log.Count do
		local Value = Log.Args[index]
		if type(Value) == "table" then
			local count = 0
			table.insert(parts, "{")
			for key, inner in next, Value do
				count += 1
				if count > 20 then
					break
				end

				table.insert(parts, tostring(key) .. "=" .. tostring(inner))
			end

			table.insert(parts, "}")
		else
			table.insert(parts, typeof(Value) .. ":" .. tostring(Value))
		end
	end

	return table.concat(parts, "|")
end
UI.resolver_helper = [[-- the game renames this remote (random / changing names): it is looked up by the names seen so far, then by its position among the same-class children
local function findremote(parent, class, names, index)
    if parent then
        for _, name in names do
            local found = parent:FindFirstChild(name)
            if found and found.ClassName == class then
                return found
            end
        end
        local position = 0
        for _, child in parent:GetChildren() do
            if child.ClassName == class then
                position += 1
                if position == index then
                    return child
                end
            end
        end
    end
    error("remote not found: " .. tostring(names[1]))
end
]]
UI.smart_path = function(object, context)
	local Info = UI.remotes[object]
	local class = class_of(object)
	if not Info or not UI.remote_classes[class] or not UI.unstable_name(object, Info) then
		return nil
	end

	local ok_parent, Parent = pcall(function() return object.Parent end)
	if not ok_parent or not Parent then
		return nil
	end

	local ok_kids, kids = pcall(Parent.GetChildren, Parent)
	if not ok_kids then
		return nil
	end

	local position, found = 0, false
	for _, kid in kids do
		if class_of(kid) == class then
			position += 1
			if kid == object then
				found = true
				break
			end
		end
	end

	if not found then
		return nil
	end

	local names, seen = { }, { }
	local function add(Name)
		if not seen[Name] and #names < 4 then
			seen[Name] = true
			table.insert(names, quote(Name))
		end
	end

	add(name_of(object))
	for index = #Info.Names, 1, -1 do
		add(Info.Names[index])
	end

	context.NeedsResolver = true
	return "findremote(" .. path_of_raw(Parent, context) .. ", " .. quote(class) .. ", {" .. table.concat(names, ", ") .. "}, " .. position .. ")"
end

serialize = function(Value, depth, seen, context)
	depth = depth or 0
	seen = seen or { }
	local Type = typeof(Value)
	if Type == "nil" then
		return "nil"
	elseif Type == "boolean" then
		return tostring(Value)
	elseif Type == "number" then
		return number(Value)
	elseif Type == "string" then
		return quote(Value)
	elseif Type == "table" then
		return __R.serialize_table(Value, depth, seen, context)
	elseif Type == "Instance" then
		return path_of(Value, context)
	elseif Type == "Vector3" then
		return "Vector3.new(" .. list({Value.X, Value.Y, Value.Z}) .. ")"
	elseif Type == "Vector2" then
		return "Vector2.new(" .. list({Value.X, Value.Y}) .. ")"
	elseif Type == "Vector3int16" then
		return "Vector3int16.new(" .. list({Value.X, Value.Y, Value.Z}) .. ")"
	elseif Type == "Vector2int16" then
		return "Vector2int16.new(" .. list({Value.X, Value.Y}) .. ")"
	elseif Type == "CFrame" then
		return "CFrame.new(" .. list({Value.GetComponents(Value)}) .. ")"
	elseif Type == "Color3" then
		return "Color3.new(" .. list({Value.R, Value.G, Value.B}) .. ")"
	elseif Type == "BrickColor" then
		return "BrickColor.new(" .. quote(Value.Name) .. ")"
	elseif Type == "UDim2" then
		return "UDim2.new(" .. list({Value.X.Scale, Value.X.Offset, Value.Y.Scale, Value.Y.Offset}) .. ")"
	elseif Type == "UDim" then
		return "UDim.new(" .. list({Value.Scale, Value.Offset}) .. ")"
	elseif Type == "EnumItem" then
		return tostring(Value)
	elseif Type == "Enum" then
		return "Enum." .. tostring(Value)
	elseif Type == "NumberRange" then
		return "NumberRange.new(" .. list({Value.Min, Value.Max}) .. ")"
	elseif Type == "Rect" then
		return "Rect.new(" .. list({Value.Min.X, Value.Min.Y, Value.Max.X, Value.Max.Y}) .. ")"
	elseif Type == "Ray" then
		return "Ray.new(" .. serialize(Value.Origin) .. ", " .. serialize(Value.Direction) .. ")"
	elseif Type == "NumberSequence" then
		local points = { }
		for _, point in Value.Keypoints do
			table.insert(points, "NumberSequenceKeypoint.new(" .. list({point.Time, point.Value, point.Envelope}) .. ")")
		end

		return "NumberSequence.new({" .. table.concat(points, ", ") .. "})"
	elseif Type == "ColorSequence" then
		local points = { }
		for _, point in Value.Keypoints do
			table.insert(points, "ColorSequenceKeypoint.new(" .. number(point.Time) .. ", " .. serialize(point.Value) .. ")")
		end

		return "ColorSequence.new({" .. table.concat(points, ", ") .. "})"
	elseif Type == "buffer" then
		return "buffer.fromstring(" .. quote(buffer.tostring(Value)) .. ")"
	elseif Type == "DateTime" then
		return "DateTime.fromUnixTimestampMillis(" .. Value.UnixTimestampMillis .. ")"
	elseif Type == "TweenInfo" then
		return "TweenInfo.new(" .. list({Value.Time}) .. ", " .. tostring(Value.EasingStyle) .. ", " .. tostring(Value.EasingDirection) .. ", " .. list({Value.RepeatCount}) .. ", " .. tostring(Value.Reverses) .. ", " .. list({Value.DelayTime}) .. ")"
	elseif Type == "Font" then
		return "Font.new(" .. quote(Value.Family) .. ", " .. tostring(Value.Weight) .. ", " .. tostring(Value.Style) .. ")"
	elseif Type == "PhysicalProperties" then
		return "PhysicalProperties.new(" .. list({Value.Density, Value.Friction, Value.Elasticity, Value.FrictionWeight, Value.ElasticityWeight}) .. ")"
	end

	if Type == "function" then
		local ok, Name = pcall(raw_debug_info or debug.info, Value, "n")
		return "function() end --[[ " .. ((ok and Name and Name ~= "") and Name or "function") .. " ]]"
	end

	return "nil --[[ " .. Type .. ": " .. string.gsub(tostring(Value), "%]%]", "] ]") .. " ]]"
end
