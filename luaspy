		if UI.anim_until and os.clock() < UI.anim_until and #queue == 0 then
			render()
		end

		if #queue > 0 then
			local batch = queue
			queue = { }
			for _, Log in batch do
				local target = nil
				if Settings.Stack == "remote" then
					local key = Log.Method .. "|" .. Log.Kind .. "|" .. tostring(Log.Actor)
					local per = stacks[Log.Remote]
					target = per and per[key]
					if not target then
						per = per or { }
						per[key] = Log
						stacks[Log.Remote] = per
					end
				elseif Settings.Stack == "same args" then
					local top = logs[1]
					if top and top.Remote == Log.Remote and top.Method == Log.Method and top.Actor == Log.Actor then
						Log.signature = signature(Log)
						top.signature = top.signature or signature(top)
						if top.signature == Log.signature then
							target = top
						end
					end
				end

				if target then
					target.Calls += 1
					target.Time = Log.Time
					Log.Args.Up = Log.Args.Up or target.Args.Up
					target.Args = Log.Args
					target.Count = Log.Count
					target.Script = Log.Script or target.Script
					target.Info = Log.Info or target.Info
					target.Spoofed = Log.Spoofed
					target.signature = Log.signature
					local history = target.History
					table.insert(history, {Args = Log.Args, Count = Log.Count, Script = Log.Script, Info = Log.Info, Time = Log.Time, number = target.Calls, Result = Log.Result, Signal = Log.Signal})
					target.Result = Log.Result or target.Result
					target.Signal = Log.Signal or target.Signal
					while #history > math.max(1, Settings.HistoryLimit) do
						table.remove(history, 1)
						if target.ViewIndex then
							target.ViewIndex = math.max(1, target.ViewIndex - 1)
						end
					end

					if Settings.StackToTop and logs[1] ~= target then
						local position = table.find(logs, target)
						if position then
							table.remove(logs, position)
						end

						table.insert(logs, 1, target)
					end

					if target == selected then
						details_dirty = true
					end
				else
					if typeof(Log.Remote) == "Instance" and Log.Kind ~= "debuginfo" and not Log.Signal then
						UI.track_remote(Log.Remote)
						Log.Dup = __R.dup_tag(Log.Remote)
					end

					Log.History = {{Args = Log.Args, Count = Log.Count, Script = Log.Script, Info = Log.Info, Time = Log.Time, number = 1, Result = Log.Result, Signal = Log.Signal}}
					table.insert(logs, 1, Log)
				end
			end

			while #logs > Settings.MaxLogs do
				local removed = table.remove(logs)
				unstack(removed)
				if removed == selected then
					show_details(nil)
				end
			end

			rebuild()
		end

		if details_dirty and selected and os.clock() - last_details > 0.5 then
			last_details = os.clock()
			details_dirty = false
			show_details(selected, true)
		end

		if Settings.Actors and Settings.WatchActors and os.clock() - last_actors > 3 then
			last_actors = os.clock()
			task.spawn(inject_actors, false)
		end
	end)
end

Connect(user_input_service.InputBegan, function(input_object, processed)
	if user_input_service.GetFocusedTextBox(user_input_service) then
		return
	end

	if UI.key_capture then
		UI.key_capture(input_object)
		return
	end

	if binding_log then
		local Log = binding_log
		local code = input_object.KeyCode
		local is_loop = binding_loop
		binding_log = nil
		binding_loop = false
		if code == Enum.KeyCode.Escape or code == Enum.KeyCode.Unknown then
			set_status("bind cancelled")
			return
		end

		if code.Name == Settings.ToggleKey or code.Name == Settings.PauseKey then
			set_status(code.Name .. " is the toggle / pause key, pick another")
			return
		end

		local taken = binds[code]
		if taken then
			if taken.Loop then
				taken.Log.LoopKey = nil
			else
				taken.Log.BindKey = nil
			end
		end

		remove_bind(Log, is_loop)
		binds[code] = {Log = Log, Loop = is_loop or nil}
		if is_loop then
			Log.LoopKey = code.Name
		else
			Log.BindKey = code.Name
		end

		render()
		if selected == Log then
			show_details(Log, true)
		end

		set_status("bound " .. code.Name .. " to " .. display_name(Log))
		return
	end

	local Bind = binds[input_object.KeyCode]
	if Bind and input_object.KeyCode.Name ~= Settings.ToggleKey and input_object.KeyCode.Name ~= Settings.PauseKey then
		if Bind.Loop then
			UI.set_loop(Bind.Log, not UI.loops[Bind.Log])
			return
		end

		local row = Bind.Log
		local picked = row.ViewIndex
		row.ViewIndex = nil
		local latest = viewed(row)
		row.ViewIndex = picked
		replay(latest)
		return
	end

	if processed then
		return
	end

	if Settings.PauseKey ~= "None" then
		local ok_pause, pause_key = pcall(function() return Enum.KeyCode[Settings.PauseKey] end)
		if ok_pause and input_object.KeyCode == pause_key then
			paused = not paused
			UI.pause_button.Text = paused and "resume" or "pause"
			UI.pause_button.TextColor3 = paused and T.Accent or T.Text
			set_status(paused and "paused" or "logging")
			return
		end
	end

	local ok, key = pcall(function() return Enum.KeyCode[Settings.ToggleKey] end)
	if ok and input_object.KeyCode == key then
		main.Visible = not main.Visible
		close_menu()
	end
end)

