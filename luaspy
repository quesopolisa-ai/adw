UI.anim_api_load = function()
	if UI.anim_api_busy then
		return
	end

	UI.anim_api_busy = true
	UI.api_anims, UI.api_anim_order = { }, { }
	UI.api_status = "looking up the game's creator..."
	UI.api_dirty = true
	local ok, Info = pcall(function() local market = game.GetService(game, "MarketplaceService") return market.GetProductInfo(market, game.PlaceId) end)
	local creator = ok and type(Info) == "table" and Info.Creator
	if not creator then
		UI.api_status = "couldn't read the game's creator"
		UI.anim_api_busy = false
		UI.api_dirty = true
		return
	end

	local creator_id = creator.CreatorTargetId or creator.Id
	local is_group = creator.CreatorType == "Group"
	local failure
	if is_group then
		local ids = { }
		for page = 1, 10 do
			UI.api_status = "loading page " .. page .. " (group " .. tostring(creator.Name) .. ")..."
			UI.api_dirty = true
			local Data, why = UI.anim_http("https://apis.roblox.com/toolbox-service/v1/marketplace/24?limit=100&pageNumber=" .. page .. "&creatorType=2&creatorTargetId=" .. tostring(creator_id))
			if not Data then
				failure = why
				break
			end

			local list = type(Data.data) == "table" and Data.data or { }
			for _, item in list do
				local num = type(item) == "table" and (item.id or (item.asset and item.asset.id)) or item
				if tonumber(num) then
					table.insert(ids, tonumber(num))
					UI.anim_api_add(num, type(item) == "table" and (item.name or (item.asset and item.asset.name)) or nil)
				end
			end

			if #list == 0 then
				break
			end
		end
	else
		local cursor = ""
		for page = 1, 10 do
			UI.api_status = "loading page " .. page .. " (user " .. tostring(creator.Name) .. ")..."
			UI.api_dirty = true
			local Data, why = UI.anim_http("https://inventory.roblox.com/v2/users/" .. tostring(creator_id) .. "/inventory/24?limit=100&sortOrder=Asc" .. cursor)
			if not Data then
				failure = why
				break
			end

			for _, item in type(Data.data) == "table" and Data.data or { } do
				UI.anim_api_add(item.assetId or item.id, item.assetName or item.name)
			end

			if not Data.nextPageCursor then
				break
			end

			cursor = "&cursor=" .. tostring(Data.nextPageCursor)
		end
	end

	UI.api_status = #UI.api_anim_order .. " animations by " .. tostring(creator.Name) .. (failure and (" (stopped: " .. failure .. ")") or "") .. (#UI.api_anim_order == 0 and " - Roblox doesn't expose them for this creator" or "")
	UI.anim_api_busy = false
	UI.api_dirty = true
end

UI.anim_rbxm = function(Id, Name)
	if not writefile then
		return "no writefile in this executor"
	end

	local function U32(Value) return string.pack("<I4", Value) end
	local function str(Value) return U32(#Value) .. Value end
	local function chunk(tag, Data) return tag .. U32(0) .. U32(#Data) .. "\0\0\0\0" .. Data end
	Name = tostring(Name or "Animation")
	local Data = "<roblox!\137\255\13\10\26\10" .. "\0\0" .. U32(1) .. U32(1) .. "\0\0\0\0\0\0\0\0"
		.. chunk("INST", U32(0) .. str("Animation") .. "\0" .. U32(1) .. "\0\0\0\0")
		.. chunk("PROP", U32(0) .. str("AnimationId") .. "\1" .. str(tostring(Id)))
		.. chunk("PROP", U32(0) .. str("Name") .. "\1" .. str(Name))
		.. chunk("PRNT", "\0" .. U32(1) .. "\0\0\0\0" .. "\0\0\0\1")
		.. chunk("END\0", "</roblox>")
	local dir = folder .. "/animations"
	if makefolder and isfolder then
		for _, path in {folder, dir} do
			if not isfolder(path) then
				pcall(makefolder, path)
			end
		end
	end

	local base = dir .. "/" .. (string.gsub(Name, "[^%w_%-]", "_")) .. "_" .. (string.match(tostring(Id), "%d+") or "anim") .. ".rbxm"
	local failure
	for _, path in {base, base .. ".txt"} do
		local ok, err = pcall(writefile, path, Data)
		if ok and (not isfile or isfile(path)) then
			return "saved " .. path .. (path ~= base and " (executor blocks .rbxm: remove the .txt)" or "") .. " [" .. #Data .. " bytes]"
		end

		failure = ok and "file was not created" or tostring(err)
	end

	return "couldn't write the file: " .. tostring(failure)
end

UI.anim_save = function(Id, Name)
	Name = tostring(Name or "Animation")
	local ok, sequence = pcall(function()
		local provider = game.GetService(game, "KeyframeSequenceProvider")
		return provider.GetKeyframeSequenceAsync(provider, tostring(Id))
	end)

	if not ok or typeof(sequence) ~= "Instance" then
		return "keyframes unavailable (" .. tostring(sequence) .. "); " .. UI.anim_rbxm(Id, Name)
	end

	if not UI.ssi then
		local loaded, result = pcall(function()
			return loadstring(game.HttpGet(game, "https://raw.githubusercontent.com/luau/UniversalSynSaveInstance/main/saveinstance.luau", true), "saveinstance")()
		end)

		if not loaded or type(result) ~= "function" then
			return "couldn't load UniversalSynSaveInstance (" .. tostring(result) .. "); " .. UI.anim_rbxm(Id, Name)
		end

		UI.ssi = result
	end

	pcall(function() sequence.Name = Name end)
	local dir = folder .. "/animations"
	if makefolder and isfolder then
		for _, path in {folder, dir} do
			if not isfolder(path) then
				pcall(makefolder, path)
			end
		end
	end

	local path = dir .. "/" .. (string.gsub(Name, "[^%w_%-]", "_")) .. "_" .. (string.match(tostring(Id), "%d+") or "anim") .. "_keyframes.rbxm"
	local saved, err = pcall(UI.ssi, {
		mode = "invalid",
		ExtraInstances = {sequence},
		IsModel = true,
		Binary = true,
		FilePath = path,
		ReadMe = false,
		ShowStatus = false,
		SafeMode = false,
		KillAllScripts = false,
		BoostFPS = false,
		AntiIdle = false,
		ShutdownWhenDone = false,
		Decompile = false,
	})

	pcall(function() sequence.Destroy(sequence) end)
	if not saved then
		return "save failed (" .. tostring(err) .. "); " .. UI.anim_rbxm(Id, Name)
	end

	if isfile and not isfile(path) then
		return "saveinstance finished but no file at " .. path .. "; " .. UI.anim_rbxm(Id, Name)
	end

	return "saved keyframes to " .. path
end

