do local function setup_channel()
	if channel then
		return true
	end

	if X.CreateCommChannel then
		local ok, Id, Event = pcall(X.CreateCommChannel)
		if ok and Event then
			channel = Event
			UI.channel_expression = "(get_comm_channel or (syn and syn.get_comm_channel))(" .. (type(Id) == "number" and tostring(Id) or string.format("%q", tostring(Id))) .. ")"
		end
