	local lib_block = (Lib == "table" and Settings.BlockTables) or (Lib == "buffer" and Settings.BlockBuffers) or (Lib == "Instance" and Settings.BlockInstanceNew) or blocked[Name] == true
	if not active or not (wanted or Settings.BlockCreates or lib_block) then
