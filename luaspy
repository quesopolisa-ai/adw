local function push(remote, Method, kind, script, Actor, count, ...)
	if UI.frozen[remote] then
		return
	end

	if Actor == nil and kind ~= "incoming" then
		Actor = UI.actor_of_call(script)
	end

	local rules = ignored_args[remote]
	if rules and UI.rule_matches then
		for _, rule in rules do
			local ok, hit = pcall(UI.rule_matches, rule, count, ...)
			if ok and hit then
				return
			end
		end
	end

	if Settings.AntiSpam or (Settings.AttrAntiSpam and (kind == "getattr" or kind == "setattr")) then
		local ok, spam = pcall(UI.is_spam, remote, Method, kind, count, ...)
		if ok and spam then
			return
		end
	end

	local args = {...}
	for index = 1, count do
		args[index] = deep_copy(args[index])
	end

	args.Dyn = __R.detect_dynamic(args, count)
	if Settings.UpvalueSearch and kind ~= "http" and kind ~= "lib" and kind ~= "wait" and kind ~= "raknet" and kind ~= "logservice" then
		local ok_up, up = pcall(UI.find_upvalues, args, count)
		args.Up = ok_up and up or nil
		if not args.Up then
			task.defer(function() shared.notify("upvalue search is ON but found nothing for this call (the value is not held as an upvalue / field / instance name)") end)
		end

		if args.Up and typeof(remote) == "Instance" then
			local seen = UI.up_seen[remote] or { }
			UI.up_seen[remote] = seen
			for _, leaf in args.Up do
				local leaf_key = leaf.Index .. "|" .. tostring(leaf.Key) .. (leaf.KeyLeaf and "|key" or "")
				local previous = seen[leaf_key]
				local set = { }
				if previous then
					local kept = { }
					for _, found in leaf.Found do
						if previous[found.Source .. "|" .. found.Name .. "|" .. tostring(found.Line) .. "|" .. found.Up .. "|" .. tostring(found.Field)] then
						table.insert(kept, found)
						end
					end

					if #kept > 0 then
						leaf.Found = kept
					end
				end

				for _, found in leaf.Found do
					set[found.Source .. "|" .. found.Name .. "|" .. tostring(found.Line) .. "|" .. found.Up .. "|" .. tostring(found.Field)] = true
				end

				seen[leaf_key] = set
			end
		end
	end

	local CallerInfo = kind ~= "raknet" and (Settings.DebugInfo or Settings.RemoteStack) and __R.caller_info() or nil
	if Settings.RemoteStack and kind ~= "debuginfo" and kind ~= "raknet" and not shared.StackBusy then
		local now = os.clock()
		UI.stack_last = UI.stack_last or setmetatable({ }, {__mode = "k"})
		local key = typeof(remote) == "Instance" and remote or kind
		UI.stack_cache = UI.stack_cache or setmetatable({ }, {__mode = "k"})
		local stack = nil
		if now - (UI.stack_last[key] or 0) >= 0.05 then
			UI.stack_last[key] = now
			shared.StackBusy = true
			local ok_stack, got = pcall(__R.full_stack, 12)
			shared.StackBusy = false
			if ok_stack and type(got) == "table" and #got > 0 then
				stack = got
				UI.stack_cache[key] = got
			end
		else
			stack = UI.stack_cache[key]
		end

		if stack then
			local top = stack[1]
			CallerInfo = CallerInfo or {Source = top.Source, Line = top.Line, Name = top.Name, Params = top.Params, Vararg = top.Vararg}
			CallerInfo.Stack = stack
		end
	end

	table.insert(queue, {
		Remote = remote,
		Method = Method,
		Kind = kind,
		Script = script,
		Info = CallerInfo,
		Actor = Actor,
		Args = args,
		Count = count,
		Calls = 1,
		Time = os.date("%H:%M:%S"),
	})
end

