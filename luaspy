local function display_name(Log)
	if Log.Kind == "http" then
		return Log.Label or "http"
	end

	if Log.Kind == "debuginfo" then
		return Log.Label and ("debug.info  " .. Log.Label) or "debug.info"
	end

	if Log.Signal then
		local base = Log.Owner and (name_of(Log.Owner) .. "." .. Log.EventName) or Log.EventName
		if Log.Kind == "connection" then
			local where = (Log.Script and name_of(Log.Script)) or (Log.Info and string.match(tostring(Log.Info.Source), "[^%.]+$")) or "?"
			base ..= "  <-  " .. where .. (Log.Info and (":" .. tostring(Log.Info.Line)) or "")
		end

		return base
	end

	if Log.Kind == "create" or Log.Kind == "lib" or Log.Kind == "wait" or Log.Kind == "raknet" then
		return tostring(Log.Remote)
	end

	if Log.Kind == "logservice" then
		local line = (string.gsub(tostring(Log.Remote), "%s+", " "))
		local length = utf8.len(line)
		if length and length > 160 then
			line = string.sub(line, 1, utf8.offset(line, 161) - 1) .. "..."
		elseif not length and #line > 160 then
			line = string.sub(line, 1, 160) .. "..."
		end

		return ((Log.Method == "Warning" or Log.Method == "Error") and ("[" .. string.lower(Log.Method) .. "] ") or "") .. line
	end

	if typeof(Log.Remote) ~= "Instance" then
		return "asset " .. tostring(Log.Remote)
	end

	local Name = name_of(Log.Remote)
	if Name == "" then
		Name = "(empty)"
	end

	local pretty = UI.beautify(Log.Remote, Log)
	if pretty then
		return pretty
	end

	return Log.Dup and (Name .. " " .. Log.Dup) or Name
end

function __R.dup_tag(remote)
	local ok, tag = pcall(function()
