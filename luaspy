local function resolve(Log)
	local args = Log.Args
	local dyn = Settings.AutoFill and args.Dyn
	if not dyn then
		return args
	end

	local copy = { }
	for index = 1, Log.Count do
		copy[index] = args[index]
		for _, kind in __R.dyn_kinds do
			if dyn[index] == kind[1] then
				local ok, Now = pcall(kind[2])
				if ok then
					copy[index] = Now
				end
			end
		end
	end

	return copy
end

