UI.anim_http = function(Url)
	local Req = (syn and syn.request) or request or http_request or (http and http.request)
	if not Req then
		return nil, "this executor has no request function"
	end

	local ok, res = pcall(Req, {Url = Url, Method = "GET"})
	if not ok or type(res) ~= "table" then
		return nil, "request failed"
	end

	if res.StatusCode ~= 200 then
		return nil, "HTTP " .. tostring(res.StatusCode)
	end

	local decoded, Data = pcall(function() return http_service.JSONDecode(http_service, res.Body) end)
	if not decoded then
		return nil, "unreadable answer"
	end

	return Data
end

