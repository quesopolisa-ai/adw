		return table.pack(true)
	elseif Mode == "false" then
		return table.pack(false)
	elseif Mode == "nil" then
		return table.pack(nil)
	elseif Mode == "zero" then
		return table.pack(0)
	elseif Mode == "empty string" then
		return table.pack("")
	elseif Mode == "custom" then
		local Text = tostring(Settings.DebugCustom or "")
		local Lower = string.lower(Text)
		if Lower == "true" then
			return table.pack(true)
		elseif Lower == "false" then
			return table.pack(false)
		elseif Lower == "nil" or Text == "" then
			return table.pack(nil)
		end

		return table.pack(tonumber(Text) or string.match(Text, '^"(.*)"$') or Text)
	end

	return table.pack()
end

UI.install_http = function()
	if not X.hook_function then
		return false
	end

	shared.HttpHooked = shared.HttpHooked or setmetatable({ }, {__mode = "k"})
	for _, Function in {syn and syn.request, http and http.request, http_request, request} do
		if type(Function) == "function" and not shared.HttpHooked[Function] then
			shared.HttpHooked[Function] = true
			pcall(function()
				local old
				old = X.hook_function(Function, X.new_c_closure(function(options, ...)
					local ok, block = pcall(shared.capture_http, "request", nil, options, ...)
					if ok and block then
						return {success = false, StatusCode = 403, StatusMessage = "blocked by Larp Spy", Headers = { }, Body = ""}
					end

					return old(options, ...)
				end))
			end)
		end
	end

	return true
end

UI.spam_seen = { }
UI.spam_size = 0

UI.is_spam = function(remote, Method, kind, count, ...)
	local parts = {Method, kind, count}
	for index = 1, count do
		parts[#parts + 1] = UI.value_key((select(index, ...)))
	end

	local key = table.concat(parts, "|")
	local per = UI.spam_seen[remote]
	local Now = os.clock()
	local window = tonumber(Settings.AntiSpamWindow) or 1
	if not per then
		per = { }
		UI.spam_seen[remote] = per
	end

	local last = per[key]
	if last == nil then
		UI.spam_size += 1
		if UI.spam_size > 20000 then
			UI.spam_seen = {[remote] = per}
			UI.spam_size = 1
		end
	end

	per[key] = Now
	return last ~= nil and (window <= 0 or Now - last < window)
end

