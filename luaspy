UI.lib_copy = function(Value, budget, seen)
	local Type = typeof(Value)
	if Type == "buffer" then
		local ok, copy = pcall(function()
			if buffer.len(Value) <= 256 then
				return buffer.fromstring(buffer.tostring(Value))
			end
		end)

		return ok and copy or Value
	end

	if Type ~= "table" then
		return Value
	end

	seen = seen or { }
	if seen[Value] then
		return seen[Value]
	end

	local copy = { }
	seen[Value] = copy
	for key, inner in next, Value do
		if budget.Left <= 0 then
			copy["<cut: more entries not copied>"] = true
			break
		end

		budget.Left -= 1
		copy[UI.lib_copy(key, budget, seen)] = UI.lib_copy(inner, budget, seen)
	end

	return copy
end

