function UI.apply_colors()
	local Next = table.clone(UI.themes[UI.theme_for(Settings.Theme)])
	Next.Accent = UI.accent_color()
	local map = { }
	for key, old in T do
		if Next[key] and old ~= Next[key] then
			map[old.ToHex(old)] = Next[key]
		end
	end

	local function swap(object, property)
		local ok, color = pcall(function() return object[property] end)
		if ok and typeof(color) == "Color3" then
			local target = map[color.ToHex(color)]
			if target then
				pcall(function() object[property] = target end)
			end
		end
	end

	for _, object in Gui.GetDescendants(Gui) do
		if object.IsA(object, "GuiObject") then
			swap(object, "BackgroundColor3")
			swap(object, "BorderColor3")
			if object.IsA(object, "TextLabel") or object.IsA(object, "TextButton") or object.IsA(object, "TextBox") then
				swap(object, "TextColor3")
			end

			if object.IsA(object, "TextBox") then
				swap(object, "PlaceholderColor3")
			end

			if object.IsA(object, "ScrollingFrame") then
				swap(object, "ScrollBarImageColor3")
			end

			if object.IsA(object, "ImageLabel") or object.IsA(object, "ImageButton") then
				swap(object, "ImageColor3")
			end
		elseif object.IsA(object, "UIStroke") then
			swap(object, "Color")
		end
	end

	for key, Value in Next do
		T[key] = Value
	end

	hex.Accent = "#" .. T.Accent.ToHex(T.Accent)
	hex.Dim = "#" .. T.Dim.ToHex(T.Dim)
	for _, pair in UI.duals do
		pcall(function() pair[1].Color = T[UI.classic and pair[2] or pair[3]] end)
	end

	for _, pair in __R.Accented do
		pcall(function() pair[1][pair[2]] = T.Accent end)
	end

	for _, draw in UI.check_draws do
		pcall(draw)
	end

	__R.draw_title()
	render()
	if selected then
		show_details(selected)
	end
end

