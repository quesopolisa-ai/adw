local function decompile_caller(script)
	if not script then
		set_status("no calling script for this call")
		return
	end

	local ok, path = pcall(path_of, script)
	path = ok and path or name_of(script)
	if UI.source_cache[script] then
		show_source("source  " .. name_of(script), UI.source_cache[script])
		return
	end

	show_source("source  " .. name_of(script) .. "  (decompiling...)", "-- decompiling " .. path .. "...")
	set_status("decompiling " .. name_of(script) .. "...")
	task.spawn(function()
		local success, result = __R.Decompile(script)
		if success then
			result = string.gsub(string.gsub(result, "\r\n", "\n"), "\t", "    ")
			UI.source_cache[script] = result
			set_status("decompiled " .. name_of(script))
			show_source("source  " .. name_of(script), "-- " .. path .. "\n\n" .. result)
		else
			set_status(result)
			show_source("source  " .. name_of(script) .. "  (failed)", "-- couldn't decompile " .. path .. "\n-- " .. result)
		end
	end)
end

