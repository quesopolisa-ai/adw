local function name_ignored(Name)
	if ignored_names[Name] then
		return true
	end

	if #only_patterns > 0 then
		local allowed = false
		for _, pattern in only_patterns do
			local ok, found = pcall(string.find, Name, pattern)
			if ok and found then
				allowed = true
				break
			end
		end

		if not allowed then
			return true
		end
	end

	for _, pattern in ignore_patterns do
		local ok, found = pcall(string.find, Name, pattern)
		if ok and found then
			return true
		end
	end

	return false
end

local function deep_copy(Value, seen)
	if type(Value) ~= "table" then
		return Value
	end

	seen = seen or { }
	if seen[Value] then
		return seen[Value]
	end

	local copy = { }
	seen[Value] = copy
	for key, inner in next, Value do
		copy[deep_copy(key, seen)] = deep_copy(inner, seen)
	end

	return copy
end

UI.stack_raw = function(raw)
	if not (env.__LarpUseOth and oth and oth.is_hook_thread and oth.get_original_thread) then
		return raw
	end

	local ok_hook, hooked = pcall(oth.is_hook_thread)
	if not (ok_hook and hooked) then
		return raw
	end

	local ok_thread, origin = pcall(oth.get_original_thread)
	if not ok_thread or typeof(origin) ~= "thread" then
		return raw
	end

	return function(first, ...)
		if type(first) == "number" then
			if first <= 1 then
				return nil
			end

			return raw(origin, first - 1, ...)
		end

		return raw(first, ...)
	end
end

function __R.caller_info()
	local raw = UI.stack_raw(raw_debug_info or debug.info)
	local ok_own, own = true, __R.own_source()
	local first
	for level = 2, 14 do
		local ok, source, line, Name, params, vararg = pcall(raw, level, "slna")
		if not ok or source == nil then
			break
		end

		if source ~= "[C]" and (not ok_own or source ~= own) then
			local frame = {Source = source, Line = line, Name = (Name and Name ~= "") and Name or nil, Params = params, Vararg = vararg}
			if not first then
				first = frame
			elseif source ~= first.Source then
				first.Outer = frame
				break
