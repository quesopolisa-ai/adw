	local function add_row(order, label, start, cycle)
		local row = New("Frame", {Parent = UI.block_scroll, LayoutOrder = order, Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1})
		Text(row, {Size = UDim2.new(1, -80, 1, 0), Text = label})
