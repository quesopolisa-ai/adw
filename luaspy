UI.copy_hook_code = function(Log, with_args)
	local rows = { }
	if with_args then
		local current = overrides[Log.Remote]
		if not current or next(current) == nil then
			set_status("no argument hook on this remote (right click -> Hook arguments)")
			return
		end

		local indexes = { }
		for index in current do
			table.insert(indexes, index)
		end

		table.sort(indexes)
		for _, index in indexes do
			local ok, code = pcall(serialize, current[index].Value)
			table.insert(rows, "\t[" .. index .. "] = " .. (ok and code or "nil") .. ",")
		end
	end

	local lines = {
		"-- " .. (with_args and "hooked arguments" or "blocked") .. ": " .. display_name(Log) .. " (generated by Larp Spy)",
		"local remote = " .. display_path(Log),
		'local method = "' .. Log.Method .. '"',
		"",
	}

	if with_args then
		table.insert(lines, "local overrides = {")
		for _, row in rows do
			table.insert(lines, row)
		end

		table.insert(lines, "}")
		table.insert(lines, "")
		table.insert(lines, "local function apply(...)")
		table.insert(lines, "\tlocal args = table.pack(...)")
		table.insert(lines, "")
