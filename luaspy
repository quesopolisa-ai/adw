local function install_debug_info()
	if shared.Installed.DebugInfo or not X.hook_function then
		return shared.Installed.DebugInfo == true
	end

	local ok = pcall(function()
		local game_debug = getrenv and getrenv().debug
		local real = (game_debug and game_debug.info) or debug.info
		local old
		shared.DebugOffset = 0
		shared.DebugInside = true
		old = X.hook_function(real, X.new_c_closure(function(...)
			local first = ...
			local Offset = shared.DebugOffset
			local results
			if type(first) == "number" and Offset > 0 then
				results = table.pack(old(first + Offset, select(2, ...)))
			else
				results = table.pack(old(...))
			end

			if not shared.DebugInside then
				local captured, spoof = pcall(shared.capture_debug_info, results, ...)
				if captured and spoof then
					return table.unpack(spoof, 1, spoof.n)
				end
			end

			return table.unpack(results, 1, results.n)
		end))

		shared.RawDebugInfo = old
		raw_debug_info = old
		pcall(function()
			if getrenv then
				local gd = getrenv().debug
				if type(gd) == "table" then gd.info = old end
			end
		end)
		local function probe()
			return ((game_debug and game_debug.info or debug.info)(1, "f"))
		end

		for try = 0, 3 do
			shared.DebugOffset = try
			local worked, got = pcall(probe)
			if worked and got == probe then
				break
			end

			shared.DebugOffset = 0
		end

		shared.DebugInside = false
	end)

	shared.DebugInside = false
	shared.Installed.DebugInfo = ok
	return ok
end

