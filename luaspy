UI.game_file = folder .. "/game_" .. UI.game_key .. ".json"
do
	local function overlay(path)
		local ok, saved = pcall(function()
			return http_service.JSONDecode(http_service, readfile(path))
		end)

		if ok and type(saved) == "table" then
			for key, Value in saved do
				if Settings[key] ~= nil and type(Settings[key]) == type(Value) then
					Settings[key] = Value
				end
			end

			return true
		end

		return false
	end

	Settings.GameOnly = false
	overlay(folder .. "/settings.json")
	Settings.GameOnly = false
	if overlay(UI.game_file) then
		Settings.GameOnly = true
	end

	Settings.DebugCalls = false
end

