UI.watch_object = function(object)
	for _, spec in UI.watch_specs do
		local ok_class, is_class = pcall(function() return object.IsA(object, spec[1]) end)
		if ok_class and is_class then
			local marks = UI.watch_marks[object] or { }
			UI.watch_marks[object] = marks
			if not marks[spec[2]] then
				local ok_signal, signal = pcall(function() return object[spec[2]] end)
				if ok_signal and typeof(signal) == "RBXScriptSignal" and pcall(function()
					Connect(signal, function(...)
						if not active or paused or replaying or #UI.watch_specs == 0 then
							return
						end

						local key = tostring(signal)
						local Event = string.match(key, "^Signal (.+)$") or key
						if ignored[key] or name_ignored(Event) then
							return
						end

						local before = #queue
						push(key, "replicatesignal", "replicatesignal", nil, false, select("#", ...), ...)
						local Log = queue[#queue]
						if Log and #queue > before then
							Log.Signal = signal
							Log.EventName = Event
