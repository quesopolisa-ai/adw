	local script = X.get_calling_script()
	if typeof(script) == "Instance" and script.IsDescendantOf(script, core_gui) then
		return
	end

	shared.LibBudget = (shared.LibBudget or 0) - 1
	local count = select("#", ...)
	local args = table.pack(...)
	local budget = {Left = (Settings.LibBigTables or 0) > 0 and Settings.LibBigTables or math.huge}
	for index = 1, count do
		args[index] = UI.lib_copy(args[index], budget)
	end

	push(Name, Name, "lib", script, nil, count, table.unpack(args, 1, count))
end

