UI.looks_random = function(Name)
	if type(Name) ~= "string" then
		return false
	end

	local length = #Name
	if length == 0 or string.find(Name, "[%c\128-\255]") then
		return true
	end

	if string.match(Name, "^%x+%-%x+%-%x+%-%x+%-%x+$") then
		return true
	end

	if length >= 8 and string.match(Name, "^%x+$") and string.find(Name, "%d") and string.find(Name, "%a") then
		return true
	end

	if length >= 4 and string.match(Name, "^[Il1O0_]+$") and string.find(Name, "[IlO_]") then
		return true
	end

	if length >= 6 then
		local changes, previous = 0, nil
		for character in string.gmatch(Name, ".") do
			local class = (string.match(character, "%l") and 1) or (string.match(character, "%u") and 2) or (string.match(character, "%d") and 3) or nil
			if class and previous and class ~= previous then
				changes += 1
			end

			previous = class
		end

		if changes / length > 0.45 then
			return true
		end

		if length >= 10 and not string.find(Name, "[^%a]") then
			local _, vowels = string.gsub(string.lower(Name), "[aeiou]", "")
			if vowels / length < 0.18 then
				return true
			end
		end
	end

	return false
end

UI.track_remote = function(remote, fresh)
	if typeof(remote) ~= "Instance" then
		return nil
	end

	local existing = UI.remotes[remote]
	if existing then
		return existing
	end

	if not UI.remote_classes[class_of(remote)] then
		return nil
	end

	local Name = name_of(remote)
	local Info = {Original = Name, Names = {Name}, Renames = 0, Born = fresh and os.clock() or nil}
	UI.remotes[remote] = Info
	if Settings.TrackRenames then
		local ok, signal = pcall(function() return remote.GetPropertyChangedSignal(remote, "Name") end)
		if ok and signal then
			Connect(signal, function()
				if not Settings.TrackRenames then
					return
				end

				local Now = name_of(remote)
				if Now == Info.Names[#Info.Names] or (Info.Overwritten and Now == Info.Beauty) or Now == Info.Before then
					return
				end

				Info.Overwritten = nil
				Info.Renames += 1
				if Info.Born and os.clock() - Info.Born <= UI.creation_window then
					Info.OnCreate = true
				else
					Info.Later = true
				end

				table.insert(Info.Names, Now)
				if #Info.Names > 6 then
					table.remove(Info.Names, 2)
				end
			end)
		end
	end

	return Info
end

UI.unstable_name = function(remote, Info)
	Info = Info or UI.remotes[remote]
	if not Info then
		return false
	end

	if Info.Renames > 0 or Info.Overwritten then
		return true
	end

	local Name = name_of(remote)
	if Info.CheckedName ~= Name then
		Info.CheckedName = Name
		Info.CheckedRandom = UI.looks_random(Name)
	end

	return Info.CheckedRandom
end

UI.beautify = function(remote, Log)
	if not Settings.Beautify then
		return nil
	end

	local Info = UI.track_remote(remote)
	if not Info or not UI.unstable_name(remote, Info) then
		return nil
	end

	if not Info.Beauty then
		local class = UI.remote_classes[class_of(remote)]
		UI.beauty_counts[class] = (UI.beauty_counts[class] or 0) + 1
		local owner = Log and Log.Script and string.gsub(name_of(Log.Script), "[^%w_]", "") or ""
		Info.Beauty = class .. "_" .. UI.beauty_counts[class] .. (owner ~= "" and ("_" .. owner) or "")
	end

	if Settings.BeautifyRename and not Info.Overwritten then
		Info.Before = name_of(remote)
		if pcall(function() remote.Name = Info.Beauty end) then
			Info.Overwritten = true
		end
	end

	return Info.Beauty
end

UI.restore_names = function()
	for remote, Info in UI.remotes do
		if Info.Overwritten then
			Info.Overwritten = nil
			pcall(function() remote.Name = Info.Before or Info.Original end)
		end
	end
end

local function quote(String)
	String = tostring(String)
	if utf8.len(String) then
		return '"' .. string.gsub(String, utf8.charpattern, function(character)
			local code = utf8.codepoint(character)
			if code > 127 then
				return Settings.EscapeUnicode and string.format("\\u{%X}", code) or character
			elseif quote_map[character] then
				return quote_map[character]
			elseif code < 32 or code == 127 then
				return string.format("\\%03d", code)
			end

			return character
		end) .. '"'
	end

	return '"' .. string.gsub(String, '[%c"\\\128-\255]', function(character)
		return quote_map[character] or string.format("\\%03d", string.byte(character))
	end) .. '"'
end

local function number(Value)
	if Value ~= Value then
		return "0/0"
	elseif Value == math.huge then
		return "math.huge"
	elseif Value == -math.huge then
		return "-math.huge"
	end

	return tostring(Value)
end

local function path_of_raw(object, context)
	if object == game then
		return "game"
	end

	if context and Settings.SmartPaths and typeof(object) == "Instance" then
		local smart = UI.smart_path(object, context)
		if smart then
			return smart
		end
	end

	local chain = { }
	local current = object
	while current and current ~= game do
		table.insert(chain, 1, current)
		local ok, Parent = pcall(function() return current.Parent end)
		current = ok and Parent or nil
	end

	local Style = Settings.PathStyle
	local function index(child)
		local Name = name_of(child)
		local ok_parent, Parent = pcall(function() return child.Parent end)
		if ok_parent and Parent then
			local ok_kids, kids = pcall(Parent.GetChildren, Parent)
			if ok_kids then
				local same = 0
				for _, other in kids do
					if name_of(other) == Name then
						same += 1
					end
				end

				if same > 1 then
					local position = table.find(kids, child)
					if position then
						return ":GetChildren()[" .. position .. "]"
					end
				end
			end
		end

		if Style == "WaitForChild" then
			return ":WaitForChild(" .. quote(Name) .. ")"
		elseif Style == "FindFirstChild" then
			return ":FindFirstChild(" .. quote(Name) .. ")"
		elseif string.match(Name, "^[%a_][%w_]*$") then
			return "." .. Name
		elseif Style == "dot" then
			return "[" .. quote(Name) .. "]"
		end

		return ":FindFirstChild(" .. quote(Name) .. ")"
	end

	local function append(base, child)
		return base .. index(child)
	end

	local path, start = nil, 2
	if current == game then
		local first = chain[1]
		local is_service = pcall(function() assert(game.FindService(game, first.ClassName) == first) end)
		if first == workspace then
			path = "workspace"
		elseif is_service then
			path = 'game:GetService("' .. first.ClassName .. '")'
		else
			path = append("game", first)
		end

		local is_local = false
		if first.ClassName == "Players" and chain[2] then
			pcall(function()
				is_local = chain[2].ClassName == "Player" and chain[2].UserId == players.LocalPlayer.UserId
			end)
		end

		if is_local then
			path ..= ".LocalPlayer"
			start = 3
		end
	else
		if context then
			context.NeedsNil = true
		end

		path = "getnil(" .. quote(name_of(chain[1])) .. ", " .. quote(class_of(chain[1])) .. ")"
	end

	for position = start, #chain do
		path = append(path, chain[position])
	end

	return path
end

local function path_of(object, context)
	local result = path_of_raw(object, context)
	local ok, character = pcall(function() return players.LocalPlayer.Character end)
	if ok and character and typeof(object) == "Instance" and object == character then
		return 'game:GetService("Players").LocalPlayer.Character'
	end

	if ok and character and typeof(object) == "Instance" and object ~= character and object.IsDescendantOf(object, character) then
		local base = path_of_raw(character)
		if string.sub(result, 1, #base) == base then
			return 'game:GetService("Players").LocalPlayer.Character' .. string.sub(result, #base + 1)
		end
	end

	return result
end

