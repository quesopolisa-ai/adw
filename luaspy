UI.open_block_args = function(Log)
	local remote = Log.Remote
	if typeof(remote) ~= "Instance" then
		set_status("only calls on an instance can be ignored by arguments")
		return
	end

	local call = viewed(Log)
	local draft = {Remote = remote, SameCount = true, Count = call.Count, Modes = { }, Types = { }, Values = { }}
	UI.block_draft = draft
	hook_panel.Visible = false
	for _, child in UI.block_scroll.GetChildren(UI.block_scroll) do
		if child.IsA(child, "GuiObject") then
			child.Destroy(child)
		end
