		else
			set_status("adonis bypass error: " .. tostring(run_error))
		end
	end)
end

UI.start_all_hooks = function()
	local failed = { }
	local function try(Name, Function)
		local ok, result = pcall(Function)
		if not ok or result == false then
			table.insert(failed, Name)
		end
	end

	local keys = {"Tables", "Buffers", "InstanceNew", "Waits", "GetAttributes", "SetAttributes", "Sounds", "Connections", "Http", "Require"}
	local saved = { }
	for _, key in keys do
		saved[key] = Settings[key]
		Settings[key] = true
	end

	try("require", install_require)
	try("debug.info (game)", install_debug_info)
	try("http", UI.install_http)
	try("connections", __R.install_connections)
	try("table / buffer", UI.set_lib)
	try("Instance.new", UI.set_instance_new)
	try("task.wait", UI.set_wait)
	try("attributes / sound", UI.set_misc)
	for _, key in keys do
		Settings[key] = saved[key]
	end

	UI.set_lib()
	UI.sync_connections()
	return failed
end

