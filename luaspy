UI.keybind = function(content, label, key, allow_none)
	local row = New("Frame", {Parent = content, Size = UDim2.new(1, 0, 0, 18), BackgroundTransparency = 1})
	Text(row, {Size = UDim2.new(0.5, 0, 1, 0), Text = label})
	local box = Button(row, tostring(Settings[key]), {AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.new(0.5, 0, 1, 0)})
	local function draw(waiting)
		box.Text = waiting and "press a key..." or tostring(Settings[key])
		box.TextColor3 = waiting and T.Accent or T.Text
	end

	draw(false)
	table.insert(UI.check_draws, function() draw(false) end)
	Connect(box.MouseButton1Click, function()
		if UI.key_capture_cancel then
			UI.key_capture_cancel()
		end

		draw(true)
		UI.key_capture_cancel = function()
			UI.key_capture, UI.key_capture_cancel = nil, nil
			draw(false)
		end

		UI.key_capture = function(input_object)
			UI.key_capture, UI.key_capture_cancel = nil, nil
			local code = input_object.KeyCode
			if input_object.UserInputType ~= Enum.UserInputType.Keyboard or code == Enum.KeyCode.Escape or code == Enum.KeyCode.Unknown then
				draw(false)
				set_status("key not changed")
				return
			end

			if allow_none and (code == Enum.KeyCode.Backspace or code == Enum.KeyCode.Delete) then
				Settings[key] = "None"
				changed(key)
				draw(false)
				set_status(label .. " cleared")
				return
			end

			local other = key == "ToggleKey" and Settings.PauseKey or Settings.ToggleKey
			if code.Name == other or binds[code] then
				draw(false)
				set_status(code.Name .. " is already used, pick another")
				return
			end

			Settings[key] = code.Name
			changed(key)
			draw(false)
			set_status(label .. " = " .. code.Name)
		end
	end)
end

