do
local crash = UI.crash

crash.safe = function(fn, ...)
	local busy = shared.LibBusy
	shared.LibBusy = true
	local ok, result = pcall(fn, ...)
	shared.LibBusy = busy
	return ok and result or nil
end

crash.BlockedCode = { }
crash.BadFns = { }
crash.SpawnCounts = { }
crash.Mine = (function() return debug.info(1, "s") end)()

crash.root = function()
	local last
	for level = 2, 40 do
		local source, line, func = debug.info(level, "slf")
		if not source then
			break
		end

		if source ~= crash.Mine and source ~= "[C]" then
			local ok, defined = pcall(debug.info, func, "l")
			last = source .. ":" .. tostring(ok and defined or "?")
		end
	end

	return last
end

crash.learn_root = function(kind)
	local root = crash.root()
	if root and not crash.BadFns[root] then
		crash.BadFns[root] = "loops " .. kind
		crash.Dirty = true
	end
end

crash.spawn_blocked = function(Name, ...)
	local fn = ...
	if Name == "delay" then
		fn = select(2, ...)
	end

	if type(fn) ~= "function" or X.check_caller() then
		return false
	end

	local source, defined = debug.info(fn, "sl")
	if source == crash.Mine or source == "[C]" or not source then
		return false
	end

	local key = source .. ":" .. tostring(defined)
	if crash.BadFns[key] then
		return true
	end

	local count = (crash.SpawnCounts[key] or 0) + 1
	crash.SpawnCounts[key] = count
	if count >= (Settings.CrashSpawn or 200) then
		crash.BadFns[key] = "spawned " .. count .. "+ times in one frame"
		crash.Dirty = true
		return true
	end

	return false
end

crash.hook_spawn = function()
	if crash.SpawnHooked or not X.hook_function then
		return
	end

	local got, env = pcall(getrenv)
	local library = got and type(env) == "table" and env.task or task
	for _, Name in {"spawn", "defer", "delay"} do
		pcall(function()
			local old
			old = X.hook_function(library[Name], X.new_c_closure(function(...)
				if Settings.BlockSpawnCrash and crash.Ready and crash.spawn_blocked(Name, ...) then
					return coroutine.create(function() end)
				end

				return old(...)
			end))

			crash.SpawnHooked = true
		end)
	end

	if not crash.SpawnHooked then
		pcall(shared.notify, "couldn't hook task.spawn")
	end
end

crash.where = function()
	local mine = debug.info(1, "s")
	for level = 2, 14 do
		local source, line, Name, func = debug.info(level, "slnf")
		if not source then
			break
		end

		if source ~= mine and source ~= "[C]" then
			local ok, defined = pcall(debug.info, func, "l")
			return source, line or 0, (Name and Name ~= "") and Name or "anonymous", ok and defined or nil
		end
	end

	return "unknown", 0, "?"
end

crash.suspect = function(source)
	local best, score, conf
	local Now = os.clock()
	for _, item in crash.Recent do
		local age = Now - item.Time
		local Value, kind = 0, nil
		if source and item.Source == source and age <= 10 then
			Value, kind = 3 - age / 10, "same script"
		elseif crash.Frame - item.Frame <= 1 then
			Value, kind = 2, "same frame"
		elseif age <= 3 then
			Value, kind = 1 - age / 10, "recent"
		end

		if Value > (score or 0) then
			best, score, conf = item, Value, kind
		end
	end

	return best, conf
end

crash.attach = function(entry, item, conf)
	entry.Remote, entry.Dir, entry.Args, entry.Conf = item.Remote, item.Dir, item.Args, conf
	entry.Weak = conf == "recent"
	entry.Fired = item.Source and (item.Source .. ":" .. tostring(item.Line)) or nil
	if crash.on_found then
		task.defer(crash.on_found, entry)
	end
end

crash.record = function(remote, dir, ...)
	local source, line
	if dir == "out" then
		source, line = crash.where()
	end

	local item = {Remote = remote, Dir = dir, Frame = crash.Frame, Time = os.clock(), Args = table.pack(...), Source = source, Line = line}
	crash.Head = crash.Head % 64 + 1
	crash.Recent[crash.Head] = item
	for index = #crash.Pending, 1, -1 do
		local entry = crash.Pending[index]
		if crash.Frame - entry.Frame > 1 then
			table.remove(crash.Pending, index)
		elseif not entry.Remote then
			table.remove(crash.Pending, index)
			crash.attach(entry, item, "same frame")
			crash.Dirty = true
		end
	end
end

crash.announce = function(entry)
	pcall(shared.notify, "crash code: " .. entry.Kind .. " at " .. tostring(entry.Source) .. ":" .. tostring(entry.Line))
end

crash.trip = function(kind, detail)
	local source, line, func, defined = crash.where()
	local where = source .. ":" .. line
	local key = kind .. "|" .. where
	local entry
	local fresh = true
	crash.Hot[kind] = where
	for _, old in crash.Found do
		if old.Key == key then
			entry = old
			fresh = false
			break
		end
	end

	if not entry then
		entry = {Key = key, Kind = kind, Source = source, Line = line, Func = func, Defined = defined, Hits = 0, root = crash.root()}
		table.insert(crash.Found, 1, entry)
		if #crash.Found > 30 then
			table.remove(crash.Found)
		end
	end

	entry.Detail, entry.Hits, entry.Time, entry.Frame = detail, entry.Hits + 1, os.clock(), crash.Frame
	if Settings.CrashAutoBlock then
		crash.BlockedCode[key] = true
	end

	if not entry.Remote then
		local item, conf = crash.suspect(source)
		if item then
			crash.attach(entry, item, conf)
		elseif not table.find(crash.Pending, entry) then
			table.insert(crash.Pending, entry)
		end
	end

	crash.Dirty = true
	if fresh then
		task.defer(crash.announce, entry)
	end
end

crash.Note = function(kind, ...)
	if crash.Drawing or X.check_caller() then
		return false
	end

	if kind == "buffer.create" then
		local size = ...
		if type(size) == "number" and size > (Settings.CrashBufferMB or 32) * 1048576 then
			crash.trip(kind, string.format("%.0f MB requested", size / 1048576))
			return true
		end

		return false
	end

	if next(crash.BlockedCode) then
		local source, line = crash.where()
		if crash.BlockedCode[kind .. "|" .. source .. ":" .. line] then
			return "kill"
		end
	end

	local count = (crash.Counts[kind] or 0) + 1
	local limit = kind == "print" and (Settings.CrashPrint or 150) or (Settings.CrashNew or 400)
	crash.Counts[kind] = count
	if count == limit then
		crash.trip(kind, limit .. "+ calls in one frame")
	end

	if count >= limit then
		local source, line = crash.where()
		local where = source .. ":" .. line
		local own = (crash.Counts[kind .. where] or 0) + 1
		crash.Counts[kind .. where] = own
		if own == limit and count ~= limit then
			crash.trip(kind, limit .. "+ calls in one frame")
		end

		if (Settings.CrashAutoBlock or Settings.BlockSpawnCrash) and (where == crash.Hot[kind] or own >= limit) then
			if Settings.BlockSpawnCrash then
				crash.learn_root(kind)
			end

			return "kill"
		end
	end

	return false
end

crash.make_rule = function(args)
	local rule = {Count = args.n, Modes = { }, Types = { }, Values = { }}
	for index = 1, math.min(args.n, 10) do
		local Value = args[index]
		rule.Types[index] = typeof(Value)
		rule.Values[index] = UI.value_key(Value)
		rule.Modes[index] = Settings.CrashArgMode == "type" and "type" or "value"
	end

	return rule
end

crash.arg_blocked = function(remote, count, ...)
	for _, rule in crash.ArgBlocks[remote] or { } do
		local ok, hit = pcall(UI.rule_matches, rule, count, ...)
		if ok and hit then
			return true
		end
	end

	return false
end

crash.scan = function(remote)
	local state = crash.Proxy[remote]
	if not state or not getconnections then
		return
	end

	local ok, list = pcall(getconnections, remote.OnClientEvent)
	for _, Connection in ok and list or { } do
		local got, fn = pcall(function() return Connection.Function end)
		if got and type(fn) == "function" and not crash.OwnFns[fn] and not state.Seen[fn] and pcall(function() Connection.Disable(Connection) end) then
			state.Fns[Connection] = fn
			state.Seen[fn] = true
		end
	end
end

crash.ensure_proxy = function(remote)
	if not getconnections then
		return false
	end

	if not crash.Proxy[remote] then
		local state = {Fns = { }, Seen = { }}
		crash.Proxy[remote] = state
		local callback = function(...)
			if crash.FullIn[remote] or (crash.ArgBlocks[remote] and crash.arg_blocked(remote, select("#", ...), ...)) then
				return
			end

			for _, fn in state.Fns do
				task.spawn(fn, ...)
			end
		end

		crash.OwnFns[callback] = true
		state.Conn = remote.OnClientEvent.Connect(remote.OnClientEvent, callback)
	end

	crash.scan(remote)
	return true
end

crash.unproxy = function(remote)
	local state = crash.Proxy[remote]
	if not state then
		return
	end

	crash.Proxy[remote] = nil
	pcall(function() state.Conn.Disconnect(state.Conn) end)
	for Connection in state.Fns do
		pcall(function() Connection.Enable(Connection) end)
	end
end

crash.Watch = function(remote)
	if crash.Watched[remote] or self_ignore[remote] then
		return
	end

	local class = remote.ClassName
	if class ~= "RemoteEvent" and class ~= "UnreliableRemoteEvent" then
		return
	end

	local callback = function(...)
		if active and UI.crash_detect() then
			crash.safe(crash.record, remote, "in", ...)
		end
	end

	crash.OwnFns[callback] = true
	crash.Watched[remote] = remote.OnClientEvent.Connect(remote.OnClientEvent, callback)
end

crash.start = function()
	if crash.Beat then
		return
	end

	crash.Beat = run_service.Heartbeat.Connect(run_service.Heartbeat, function()
		crash.Frame += 1
		crash.Counts = { }
		crash.SpawnCounts = { }
		if crash.Frame % 30 == 0 then
			for remote in crash.Proxy do
				pcall(crash.scan, remote)
			end
		end

		if crash.Dirty and crash.redraw then
			crash.Dirty = false
			crash.redraw()
		end
	end)

	crash.Added = game.DescendantAdded.Connect(game.DescendantAdded, function(object)
		pcall(crash.Watch, object)
	end)

	local ok, all = pcall(game.GetDescendants, game)
	for _, object in ok and all or { } do
		pcall(crash.Watch, object)
	end

	if not crash.PrintHooked and X.hook_function then
		crash.PrintHooked = pcall(function()
			local old
			old = X.hook_function(print, X.new_c_closure(function(...)
				if active and UI.crash_detect() and crash.safe(crash.Note, "print", ...) == "kill" then
					error("[remote spy] crash code stopped", 0)
				end

				return old(...)
			end))
		end)
	end
end

crash.stop = function()
	if crash.Beat then
		crash.Beat.Disconnect(crash.Beat)
		crash.Beat = nil
	end

	if crash.Added then
		crash.Added.Disconnect(crash.Added)
		crash.Added = nil
	end

	for remote, Connection in crash.Watched do
		Connection.Disconnect(Connection)
		crash.Watched[remote] = nil
	end

	crash.Recent, crash.Pending, crash.Counts = { }, { }, { }
end

crash.sync = function()
	if UI.crash_detect() then
		crash.start()
		if Settings.BlockSpawnCrash then
			crash.hook_spawn()
		end

		UI.set_instance_new()
		UI.install_create()
	else
		crash.stop()
	end
end

crash.cleanup = function()
	crash.stop()
	for remote in crash.Proxy do
		crash.unproxy(remote)
	end
end

crash.Ready = true
end

