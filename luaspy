function UI.highlight(source)
	local colors = UI.syntax_colors
	local length = #source
	if length > 80000 then
		return Esc(source)
	end

	local out = {}
	local position = 1
	local previous = ""
	local function put(piece, color)
		local escaped = Esc(piece)
		if not color then
			table.insert(out, escaped)
			return
		end

		if string.find(escaped, "\n", 1, true) then
			escaped = string.gsub(escaped, "[^\n]+", function(line)
				return '<font color="' .. color .. '">' .. line .. "</font>"
			end)

			table.insert(out, escaped)
		else
			table.insert(out, '<font color="' .. color .. '">' .. escaped .. "</font>")
		end
	end

	while position <= length do
		local Char = string.sub(source, position, position)
		if Char == "-" and string.find(source, "^%-%-", position) then
			local level = string.match(source, "^%-%-%[(=*)%[", position)
			local stop
			if level then
				local _, close = string.find(source, "]" .. level .. "]", position, true)
				stop = close or length
			else
				stop = (string.find(source, "\n", position, true) or length + 1) - 1
			end

			put(string.sub(source, position, stop), colors.Comment)
			position = stop + 1
		elseif Char == '"' or Char == "'" then
			local stop = position + 1
			while stop <= length do
				local current = string.sub(source, stop, stop)
				if current == "\\" then
					stop += 2
				elseif current == Char or current == "\n" then
					break
				else
					stop += 1
				end
			end

			put(string.sub(source, position, stop), colors.String)
			position = stop + 1
			previous = Char
		elseif Char == "[" and string.find(source, "^%[=*%[", position) then
			local level = string.match(source, "^%[(=*)%[", position)
			local _, close = string.find(source, "]" .. level .. "]", position, true)
			local stop = close or length
			put(string.sub(source, position, stop), colors.String)
			position = stop + 1
			previous = "]"
		elseif string.find(Char, "%d") or (Char == "." and string.find(source, "^%.%d", position)) then
			local _, stop = string.find(source, "^0[xX][%x_]+", position)
			if not stop then
				_, stop = string.find(source, "^%d*%.?%d*", position)
				local _, exponent = string.find(source, "^[eE][%+%-]?%d+", stop + 1)
				stop = exponent or stop
			end

			put(string.sub(source, position, stop), colors.number)
			position = stop + 1
			previous = "0"
		elseif string.find(Char, "[%a_]") then
			local _, stop = string.find(source, "^[%w_]+", position)
			local word = string.sub(source, position, stop)
			local color
			if UI.lua_keywords[word] then
				color = colors.Keyword
			elseif word == "true" or word == "false" or word == "nil" then
				color = colors.Boolean
			elseif previous == "." or previous == ":" then
				color = string.find(source, "^%s*[%(\"'{]", stop + 1) and colors.Call or colors.Property
			elseif UI.lua_globals[word] then
				color = colors.Global
			elseif string.find(source, "^%s*[%(\"'{]", stop + 1) then
				color = colors.Call
			end

			put(word, color)
			position = stop + 1
			previous = "a"
		elseif string.find(Char, "%s") then
			local _, stop = string.find(source, "^%s+", position)
			put(string.sub(source, position, stop))
			position = stop + 1
		elseif string.find(Char, "[%+%-%*/%%%^#=<>~]") then
			local _, stop = string.find(source, "^[%+%-%*/%%%^#=<>~]+", position)
			put(string.sub(source, position, stop), colors.Operator)
			position = stop + 1
			previous = Char
		else
			put(Char)
			position += 1
			previous = Char
		end
	end

	return table.concat(out)
end

local function fill_code(body, source, fade)
	fade = fade and Settings.LogAnimations
	if UI.code_last[body] == source and body.FindFirstChildWhichIsA(body, "GuiObject") then
		return
	end

	UI.code_last[body] = source
	for _, child in body.GetChildren(body) do
		if child.IsA(child, "GuiObject") then
			child.Destroy(child)
		end
	end

	local lines = string.split(source, "\n")
	local colored = string.split(UI.highlight(source), "\n")
	local number_width = #tostring(#lines) * UI.mono_width + 10
	local chunk = 0
	for start = 1, #lines, 120 do
		local numbers, code = { }, { }
		chunk += 1
		for line = start, math.min(start + 119, #lines) do
			table.insert(numbers, tostring(line))
			table.insert(code, colored[line] or "")
		end

		local row = New("Frame", {Parent = body, LayoutOrder = start, Size = UDim2.new(0, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.XY, BackgroundTransparency = 1})
		local number_label = Text(row, {Name = "CodeText", Size = UDim2.new(0, number_width - 10, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextXAlignment = Enum.TextXAlignment.Right, TextYAlignment = Enum.TextYAlignment.Top, TextTruncate = Enum.TextTruncate.None, TextColor3 = T.Dim, FontFace = UI.code_font, TextSize = UI.code_size, Text = table.concat(numbers, "\n")})
		local code_label = Text(row, {Name = "CodeText", Position = UDim2.new(0, number_width, 0, 0), AutomaticSize = Enum.AutomaticSize.XY, TextYAlignment = Enum.TextYAlignment.Top, TextTruncate = Enum.TextTruncate.None, FontFace = UI.code_font, TextSize = UI.code_size, RichText = true, Text = table.concat(code, "\n")})
		if fade then
			for _, label in {number_label, code_label} do
				label.TextTransparency = 1
				UI.Smooth(label, {TextTransparency = 0}, 0.6)
				local outline = label.FindFirstChild(label, "TxtOutline")
				if outline then
					outline.Transparency = 1
					UI.Smooth(outline, {Transparency = 0.6}, 0.6)
				end
			end
		end
	end

	if fade then
		body.Position = UDim2.new(0, 0, 0, 12)
		UI.Smooth(body, {Position = UDim2.new(0, 0, 0, 0)}, 0.55)
	else
		body.Position = UDim2.new(0, 0, 0, 0)
	end
end

