UI.anim_seen = function(track, animator)
	if not active then
		return
	end

	local animation = track.Animation
	local raw = animation and animation.AnimationId
	if type(raw) ~= "string" or raw == "" or string.sub(raw, 1, 10) == "rbxasset:/" then
		return
	end

	local entry = UI.anims[raw]
	if entry then
		return
	end

	if not Settings.AnimDefaults and UI.anim_default_ids[string.match(raw, "%d+") or ""] then
		return
	end

	local model = animator.FindFirstAncestorOfClass(animator, "Model")
	entry = {Id = raw, Name = track.Name ~= "" and track.Name or animation.Name, Owner = model and model.Name or "?", Length = track.Length, Looped = track.Looped}
	UI.anims[raw] = entry
	table.insert(UI.anim_order, raw)
	UI.anim_dirty = true
	if Settings.Animations and not paused and not replaying then
		pcall(push, animation, "Play", "anim", nil, nil, 1, raw)
	end
end

UI.watch_animator = function(animator)
	if UI.anim_watched[animator] then
		return
	end

	UI.anim_watched[animator] = true
	Connect(animator.AnimationPlayed, function(track)
		pcall(UI.anim_seen, track, animator)
	end)

	for _, track in animator.GetPlayingAnimationTracks(animator) do
		pcall(UI.anim_seen, track, animator)
	end
end

UI.anim_add = function(object)
	local raw = object.AnimationId
	if type(raw) ~= "string" or raw == "" or string.sub(raw, 1, 10) == "rbxasset:/" then
		return
	end

	if not Settings.AnimDefaults and UI.anim_default_ids[string.match(raw, "%d+") or ""] then
		return
	end

	local path = object.GetFullName(object)
	if string.sub(path, 1, 7) == "CoreGui" or string.sub(path, 1, 12) == "CorePackages" then
		return
	end

	local entry = UI.game_anims[raw]
	if entry then
		entry.Copies += 1
		return
	end

	UI.game_anims[raw] = {Id = raw, Name = object.Name, Path = path, Copies = 1}
	table.insert(UI.game_anim_order, raw)
	UI.game_anim_dirty = true
end

UI.anim_scan = function()
	if UI.anim_scanning then
		return
	end

	UI.anim_scanning = true
	UI.game_anims, UI.game_anim_order = { }, { }
	local done = 0
	for _, object in game.GetDescendants(game) do
		if object.ClassName == "Animation" then
			pcall(UI.anim_add, object)
		end

		done += 1
		if done % 3000 == 0 then
			task.wait()
		end
	end

	if getnilinstances then
		pcall(function()
			for _, object in getnilinstances() do
				if typeof(object) == "Instance" and object.ClassName == "Animation" then
					pcall(UI.anim_add, object)
				end
			end
		end)
	end

	if not UI.anim_scan_hooked then
		UI.anim_scan_hooked = true
		Connect(game.DescendantAdded, function(object)
			if object.ClassName == "Animation" then
				pcall(UI.anim_add, object)
			end
		end)
	end

	UI.anim_scanning = false
	UI.game_anim_dirty = true
end

UI.anim_info = function(Id)
