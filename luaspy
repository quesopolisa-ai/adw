UI.find_caller = function(Info)
	local options = {IgnoreExecutor = true, Name = Info.Name}
	local ok_list, list = pcall(filtergc, "function", options)
	if not ok_list or type(list) ~= "table" then
		list = getgc()
	end

	local best, best_line
	for _, candidate in list do
		if type(candidate) == "function" and debug.info(candidate, "s") == Info.Source and (not Info.Name or debug.info(candidate, "n") == Info.Name) then
			local defined = debug.info(candidate, "l")
			local count, vararg = debug.info(candidate, "a")
			if (not Info.Params or count == Info.Params) and vararg == (Info.Vararg and true or false) and defined <= (tonumber(Info.Line) or 0) and (not best_line or defined > best_line) then
				best, best_line = candidate, defined
			end
		end
	end

	return best
end

UI.is_packet_log = function(Log)
	return Log.Kind == "lib" and UI.packet_senders[Log.Remote] ~= nil
end

UI.fresh_packet_args = function(Log)
	local args = resolve(Log)
	local seen = { }
	local function fresh(Value, key)
		if type(Value) == "number" and type(key) == "string" and string.find(string.lower(key), "time", 1, true) then
			local ok, Now = pcall(function() return workspace.GetServerTimeNow(workspace) end)
			return ok and Now or Value
		end

		if type(Value) == "table" then
			if seen[Value] then
				return seen[Value]
			end

			local copy = { }
			seen[Value] = copy
			for index, item in next, Value do
				copy[index] = fresh(item, index)
			end

			return copy
		end

		return Value
	end

	local out = { }
	for index = 1, Log.Count do
		out[index] = fresh(args[index])
	end

	return out
end

local function replay(Log)
	task.spawn(function()
		local remote = Log.Remote
		local args = resolve(Log)
		local ok, result
		if Settings.CallViaFunction and Log.Info and not Log.Actor and (Log.Kind == "event" or Log.Kind == "unreliable" or Log.Kind == "function") then
			local with_args = Settings.CallMode == "with args"
			local Info = with_args and Log.Info or (Log.Info.Outer or Log.Info)
			local Game = UI.find_caller(Info)
			if not Game then
				set_status("couldn't find the game function (do the action in-game first)")
				return
			end

			replaying = true
			if with_args then
				ok, result = pcall(Game, table.unpack(args, 1, Log.Count))
			else
				ok, result = pcall(Game)
			end

			replaying = false
			set_status(ok and ("ran " .. (Info.Name or "game function")) or ("run failed: " .. tostring(result)))
			return
		end

		if Log.Kind == "debuginfo" then
			ok, result = pcall(function() return table.pack((raw_debug_info or debug.info)(table.unpack(args, 1, Log.Count))) end)
			if ok then
				Log.Result = result
				show_code(generate(Log))
			end

			set_status(ok and "ran debug.info" or ("run failed: " .. tostring(result)))
			return
		end

		if Log.Kind == "http" then
			set_status("sending " .. display_name(Log) .. "...")
			env.__LarpHttpSelf = true
			ok, result = pcall(function()
				local Method = Log.Method
				if Method == "request" then
					assert(X.Request, "no request function in this executor")
					return X.Request(args[1])
				elseif Method == "RequestAsync" then
					return http_service.RequestAsync(http_service, args[1])
				elseif string.find(Method, "^Http") then
					return game[Method](game, table.unpack(args, 1, Log.Count))
				end

				local service = game.GetService(game, "HttpService")
				return service[Method](service, table.unpack(args, 1, Log.Count))
			end)

			env.__LarpHttpSelf = false
			if ok then
				local Text
				if type(result) == "table" then
					Text = "status " .. tostring(result.StatusCode) .. " " .. tostring(result.StatusMessage or "") .. "\n" .. tostring(result.Body)
				else
					Text = tostring(result)
				end

				show_code(generate(Log) .. "\n\n-- response:\n-- " .. (string.gsub(string.sub(Text, 1, 4000), "\n", "\n-- ")))
			end

			set_status(ok and ("sent " .. display_name(Log)) or ("send failed: " .. tostring(result)))
			return
		end

		if Log.Kind == "connection" then
			set_status("a connection can't be replayed (the callback is the game's own function)")
			return
		end

		if Log.Kind == "purchase" and string.find(Log.Method, "Finished$") and not string.find(Log.Method, "^Signal") then
			if not X.FireSignal then
				set_status("no firesignal in this executor")
				return
			end

			replaying = true
			ok, result = pcall(function() return X.FireSignal(Log.Remote[Log.Method], table.unpack(args, 1, Log.Count)) end)
			replaying = false
			set_status(ok and ("fired " .. Log.Method) or ("run failed: " .. tostring(result)))
			return
		end

		if Log.Signal then
			local Function = Log.Kind == "replicatesignal" and X.ReplicateSignal or X.FireSignal
			if not Function then
				set_status("no " .. Log.Kind .. " in this executor")
				return
			end

			replaying = true
			ok, result = pcall(Function, Log.Signal, table.unpack(args, 1, Log.Count))
			replaying = false
			set_status(ok and ("ran " .. Log.Kind .. " " .. Log.EventName) or ("run failed: " .. tostring(result)))
			return
		elseif Log.Kind == "raknet" then
			UI.raknet_send(Log)
			return
		elseif (Log.Kind == "lib" and not UI.is_packet_log(Log)) or Log.Kind == "logservice" or Log.Kind == "wait" then
			set_status(Log.Kind == "lib" and "table / buffer calls aren't run" or (Log.Kind == "wait" and "waits aren't run" or "output lines aren't run"))
			return
		elseif Log.Kind == "kick" or Log.Kind == "shutdown" or Log.Kind == "parentnil" or Log.Kind == "create" then
			set_status("not running a " .. Log.Kind .. " on yourself")
			return
		elseif Log.Kind == "lib" then
			local sender = UI.packet_senders[Log.Remote]
			replaying = true
			ok, result = pcall(function()
				local packed = UI.fresh_packet_args(Log)
				return sender(table.unpack(packed, 1, Log.Count))
			end)

			replaying = false
		elseif Log.Kind == "require" then
			ok, result = pcall(function() return table.pack(require(remote)) end)
			if ok then
				Log.Result = result
				show_code(generate(Log))
			end
		elseif Log.Kind == "incoming" then
			if not X.FireSignal then
				set_status("no firesignal in this executor")
				return
			end

			replaying = true
			ok, result = pcall(X.FireSignal, remote.OnClientEvent, table.unpack(args, 1, Log.Count))
			replaying = false
		elseif Log.Kind == "guiclick" then
			if not X.FireSignal then
				set_status("no firesignal in this executor")
				return
			end

			replaying = true
			ok, result = pcall(function()
				for _, Name in UI.gui_signals(remote) do
					X.FireSignal(remote[Name])
				end
			end)

			replaying = false
		elseif Log.Kind == "touch" or Log.Kind == "click" then
			local Function = Log.Kind == "touch" and X.fire_touch or X.fire_click
			if not Function then
				set_status("no " .. Log.Method .. " in this executor")
				return
			end

			replaying = true
			ok, result = pcall(Function, remote, table.unpack(args, 1, Log.Count))
			replaying = false
		elseif Log.Kind == "prompt" then
			if not X.fire_proximity then
				set_status("no fireproximityprompt in this executor")
				return
			end

			replaying = true
			ok, result = pcall(X.fire_proximity, remote, table.unpack(args, 1, Log.Count))
			replaying = false
		elseif Log.Kind == "function" or Log.Method == "Invoke" then
			set_status("invoking " .. name_of(remote) .. "...")
			ok, result = pcall(function()
				return table.pack(remote[string.gsub(Log.Method, "^%l", string.upper)](remote, table.unpack(args, 1, Log.Count)))
			end)

			if ok then
				local parts = { }
				for index = 1, result.n do
					table.insert(parts, serialize(result[index]))
				end

				show_code(generate(Log) .. "\n\n-- returned:\n-- " .. (string.gsub(table.concat(parts, ", "), "\n", "\n-- ")))
			end
		else
			ok, result = pcall(function()
				remote[string.gsub(Log.Method, "^%l", string.upper)](remote, table.unpack(args, 1, Log.Count))
			end)
		end

		set_status(ok and ("ran " .. display_name(Log)) or ("run failed: " .. tostring(result)))
	end)
end

UI.block_touch_part = function(part, Bool)
	if typeof(part) ~= "Instance" or not pcall(function() return part.IsA(part, "BasePart") end) or not part.IsA(part, "BasePart") then
		return
	end

	pcall(function()
		if Bool then
			if UI.touch_blocked[part] == nil then
				UI.touch_blocked[part] = part.CanTouch
			end

			part.CanTouch = false
			if UI.start_touch_poll then
				UI.start_touch_poll()
			end
		elseif UI.touch_blocked[part] ~= nil then
			part.CanTouch = UI.touch_blocked[part]
			UI.touch_blocked[part] = nil
		end
	end)
end

UI.auto_block = function(object)
	if not Settings.BlockAllTouches or object.Name ~= "TouchInterest" then
		return
	end

	local part = object.Parent
	local character = players.LocalPlayer.Character
	if typeof(part) ~= "Instance" or not part.IsA(part, "BasePart") or (character and part.IsDescendantOf(part, character)) then
		return
	end

	UI.auto_blocked[part] = true
	UI.block_touch_part(part, true)
end

UI.set_block_all_touches = function(Bool)
	if Bool then
		if not UI.auto_block_connection then
			UI.auto_block_connection = Connect(game.DescendantAdded, function(object)
				pcall(UI.auto_block, object)
			end)
		end

		task.spawn(function()
			local ok, all = pcall(game.GetDescendants, game)
			for index, object in ok and all or { } do
				if Settings.BlockAllTouches then
					pcall(UI.auto_block, object)
				end

				if index % 3000 == 0 then
					task.wait()
				end
			end

			local count = 0
			for _ in UI.auto_blocked do
				count += 1
			end

			set_status("blocked touches on " .. count .. " parts")
		end)
	else
		for part in UI.auto_blocked do
			if not blocked[part] then
				UI.block_touch_part(part, false)
			end

			UI.auto_blocked[part] = nil
		end

		set_status("touch blocking off")
	end
end

UI.apply_name_block = function(object, Bool)
	pcall(function()
		if object.IsA(object, "BasePart") then
			UI.block_touch_part(object, Bool)
		elseif object.IsA(object, "ClickDetector") then
			if Bool then
				if UI.name_original[object] == nil then
					UI.name_original[object] = object.MaxActivationDistance
				end

				object.MaxActivationDistance = 0
			elseif UI.name_original[object] ~= nil then
				object.MaxActivationDistance = UI.name_original[object]
				UI.name_original[object] = nil
			end
		elseif object.IsA(object, "ProximityPrompt") then
			if Bool then
				if UI.name_original[object] == nil then
					UI.name_original[object] = object.Enabled
				end

				object.Enabled = false
			elseif UI.name_original[object] ~= nil then
				object.Enabled = UI.name_original[object]
				UI.name_original[object] = nil
			end
		elseif object.IsA(object, "RemoteEvent") or object.IsA(object, "RemoteFunction") or object.IsA(object, "UnreliableRemoteEvent") then
			UI.fire_all("block", object, Bool)
		end
	end)
end

