-- every game frame between debug.info and the bottom of the stack (spy, executor and C frames skipped), innermost first
function __R.full_stack(limit)
	local raw = UI.stack_raw(raw_debug_info or debug.info)
	local own = __R.own_source()
	local is_executor = isexecutorclosure or is_executor_closure or checkclosure or is_synapse_function
	local frames = { }
	for level = 2, limit or 40 do
		local ok, source, line, Name, params, vararg, Function = pcall(raw, level, "slnaf")
		if not ok or source == nil then
			break
		end

		local mine = source == "[C]" or source == own
		if not mine and is_executor and type(Function) == "function" then
			local ok_exec, executor = pcall(is_executor, Function)
			mine = ok_exec and executor == true
		end

		if not mine then
			table.insert(frames, {
				Source = source,
				Line = line,
				Name = (Name and Name ~= "") and Name or nil,
				Params = params,
				Vararg = vararg,
			})
		end
	end

	return frames
end

UI.find_upvalues = function(args, count)
	local raw = UI.stack_raw(raw_debug_info or debug.info)
	local get_upvalues = getupvalues or (debug and debug.getupvalues)
	if not raw or not get_upvalues then
		return nil
	end

	local leaves = { }
	local wanted = nil
	local spec = string.lower(tostring(Settings.UpvalueArgs or "all"))
	if string.match(spec, "%d") then
		wanted = { }
		for piece in string.gmatch(spec, "%d+") do
			wanted[tonumber(piece)] = true
		end
	end

	for index = 1, count do
		local Value = args[index]
		if wanted and not wanted[index] then
		elseif type(Value) == "table" then
			local seen = 0
			for key, inner in next, Value do
				seen += 1
				if seen > 30 then
					break
				end

				if (type(inner) == "number" or type(inner) == "string") and (type(key) == "string" or type(key) == "number") then
					table.insert(leaves, {Index = index, Key = key, Value = inner, Found = { }})
				end

				if type(key) == "string" and #key >= 12 and string.match(key, "%d") and not string.match(key, "^[%a_]+$") and string.match(key, "^[%w%-_{}]+$") then
					table.insert(leaves, {Index = index, Key = key, KeyLeaf = true, Value = key, Found = { }})
				end
			end
		elseif type(Value) == "number" or type(Value) == "string" then
			table.insert(leaves, {Index = index, Value = Value, Found = { }})
		end
	end

	if #leaves == 0 then
		return nil
	end

	local own = raw(1, "s")
	local function name_matches(inst, leaf)
		local ok, Name = pcall(function() return inst.Name end)
		if not ok or type(Name) ~= "string" then
			return false
		end

		if type(leaf.Value) == "number" then
			return tonumber(Name) == leaf.Value
		end

		return Name == leaf.Value
	end

	local function check(func)
		local ok_up, ups = pcall(get_upvalues, func)
		if not ok_up or type(ups) ~= "table" then
			return
		end

		local ok_info, f_source, f_line, f_name = pcall(raw, func, "sln")
		if not ok_info then
			return
		end

		for up_index, up_value in next, ups do
			if type(up_value) == "number" or type(up_value) == "string" then
				for _, leaf in leaves do
					if leaf.Value == up_value and #leaf.Found < 6 then
						table.insert(leaf.Found, {Source = f_source, Line = f_line, Name = f_name or "", Up = up_index})
					end
				end
			elseif typeof(up_value) == "Instance" then
				for _, leaf in leaves do
					if #leaf.Found < 6 and name_matches(up_value, leaf) then
						table.insert(leaf.Found, {Source = f_source, Line = f_line, Name = f_name or "", Up = up_index, Field = ".Name", ToNumber = type(leaf.Value) == "number"})
					end
				end
			elseif type(up_value) == "table" then
				local budget = 400
				local visited = { }
				local function scan(tbl, access, depth)
					if visited[tbl] or budget <= 0 then
						return
					end

					visited[tbl] = true
					for field, inner in next, tbl do
						budget -= 1
						if budget <= 0 then
							return
						end

						if type(field) == "string" then
							for _, leaf in leaves do
								if leaf.KeyLeaf and leaf.Value == field and #leaf.Found < 6 then
									table.insert(leaf.Found, {Source = f_source, Line = f_line, Name = f_name or "", Up = up_index, Field = access, KeyOf = true})
								end
							end
						end

						if type(field) == "string" or type(field) == "number" then
							local path = access .. ((type(field) == "string" and string.match(field, "^[%a_][%w_]*$")) and ("." .. field) or ("[" .. (type(field) == "string" and string.format("%q", field) or tostring(field)) .. "]"))
							if type(inner) == "number" or type(inner) == "string" then
								for _, leaf in leaves do
									if leaf.Value == inner and #leaf.Found < 6 then
										table.insert(leaf.Found, {Source = f_source, Line = f_line, Name = f_name or "", Up = up_index, Field = path})
									end
								end
							elseif typeof(inner) == "Instance" then
								for _, leaf in leaves do
									if #leaf.Found < 6 and name_matches(inner, leaf) then
										table.insert(leaf.Found, {Source = f_source, Line = f_line, Name = f_name or "", Up = up_index, Field = path .. ".Name", ToNumber = type(leaf.Value) == "number"})
									end
								end
							elseif type(inner) == "table" and depth < 3 then
								scan(inner, path, depth + 1)
							end
						end
					end
				end

				pcall(scan, up_value, "", 1)
			end
		end
	end

	local sources = { }
	for level = 2, 14 do
		local ok, source, func = pcall(raw, level, "sf")
		if not ok or source == nil then
			break
		end

		if source ~= "[C]" and source ~= own and type(func) == "function" then
			sources[source] = true
			check(func)
		end
	end

	local missing = false
	for _, leaf in leaves do
		if #leaf.Found == 0 then
			missing = true
		end
	end

	if missing and Settings.UpvalueDeep then
		UI.deep_funcs = UI.deep_funcs or { }
		if os.clock() - (UI.deep_scan_at or 0) > 3 then
			UI.deep_scan_at = os.clock()
			UI.deep_funcs = { }
			local list = nil
			if filtergc then
				local ok_list, result = pcall(filtergc, "function", {IgnoreExecutor = true})
				list = ok_list and type(result) == "table" and result or nil
			end

			local kept = 0
			for _, func in list or getgc() do
				if type(func) == "function" and kept < 40 then
					local ok_source, source = pcall(raw, func, "s")
					if ok_source and sources[source] then
						local before = 0
						for _, leaf in leaves do
							before += #leaf.Found
						end

						check(func)
						local after = 0
						for _, leaf in leaves do
							after += #leaf.Found
						end

						if after > before then
							kept += 1
							UI.deep_funcs[func] = true
						end
					end
				end
			end
		else
			for func in UI.deep_funcs do
				check(func)
			end
		end
	end

	for index = #leaves, 1, -1 do
		if #leaves[index].Found == 0 then
			table.remove(leaves, index)
		end
	end

	return #leaves > 0 and leaves or nil
end

