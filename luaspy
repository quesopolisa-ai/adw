local function set_ignored(remote, Bool)
	ignored[remote] = Bool or nil
	UI.refresh_lists()
	if channel then
		UI.fire_all("ignore", remote, Bool)
	end

	if Bool then
		local kept = { }
		for _, Log in logs do
			if Log.Remote ~= remote then
				table.insert(kept, Log)
			end
		end

		logs = kept
		stacks[remote] = nil
		if selected and selected.Remote == remote then
			show_details(nil)
		end
	end

	rebuild()
end

UI.set_ignored_name = function(Name, Bool)
	ignored_names[Name] = Bool or nil
	UI.refresh_lists()
	if Bool then
		local kept = { }
		for _, Log in logs do
			if UI.log_name(Log) ~= Name then
				table.insert(kept, Log)
			else
				unstack(Log)
			end
		end

		logs = kept
		if selected and UI.log_name(selected) == Name then
			show_details(nil)
		end
	end

	set_status((Bool and "ignoring everything named " or "no longer ignoring ") .. Name)
	rebuild()
end

do local function latest_call(row)
	local picked = row.ViewIndex
	row.ViewIndex = nil
	local latest = viewed(row)
	row.ViewIndex = picked
	return latest
end

UI.refresh_loop = function(Log)
	if not UI.loop_button then
		return
	end

	local Running = UI.loops[Log] ~= nil
	UI.loop_button.Text = (Running and "stop loop" or "loop") .. (Log.LoopKey and (" [" .. Log.LoopKey .. "]") or "")
	UI.loop_button.TextColor3 = Running and T.Accent or T.Text
end

UI.set_loop = function(Log, Bool)
	if (Log.Kind == "lib" and not UI.is_packet_log(Log)) or Log.Kind == "logservice" or Log.Kind == "wait" or Log.Kind == "raknet" then
		set_status("not looping a " .. kinds[Log.Kind].Tag .. " row")
		return
	end

	if Log.Kind == "kick" or Log.Kind == "shutdown" or Log.Kind == "parentnil" or Log.Kind == "create" then
		set_status("not looping a " .. Log.Kind .. " on yourself")
		return
	end

	if not Bool then
		UI.loops[Log] = nil
		set_status("loop stopped: " .. display_name(Log))
	else
		local token = { }
		UI.loops[Log] = token
		set_status("looping " .. display_name(Log) .. " every " .. tostring(Settings.RunDelay) .. "s")
		task.spawn(function()
			while active and UI.loops[Log] == token and table.find(logs, Log) do
				replay(latest_call(Log))
				task.wait(math.max(0.01, tonumber(Settings.RunDelay) or 0.1))
			end

			if UI.loops[Log] == token then
				UI.loops[Log] = nil
			end

			render()
			if selected == Log then
				UI.refresh_loop(Log)
			end
		end)
	end

	render()
	if selected == Log then
		UI.refresh_loop(Log)
	end
end end

UI.export_logs = function()
	if not writefile then
		set_status("no writefile in this executor")
		return
	end

	ensure_folder()
	local out = { }
	for index = #logs, 1, -1 do
		local Log = logs[index]
		if Settings.ExportFormat == "summary" then
			table.insert(out, string.format("[%s] %s %s %s (%d args) x%d", Log.Time, kinds[Log.Kind].Tag, display_name(Log), Log.Method, Log.Count, Log.Calls))
		else
			local ok, code = pcall(generate, viewed(Log))
			table.insert(out, "-- [" .. Log.Time .. "] " .. display_name(Log) .. "\n" .. (ok and code or "-- couldn't generate"))
		end
	end

	local Name = folder .. "/export_" .. os.date("%Y%m%d_%H%M%S") .. ".txt"
	local ok, Error = pcall(writefile, Name, table.concat(out, "\n\n"))
	set_status(ok and ("exported " .. #logs .. " logs to " .. Name) or ("export failed: " .. tostring(Error)))
end

