UI.packet_hooked = UI.packet_hooked or setmetatable({ }, {__mode = "k"})

UI.hook_one_packet = function(Name, packet, Path, Via)
	local added = 0
	for _, Method in {"send", "invoke"} do
		local target = type(packet) == "table" and UI.safe_get(packet, Method)
		if type(target) == "function" and not UI.packet_hooked[target] then
			local require_label = Path and ("require(" .. Path .. ")" .. (Via and ("." .. Via) or "") .. UI.member(Name) .. "." .. Method) or nil
			local filter_label = "find_packet(" .. string.format("%q", Name) .. ", " .. string.format("%q", Method) .. ")." .. Method
			local done = pcall(function()
				local old
				old = X.hook_function(target, X.new_c_closure(function(...)
					local from_executor = X.check_caller()
					if shared.PacketsOn and not shared.PacketBusy and active and not paused and (not from_executor or Settings.Executor) then
						shared.PacketBusy = true
						pcall(function(...)
							local label = (Settings.BufferCodeMode == "filtergc" or not require_label) and filter_label or require_label
							push(label, label, "lib", X.get_calling_script(), nil, select("#", ...), ...)
						end, ...)
						shared.PacketBusy = false
					end

					if shared.PacketsOn and active and (blocked[require_label or filter_label] == true or blocked[filter_label] == true) and UI.block_applies(from_executor) then
						return
					end

					return old(...)
				end))

				if require_label then
					UI.packet_senders[require_label] = old
				end

				UI.packet_senders[filter_label] = old
			end)

			if done then
				UI.packet_hooked[target] = true
				added += 1
			end
		end
	end

	return added
end

UI.hook_packets_gc = function()
	local gc_fn = getgc
	if type(gc_fn) ~= "function" then
		return 0
	end

	local ok_gc, gc = pcall(gc_fn, true)
	if not ok_gc or type(gc) ~= "table" then
		return 0
	end

	local count, loose = 0, { }
	for _, holder in gc do
		if type(holder) == "table" then
			-- namespace result: { packets = { Name = packet }, queries = { Name = packet } }
			local ok_p, packs = pcall(rawget, holder, "packets")
			if ok_p and type(packs) == "table" then
				for Name, packet in packs do
					if type(Name) == "string" and type(packet) == "table" then
						count += UI.hook_one_packet(Name, packet, nil, nil)
					end
				end

				local ok_q, queries = pcall(rawget, holder, "queries")
				if ok_q and type(queries) == "table" then
					for Name, packet in queries do
						if type(Name) == "string" and type(packet) == "table" then
							count += UI.hook_one_packet(Name, packet, nil, nil)
						end
					end
				end
			else
				-- loose ByteNet packet table (send + reliabilityType + value)
				local ok_s, send = pcall(rawget, holder, "send")
				local ok_r, rel = pcall(rawget, holder, "reliabilityType")
				if ok_s and ok_r and type(send) == "function" and rel ~= nil and not UI.packet_hooked[send] then
					table.insert(loose, holder)
				end
			end
		end
	end

	for position, packet in loose do
		count += UI.hook_one_packet("packet_" .. position, packet, nil, nil)
	end

	return count
end

UI.set_packets = function()
	if not Settings.HookPackets then
		shared.PacketsOn = false
		return
	end

	shared.PacketsOn = true
	if not X.hook_function then
		set_status("couldn't hook the packets (needs hookfunction)")
		return
	end

	local from_modules, from_gc = 0, 0
	UI.auto_cache = nil
	UI.auto_errors = nil
	local ok, index = pcall(UI.auto_index)
	if ok and index then
		for _, entry in index.List do
			from_modules += UI.hook_one_packet(entry.Name, entry.Packet, entry.Path, entry.Via)
		end

		if #index.List == 0 then
			UI.auto_cache = nil
		end
	end

	local ok_gc, gc_count = pcall(UI.hook_packets_gc)
	from_gc = ok_gc and gc_count or 0
	shared.PacketsHooked = true

	local note = "packets: hooked " .. (from_modules + from_gc) .. " (" .. from_modules .. " from modules, " .. from_gc .. " from gc)"
	if not ok then
		note ..= "  |  module scan failed: " .. tostring(index)
	elseif UI.auto_errors and #UI.auto_errors > 0 then
		note ..= "  |  " .. #UI.auto_errors .. " packet(s) skipped: " .. UI.auto_errors[1]
	end

	set_status(note)

	if not UI.packet_rescan then
		UI.packet_rescan = true
		task.spawn(function()
			while active do
