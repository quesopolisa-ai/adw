UI.touch_name_match = function(other)
	local names = { }
	local current = other
	for _ = 1, 4 do
		if not current or current == workspace or current == game then
			break
		end

		table.insert(names, string.lower(current.Name))
		current = current.Parent
	end

	for piece in string.gmatch(Settings.TouchNames, "[^,]+") do
		piece = string.lower(string.match(piece, "^%s*(.-)%s*$"))
		if piece ~= "" then
			for _, Name in names do
				local ok, found = pcall(string.find, Name, piece)
				if ok and found then
					return true
				end
			end
		end
	end

	return false
end

UI.log_touch = function(character, other, part)
	if not active or paused or replaying or not Settings.Touches or typeof(other) ~= "Instance" or not other.IsA(other, "BasePart") or other.IsA(other, "Terrain") then
		return
	end

	if other.IsDescendantOf(other, character) then
		return
	end

	local wired = false
	pcall(function()
		wired = other.FindFirstChild(other, "TouchInterest") ~= nil or other.FindFirstChildOfClass(other, "TouchTransmitter") ~= nil
	end)

	local tool_wired = false
	if Settings.ToolTouches and part then
		pcall(function()
			tool_wired = part.FindFirstAncestorOfClass(part, "Tool") ~= nil and (part.FindFirstChild(part, "TouchInterest") ~= nil or part.FindFirstChildOfClass(part, "TouchTransmitter") ~= nil)
		end)
	end

	if tool_wired and Settings.ToolOnlyWired and not wired then
		tool_wired = false
	end

	if not wired and not tool_wired and not Settings.TouchAll and not UI.touch_name_match(other) then
		return
	end

	local Now = os.clock()
	if Now - (click_fired[other] or 0) < 0.3 or Now - (UI.touch_seen[other] or 0) < 0.25 or ignored[other] or name_ignored(other.Name) then
		return
	end

	UI.touch_seen[other] = Now
	push(other, "firetouchinterest", "touch", nil, nil, 2, part, 0)
end

UI.watch_touch = function(character, part)
	if UI.touch_watched[part] or not part.IsA(part, "BasePart") then
		return
	end

	UI.touch_watched[part] = true
	Connect(part.Touched, function(other)
		UI.log_touch(character, other, part)
	end)
end

UI.watch_tool = function(Tool)
	if UI.tool_watched[Tool] or not Tool.IsA(Tool, "Tool") then
		return
	end

	UI.tool_watched[Tool] = true
	for signal, Method in {Activated = "Activate", Deactivated = "Deactivate"} do
		Connect(Tool[signal], function()
			if not active or paused or replaying or not Settings.Tools or ignored[Tool] or name_ignored(Tool.Name) then
				return
			end

			local Now = os.clock()
			if Now - (UI.tool_fired[Tool] or 0) < 0.3 then
				return
			end

			push(Tool, Method, "tool", nil, nil, 0)
		end)
	end

	for signal, Method in {Equipped = "Equipped", Unequipped = "Unequipped"} do
		Connect(Tool[signal], function()
			if not active or paused or replaying or not Settings.Tools or ignored[Tool] or name_ignored(Tool.Name) then
				return
			end

			push(Tool, Method, "tool", nil, nil, 0)
		end)
	end
end

UI.watch_tools = function(container)
