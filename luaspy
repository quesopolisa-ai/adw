UI.install_lib = function(lib_name)
	local Lib = lib_name == "buffer" and buffer or (lib_name == "table" and table or nil)
	if shared.Installed["Lib" .. lib_name] then
		return true
	end

	if not X.hook_function or type(Lib) ~= "table" then
		return false
	end

	local names = { }
	for Name, member in next, Lib do
		if type(Name) == "string" and type(member) == "function" and Name ~= "create" and not (env.__LarpUseOth and UI.lib_spy_uses[Name] and lib_name == "table") then
			names[#names + 1] = Name
		end
	end

	local hooked = 0
	for _, Name in names do
		local label = lib_name .. "." .. Name
		local ok = pcall(function()
			local old
			old = X.hook_function(Lib[Name], X.new_c_closure(function(...)
				if shared.LibBusy or not shared.LibOn then
					return old(...)
				end

				if (shared.LibBudget or 1) > 0 then
					pcall(shared.capture_lib, label, ...)
				end

				if shared.LibBlockOn and ((shared.LibBlockAll[lib_name] and not (env.__LarpUseOth and UI.lib_spy_uses[Name])) or shared.LibBlocked[label]) and not X.check_caller() then
					return UI.lib_fake(label, ...)
				end

				return old(...)
			end))
		end)

		if ok then
			hooked += 1
		end
	end

	shared.Installed["Lib" .. lib_name] = hooked > 0
	return hooked > 0
end

