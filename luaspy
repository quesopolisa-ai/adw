				end
			end,
		})
	end

	if answer == "never" then
		Settings.AskAdonis = false
		save_settings()
	elseif answer == "load" then
		local source = nil
		env.__LarpHttpSelf = true
		local done = pcall(function()
			source = game.HttpGet(game, "https://raw.githubusercontent.com/nfpw/LarpSpy/refs/heads/main/ab.lua")
		end)

		env.__LarpHttpSelf = false
		if not done or type(source) ~= "string" or #source == 0 then
			UI.adonis_status = "adonis bypass: download failed"
		elseif not loadstring then
			UI.adonis_status = "adonis bypass: no loadstring in this executor"
		else
			local compiled, compile_error = loadstring(source)
			if not compiled then
				UI.adonis_status = "adonis bypass: compile error " .. tostring(compile_error)
			else
				local ok, run_error = pcall(compiled)
				if ok then
					env.__LarpAdonisLoaded = true
					UI.adonis_status = "adonis bypass loaded"
					task.wait(1)
				else
					UI.adonis_status = "adonis bypass error: " .. tostring(run_error)
