UI.fire_all = function(kind, remote, Value)
	if not channel or typeof(remote) ~= "Instance" then
		return
	end

	local pushed = 0
	for _, Id in UI.remote_ids(remote) do
		pcall(function() channel.Fire(channel, kind, Id, Value) end)
		local literal = type(Value) == "string" and string.format("%q", Value) or tostring(Value)
		local source = "local G = (getgenv and getgenv()) or _G local S = G.__LarpSpyActor if S and S.Apply then S.Apply(" .. string.format("%q", kind) .. ", " .. string.format("%q", Id) .. ", " .. literal .. ") end"
		for _, run in UI.injected or { } do
			if type(run) == "function" and pcall(run, source) then
				pushed += 1
			end
		end
	end

	if pushed > 0 then
		set_status("sent " .. kind .. " to " .. pushed .. " actor hook(s)")
	end
end

local function send_override(remote)
	if not channel then
		return
	end

	local json = nil
	local spec = overrides[remote]
	if spec then
		local list = { }
		for index, item in spec do
			table.insert(list, {i = index, v = item.Value, n = item.Value == nil or nil})
		end

		local ok, encoded = pcall(function() return http_service.JSONEncode(http_service, list) end)
		if not ok then
			set_status("this hook value can't be sent to actors (only text, numbers, booleans and plain tables)")
		end

		json = ok and encoded or nil
	end

	UI.fire_all("override", remote, json)
end

