function UI.base64(Data)
	local alphabet = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	local lookup, out = { }, { }
	for index = 1, 64 do
		lookup[string.byte(alphabet, index)] = index - 1
	end

	for index = 1, #Data, 4 do
		local A, B, C, d = string.byte(Data, index, index + 3)
		local number = bit32.lshift(lookup[A], 18) + bit32.lshift(lookup[B], 12) + bit32.lshift(lookup[C] or 0, 6) + (lookup[d] or 0)
		local bytes = string.char(bit32.band(bit32.rshift(number, 16), 255), bit32.band(bit32.rshift(number, 8), 255), bit32.band(number, 255))
		if not lookup[C] then
			bytes = string.sub(bytes, 1, 1)
		elseif not lookup[d] then
			bytes = string.sub(bytes, 1, 2)
		end

		table.insert(out, bytes)
	end

	return table.concat(out)
end

