shared.capture_debug_info = function(results, ...)
	if shared.DebugInside or not active or not Settings.DebugCalls then
		return
	end

	if X.check_caller() and not Settings.Executor then
		return
	end

	shared.DebugInside = true
	local count = select("#", ...)
	local args = table.pack(...)
	local spoof
	pcall(function()
		local script = X.get_calling_script()
		local Info = __R.caller_info()
		if Settings.DebugStack and not paused then
			local ok_stack, stack = pcall(__R.full_stack, 25)
			if ok_stack and type(stack) == "table" and #stack > 0 then
				local top = stack[1]
				Info = Info or {Source = top.Source, Line = top.Line, Name = top.Name, Params = top.Params, Vararg = top.Vararg}
				Info.Stack = stack
			end
		end

		local ok_name, script_name = pcall(function() return script.Name end)
		local ok_path, script_path = pcall(function() return script.GetFullName(script) end)
		local where = (ok_name and script_name) or (Info and string.match(tostring(Info.Source), "[^%.]+$")) or "unknown"
		local path = tostring((ok_path and script_path) or (Info and Info.Source) or "unknown")
		local group = Settings.DebugGroup
		local key, label = "debug.info", nil
		if group ~= "all" then
			label = where
			key = "debug.info|" .. path
			if group == "caller" and Info then
				label = where .. "." .. (Info.Name or "?") .. ":" .. tostring(Info.Line)
				key = key .. "|" .. (Info.Name or "?") .. ":" .. tostring(Info.Line)
			end
		end

		local Mode = Settings.DebugBlock
		local block = blocked[key] == true
		if not block and Mode ~= "off" then
			block = true
			if (Settings.DebugOnly or "") ~= "" then
				block = false
				for piece in string.gmatch(Settings.DebugOnly, "[^,]+") do
					piece = string.match(piece, "^%s*(.-)%s*$")
					if piece ~= "" and string.find(path, piece) then
						block = true
						break
					end
				end
			end
		end

		if block then
			spoof = debug_spoof(Mode == "off" and "nothing" or Mode)
		end

		if not paused and not ignored[key] and not name_ignored("debug.info") then
			local before = #queue
			push(key, "info", "debuginfo", script, nil, count, table.unpack(args, 1, count))
			if Settings.DebugStack and Info and #queue > before then
				queue[#queue].Info = Info
			end

			queue[#queue].Result = results
			queue[#queue].Label = label
			queue[#queue].Spoofed = spoof ~= nil
		end
	end)

	shared.DebugInside = false
	return spoof
end end

shared.capture_signal = function(Name, signal, ...)
	if not active or replaying then
		return false
	end

	local block_all = (Name == "firesignal" and Settings.BlockFireSignals) or (Name == "replicatesignal" and Settings.BlockReplicateSignals) or false
	if not block_all and (paused or (Name == "firesignal" and not Settings.FireSignals) or (Name == "replicatesignal" and not Settings.ReplicateSignals)) then
		return false
	end

	if typeof(signal) ~= "RBXScriptSignal" then
		return false
	end

	local key = tostring(signal)
	local Event = string.match(key, "^Signal (.+)$") or key
	if paused or not ((Name == "firesignal" and Settings.FireSignals) or (Name == "replicatesignal" and Settings.ReplicateSignals)) or ignored[key] or name_ignored(Event) then
		return blocked[key] == true or blocked_names[Event] == true or block_all == true
	end

	push(key, Name, Name, X.get_calling_script(), nil, select("#", ...), ...)
	local Log = queue[#queue]
	Log.Signal = signal
	Log.EventName = Event
	return blocked[key] == true or blocked_names[Event] == true or block_all == true
end

shared.capture_connect = function(Method, signal, callback, existing)
	if not active or replaying or typeof(signal) ~= "RBXScriptSignal" then
		return false
	end

	local key = tostring(signal)
	local Event = string.match(key, "^Signal (.+)$") or key
	local reader = UI.log_events[Event] == true
	if not Settings.Connections and not (reader and (Settings.LogReaders or Settings.BlockLogReaders)) then
		return false
	end

	if UI.own_callbacks[callback] then
		return false
	end

	local from_executor = (not existing) and X.check_caller() or false
	local block = (reader and not existing and Settings.BlockLogReaders and UI.block_applies(from_executor)) or false
	local wanted = (Settings.Connections or (reader and Settings.LogReaders)) and not paused and not (from_executor and not Settings.Executor)
	if wanted then
		local Info = nil
		if type(callback) == "function" then
			local ok, source, line, Name, params, vararg = pcall(raw_debug_info or debug.info, callback, "slna")
			if ok and source then
				Info = {Source = source, Line = line, Name = (Name and Name ~= "") and Name or nil, Params = params, Vararg = vararg}
			end
		end

		local row = Info and (key .. "|" .. tostring(Info.Source) .. ":" .. tostring(Info.Line)) or key
		if not (ignored[key] or ignored[row] or name_ignored(Event)) then
			local script = nil
			if not existing then
				script = X.get_calling_script()
			end

			push(row, Method, "connection", script, nil, 1, callback)
			local Log = queue[#queue]
			Log.Signal = signal
			Log.EventName = Event
			Log.Info = Info
		end
	end

	if block then
		task.defer(function() shared.notify("blocked a " .. Event .. " connection") end)
	end

	return block
end

shared.capture_proximity = function(Prompt, ...)
	if not active or replaying or not (Settings.Prompts or Settings.BlockPrompts) or typeof(Prompt) ~= "Instance" then
		return false
	end

	__R.prompt_fired[Prompt] = os.clock()
	if Settings.Prompts and not paused and not ignored[Prompt] and not name_ignored(Prompt.Name) then
		push(Prompt, "fireproximityprompt", "prompt", X.get_calling_script(), nil, select("#", ...), ...)
	end

	return blocked[Prompt] == true or blocked_names[Prompt.Name] == true or Settings.BlockPrompts == true
end

shared.capture_http = function(Method, Self, ...)
	if not active or env.__LarpHttpSelf or not (Settings.Http or Settings.BlockHttp) then
		return false
	end

	local A = ...
	local Url, http_method
	if Method == "request" or Method == "RequestAsync" then
		if type(A) ~= "table" then
			return false
		end

		Url = A.Url or A.url or A.URL
		http_method = string.upper(tostring(A.Method or A.method or "GET"))
	else
		Url = A
		http_method = string.find(Method, "Post") and "POST" or "GET"
	end

	local key = http_method .. " " .. tostring(Url)
	local from_executor = X.check_caller()
	local Now = os.clock()
	if UI.last_http and UI.last_http[1] == key and Now - UI.last_http[2] < 0.02 then
		return false
	end

	UI.last_http = {key, Now}
	local block = (blocked[key] == true and not from_executor) or (Settings.BlockHttp and UI.block_applies(from_executor)) or false
	if paused or not Settings.Http or ignored[key] or name_ignored(tostring(Url)) then
		return block
	end

	push(key, Method, "http", (not from_executor) and X.get_calling_script() or nil, nil, select("#", ...), ...)
	local Log = queue[#queue]
	if Log and Log.Remote == key and not Log.Label then
		Log.Label = key
		Log.Url = tostring(Url)
		Log.Executor = from_executor
	end

	return block
end

shared.capture_exec = function(kind, Name, target, ...)
	if not active or replaying or typeof(target) ~= "Instance" then
		return false
	end

	if (kind == "touch" and not (Settings.Touches or Settings.BlockTouchCalls)) or (kind == "click" and not (Settings.Clicks or Settings.BlockClickCalls)) then
		return false
	end

	if kind == "click" or kind == "touch" then
		click_fired[target] = os.clock()
	end

	if ((kind == "touch" and Settings.Touches) or (kind == "click" and Settings.Clicks)) and not paused and not ignored[target] and not name_ignored(target.Name) then
		push(target, Name, kind, X.get_calling_script(), nil, select("#", ...), ...)
	end

	return blocked[target] == true or blocked_names[target.Name] == true or (kind == "touch" and Settings.BlockTouchCalls == true) or (kind == "click" and Settings.BlockClickCalls == true)
end

