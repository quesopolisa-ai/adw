		table.insert(lines, "")
		table.insert(lines, "\t\tif index > args.n then")
		table.insert(lines, "\t\t\targs.n = index")
		table.insert(lines, "\t\tend")
		table.insert(lines, "\tend")
		table.insert(lines, "")
		table.insert(lines, "\treturn table.unpack(args, 1, args.n)")
		table.insert(lines, "end")
		table.insert(lines, "")
		table.insert(lines, "local old")
		table.insert(lines, "old = hookmetamethod(game, \"__namecall\", newcclosure(function(self, ...)")
		table.insert(lines, "\tif self == remote and getnamecallmethod() == method and not checkcaller() then")
		table.insert(lines, "\t\tif setnamecallmethod then")
		table.insert(lines, "\t\t\tsetnamecallmethod(method)")
		table.insert(lines, "\t\tend")
		table.insert(lines, "")
		table.insert(lines, "\t\treturn old(self, apply(...))")
		table.insert(lines, "\tend")
		table.insert(lines, "")
		table.insert(lines, "\treturn old(self, ...)")
		table.insert(lines, "end))")
		table.insert(lines, "")
		table.insert(lines, "-- Remote.FireServer(Remote, ...) style calls")
		table.insert(lines, "local direct")
		table.insert(lines, "direct = hookfunction(remote[method], newcclosure(function(self, ...)")
		table.insert(lines, "\tif self == remote and not checkcaller() then")
		table.insert(lines, "\t\treturn direct(self, apply(...))")
		table.insert(lines, "\tend")
		table.insert(lines, "")
		table.insert(lines, "\treturn direct(self, ...)")
		table.insert(lines, "end))")
	else
		table.insert(lines, "local old")
		table.insert(lines, "old = hookmetamethod(game, \"__namecall\", newcclosure(function(self, ...)")
		table.insert(lines, "\tif self == remote and getnamecallmethod() == method and not checkcaller() then")
		table.insert(lines, "\t\treturn")
		table.insert(lines, "\tend")
		table.insert(lines, "")
		table.insert(lines, "\treturn old(self, ...)")
		table.insert(lines, "end))")
		table.insert(lines, "")
		table.insert(lines, "-- Remote.FireServer(Remote, ...) style calls")
		table.insert(lines, "local direct")
		table.insert(lines, "direct = hookfunction(remote[method], newcclosure(function(self, ...)")
		table.insert(lines, "\tif self == remote and not checkcaller() then")
		table.insert(lines, "\t\treturn")
		table.insert(lines, "\tend")
		table.insert(lines, "")
		table.insert(lines, "\treturn direct(self, ...)")
		table.insert(lines, "end))")
	end

	copy(UI.tidy(table.concat(lines, "\n")))
	set_status(with_args and "copied hooked arguments code" or "copied block code")
end

UI.copy_oth_hook = function(Log)
	local remote = Log.Remote
	if typeof(remote) ~= "Instance" then
		set_status("oth.hook code is only made for calls on an instance")
		return
	end

	if not (oth and oth.hook) then
		set_status("this executor has no oth.hook (the code is copied anyway)")
	end

	local current = overrides[remote]
	local with_args = current ~= nil and next(current) ~= nil
	local lines = {
		"-- oth.hook " .. (with_args and "hooked arguments" or "block") .. ": " .. display_name(Log) .. " (generated by Larp Spy)",
		"local remote = " .. display_path(Log),
		'local method = "' .. Log.Method .. '"',
		"",
	}

	if with_args then
		local indexes = { }
		for index in current do
			table.insert(indexes, index)
		end

		table.sort(indexes)
		table.insert(lines, "local overrides = {")
		for _, index in indexes do
			local ok, code = pcall(serialize, current[index].Value)
			table.insert(lines, "\t[" .. index .. "] = " .. (ok and code or "nil") .. ",")
		end

		table.insert(lines, "}")
		table.insert(lines, "")
		table.insert(lines, "local function apply(...)")
		table.insert(lines, "\tlocal args = table.pack(...)")
		table.insert(lines, "")
		table.insert(lines, "\tfor index, value in overrides do")
		table.insert(lines, "\t\targs[index] = value")
		table.insert(lines, "")
		table.insert(lines, "\t\tif index > args.n then")
		table.insert(lines, "\t\t\targs.n = index")
		table.insert(lines, "\t\tend")
		table.insert(lines, "\tend")
		table.insert(lines, "")
		table.insert(lines, "\treturn table.unpack(args, 1, args.n)")
		table.insert(lines, "end")
		table.insert(lines, "")
	end

	table.insert(lines, "-- Remote:" .. Log.Method .. "(...) style calls")
	table.insert(lines, "local namecall = getrawmetatable(game).__namecall")
	table.insert(lines, "local old_namecall")
	table.insert(lines, "old_namecall = oth.hook(namecall, function(self, ...)")
	table.insert(lines, "\tif self == remote and getnamecallmethod() == method and not checkcaller() then")
	if with_args then
		table.insert(lines, "\t\tsetnamecallmethod(method)")
		table.insert(lines, "")
		table.insert(lines, "\t\treturn old_namecall(self, apply(...))")
	else
		table.insert(lines, "\t\treturn")
	end

	table.insert(lines, "\tend")
	table.insert(lines, "")
	table.insert(lines, "\treturn old_namecall(self, ...)")
	table.insert(lines, "end)")
	table.insert(lines, "")
	table.insert(lines, "-- Remote." .. Log.Method .. "(Remote, ...) style calls")
	table.insert(lines, "local method_function = remote[method]")
	table.insert(lines, "local old_direct")
	table.insert(lines, "old_direct = oth.hook(method_function, function(self, ...)")
	table.insert(lines, "\tif self == remote and not checkcaller() then")
	if with_args then
		table.insert(lines, "\t\treturn old_direct(self, apply(...))")
	else
		table.insert(lines, "\t\treturn")
	end

	table.insert(lines, "\tend")
	table.insert(lines, "")
	table.insert(lines, "\treturn old_direct(self, ...)")
	table.insert(lines, "end)")
	table.insert(lines, "")
	table.insert(lines, "-- to remove the hooks again:")
	table.insert(lines, "-- oth.unhook(namecall)")
	table.insert(lines, "-- oth.unhook(method_function)")
	copy(UI.tidy(table.concat(lines, "\n")))
	set_status(with_args and "copied oth.hook arguments code" or "copied oth.hook block code")
end

