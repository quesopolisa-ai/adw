function __R.kind_of(class, Method, object)
	if Method == "FireServer" or Method == "fireServer" then
		if class == "RemoteEvent" then
			return (Settings.Events or Settings.BlockEvents or UI.crash_wants()) and "event"
		elseif class == "UnreliableRemoteEvent" then
			return (Settings.Unreliable or Settings.BlockUnreliable or UI.crash_wants()) and "unreliable"
		end
	elseif Method == "InvokeServer" or Method == "invokeServer" then
		return class == "RemoteFunction" and (Settings.Functions or Settings.BlockFunctions or UI.crash_wants()) and "function"
	elseif Method == "Fire" then
		return class == "BindableEvent" and (Settings.Bindables or Settings.BlockBindables) and "bindable"
	elseif Method == "Invoke" then
		return class == "BindableFunction" and (Settings.Bindables or Settings.BlockBindables) and "bindable"
	elseif Method == "SendMessage" then
		return class == "Actor" and (Settings.ActorMessages or Settings.BlockActorMessages) and "actormsg"
	elseif Method == "Activate" or Method == "Deactivate" then
		return class == "Tool" and (Settings.Tools or Settings.BlockTools) and "tool"
	elseif Method == "EquipTool" or Method == "UnequipTools" then
		return class == "Humanoid" and (Settings.Tools or Settings.BlockTools) and "tool"
	elseif Method == "GetAttribute" then
		return (Settings.GetAttributes or Settings.BlockGetAttributes) and "getattr"
	elseif Method == "SetAttribute" then
		return (Settings.SetAttributes or Settings.BlockSetAttributes) and "setattr"
	elseif Method == "Play" then
		return class == "Sound" and (Settings.Sounds or Settings.BlockSounds) and "sound"
	elseif Method == "Kick" or Method == "kick" then
		return class == "Player" and object == players.LocalPlayer and Settings.Kicks and "kick"
	elseif Method == "SetCore" or Method == "SetCoreGuiEnabled" then
		return class == "StarterGui" and Settings.CoreState and "corestate"
	elseif Method == "GetLogHistory" then
		return class == "LogService" and (Settings.LogHistory or Settings.BlockLogHistory) and "loghistory"
	elseif Method == "Shutdown" then
		return class == "DataModel" and Settings.Shutdowns and "shutdown"
	elseif purchase_methods[Method] then
		return class == "MarketplaceService" and (Settings.Purchases or Settings.BlockPurchases or Settings.OwnsSpoof ~= "off") and "purchase"
	elseif teleport_methods[Method] then
		return class == "TeleportService" and Settings.Teleports and "teleport"
	elseif Method == "require" then
		return class == "ModuleScript" and Settings.Require and "require"
	end

	return nil
end

