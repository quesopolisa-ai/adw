UI.anim_stop_all = function()
	local count = 0
	for Id, track in UI.anim_tracks do
		UI.anim_tracks[Id] = nil
		pcall(function() track.stop(track) end)
		count += 1
	end

	local character = players.LocalPlayer.Character
	local humanoid = character and character.FindFirstChildOfClass(character, "Humanoid")
	local animator = humanoid and humanoid.FindFirstChildOfClass(humanoid, "Animator")
	if animator then
		local ok, tracks = pcall(function() return animator.GetPlayingAnimationTracks(animator) end)
		for _, track in ok and tracks or { } do
			pcall(function() track.stop(track) end)
			count += 1
		end
	end

	UI.anim_dirty, UI.game_anim_dirty = true, true
	return "stopped " .. count .. " animations"
end

UI.anim_play = function(Id)
	local old = UI.anim_tracks[Id]
	if old then
		UI.anim_tracks[Id] = nil
		pcall(function() old.stop(old) end)
		return "stopped " .. Id
	end

	local character = players.LocalPlayer.Character
	local humanoid = character and character.FindFirstChildOfClass(character, "Humanoid")
	local loader = humanoid and (humanoid.FindFirstChildOfClass(humanoid, "Animator") or humanoid)
	if not loader then
		return "no character to play it on"
	end

	local animation = Instance.new("Animation")
	animation.AnimationId = Id
	local ok, track = pcall(function() return loader.LoadAnimation(loader, animation) end)
	if not ok or not track then
		return "couldn't load " .. Id
	end

	if not pcall(function() track.Priority = Enum.AnimationPriority.Action4 end) then
		pcall(function() track.Priority = Enum.AnimationPriority.action end)
	end

	local play_ok, play_err = pcall(function() track.Play(track) end)
	if not play_ok then
		return "play error: " .. tostring(play_err)
	end

	local waited = 0
	while track.Length == 0 and waited < 2 do
		task.wait(0.1)
		waited += 0.1
	end

	if track.Length == 0 then
		pcall(function() track.stop(track) end)
		return "Roblox won't play " .. Id .. " (track never loaded - not allowed to use this animation, or it isn't an animation)"
	end

	UI.anim_tracks[Id] = track
	Connect(track.Stopped, function()
		if UI.anim_tracks[Id] == track then
			UI.anim_tracks[Id] = nil
			UI.anim_dirty = true
		end
	end)

	return "playing " .. Id .. string.format(" (%.2fs)", track.Length)
end

UI.upvalue_spy = function(Name)
	Name = tostring(Name or "")
	local get = getupvalues or (debug and debug.getupvalues)
	if Name == "" then
		return "type the name of the function first"
	end

	if not (X.hook_function and get and filtergc) then
		return "needs hookfunction, getupvalues and filtergc"
	end

	local ok, found = pcall(filtergc, "function", {Name = Name, IgnoreExecutor = true}, false)
	if not ok or type(found) ~= "table" or #found == 0 then
		return "no game function named " .. Name
	end

	local state = UI.upvalue
	local hooks, watching = 0, 0
	state.On = true
	for fn_index, fn in found do
		if fn_index > 15 then
			break
		end

		local got, ups = pcall(get, fn)
		for index, up in got and type(ups) == "table" and ups or { } do
			local label = "upvalue_" .. string.gsub(Name, "[^%w_]", "_") .. "_" .. index
			if type(up) == "function" then
				local is_executor = false
				pcall(function() is_executor = isexecutorclosure and isexecutorclosure(up) or false end)
				if not state.Hooked[up] and not is_executor and not X.is_c(up) then
					state.Hooked[up] = true
					local called = label .. "_" .. (debug.info(up, "n") ~= "" and debug.info(up, "n") or "anonymous")
					local old
					local done = pcall(function()
						old = X.hook_function(up, X.new_c_closure(function(...)
							if state.On and active and not paused and not state.Busy and not X.check_caller() then
								state.Busy = true
								pcall(function(...)
									push(called, called, "lib", X.get_calling_script(), nil, select("#", ...), ...)
								end, ...)
								state.Busy = false
							end

							return old(...)
						end))
					end)

					if done then
						hooks += 1
					else
						state.Hooked[up] = nil
					end
				end
			elseif type(up) ~= "table" and type(up) ~= "userdata" or typeof(up) == "Instance" then
				if watching < 80 and not state.Watched[fn] then
					state.Watched[fn] = state.Watched[fn] or { }
				end

				if watching < 80 and state.Watched[fn] and state.Watched[fn][index] == nil then
					state.Watched[fn][index] = {Last = up, Label = label .. "_changed"}
					watching += 1
				end
			end
		end
	end

	if not state.Polling then
		state.Polling = true
		task.spawn(function()
			while active do
				task.wait(0.25)
				if state.On and not paused then
					for fn, slots in state.Watched do
						local got, ups = pcall(get, fn)
						if got and type(ups) == "table" then
							for index, slot in slots do
								local Value = ups[index]
								if not rawequal(Value, slot.Last) then
									local before = slot.Last
									slot.Last = Value
									pcall(push, slot.Label, slot.Label, "lib", nil, nil, 2, before, Value)
								end
							end
						end
					end
				end
			end
		end)
	end

	return "upvalue spy: " .. hooks .. " functions hooked, " .. watching .. " values watched (" .. math.min(#found, 15) .. " functions named " .. Name .. ")"
end

