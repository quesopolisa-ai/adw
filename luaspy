		end

		if kind == "applied" then
			if typeof(remote) == "Instance" then
				set_status("argument hook applied in " .. tostring(Method) .. ": " .. name_of(remote))
			end

			return
		end

		if kind ~= "call" or not active or paused or typeof(remote) ~= "Instance" then
