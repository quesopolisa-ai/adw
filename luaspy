		local same, mine = 0, 0
		for _, other in Parent.GetChildren(Parent) do
			if other.Name == Name then
				same += 1
				if other == remote then
					mine = same
				end
			end
		end

		return same > 1 and mine > 0 and ("#" .. mine) or nil
	end)

	return ok and tag or nil
end

