UI.attr_allowed_slow = function(inst, want)
	local ok, hit = pcall(function()
		local Local = players.LocalPlayer
		local Char = Local and Local.Character
		local class = inst.ClassName
		local is_player = class == "Player"
		if want.LocalPlayer and is_player and inst.UserId == Local.UserId then
			return true
		end

		if want.Character and Char and (inst == Char or inst.IsDescendantOf(inst, Char)) then
			return true
		end

		if want.Workspace and class == "Workspace" then
			return true
		end

		if want.Humanoid and class == "Humanoid" then
			return true
		end

		if want.Tool and (class == "Tool" or inst.FindFirstAncestorOfClass(inst, "Tool")) then
			return true
		end

		if want.PlayerGui and Local and (class == "PlayerGui" or inst.IsDescendantOf(inst, Local.FindFirstChildOfClass(Local, "PlayerGui") or Local)) and class ~= "Player" then
			return true
		end

		if want.ReplicatedStorage and (class == "ReplicatedStorage" or inst.FindFirstAncestorOfClass(inst, "ReplicatedStorage")) then
			return true
		end

		if want["Other players"] then
			if is_player and inst.UserId ~= Local.UserId then
				return true
			end

			local model = class == "Model" and inst or inst.FindFirstAncestorOfClass(inst, "Model")
			local owner = model and players.GetPlayerFromCharacter(players, model)
			if owner and owner.UserId ~= Local.UserId then
				return true
			end
		end

		return false
	end)

	return ok and hit == true
end

shared.Capture = function(self, Method, direct, ...)
	if Method == "require" then
		shared.capture_require(self, nil)
		return false
	end

	if UI.http_methods[Method] and typeof(self) == "Instance" then
		if active and (Settings.Http or Settings.BlockHttp) and self.ClassName == UI.http_methods[Method] then
			local ok, block = pcall(shared.capture_http, Method, self, ...)
			return ok and block == true, nil
		end

		return false
	end

	if not active or typeof(self) ~= "Instance" or self_ignore[self] then
		return false
	end

	local kind = __R.kind_of(self.ClassName, Method, self)
	if not kind then
		return false
	end

	if (kind == "getattr" or kind == "setattr") and UI.attr_busy then
		return false
	end

	if direct and not Settings.Direct then
		return false
	end

	local core_disables = false
	if kind == "corestate" then
		local relevant
		relevant, core_disables = UI.core_state_info(Method, ...)
		if not relevant then
			return false
		end
	end

	local from_executor = X.check_caller()
	local exec_block = from_executor and (kind == "kick" or kind == "shutdown") and Settings.BlockSource ~= "game"
	if from_executor and not Settings.Executor and not exec_block then
		return false
	end

	if (kind == "getattr" or kind == "setattr") and not UI.attr_allowed(self) then
		return false
	end

	local replace = nil
	local spec = overrides[self]
	if spec and blocked[self] ~= true and not from_executor and (kind == "event" or kind == "unreliable" or kind == "function" or kind == "bindable" or (kind == "purchase" and UI.purchase_hook_method and UI.purchase_hook_method[self] == Method)) then
		replace = table.pack(...)
		for index, item in spec do
			replace[index] = item.Value
			if index > replace.n then
				replace.n = index
			end
		end
	end

	if kind == "tool" and UI.tool_fired then
		UI.tool_fired[self] = os.clock()
	end

	if not paused and not ignored[self] and not name_ignored(self.Name) and (not from_executor or Settings.Executor) and (UI.kind_log_key[kind] == nil or Settings[UI.kind_log_key[kind]] == true) then
		push(self, Method, kind, X.get_calling_script(), nil, select("#", ...), ...)
	end

	local crash_state = UI.crash
	if crash_state.Ready and UI.crash_detect() and (kind == "event" or kind == "unreliable" or kind == "function") then
		crash_state.safe(crash_state.record, self, "out", ...)
	end

	local block = blocked[self] == true or blocked_names[self.Name] == true or (crash_state.Ready and crash_state.ArgBlocks[self] ~= nil and crash_state.arg_blocked(self, select("#", ...), ...)) or false
	if not block and UI.kind_block_key[kind] and Settings[UI.kind_block_key[kind]] == true then
		block = true
	end

	if kind == "kick" then
		block = Settings.BlockKicks and UI.block_applies(from_executor)
		if block then
			task.defer(function() shared.notify("blocked a kick") end)
		end
	elseif kind == "corestate" then
		block = Settings.BlockCoreState and core_disables
		if block then
			task.defer(function() shared.notify("blocked reset / inventory being disabled") end)
		end
	elseif kind == "shutdown" then
		block = Settings.BlockShutdowns and UI.block_applies(from_executor)
		if block then
			task.defer(function() shared.notify("blocked a game shutdown") end)
		end
	elseif kind == "teleport" then
		block = Settings.BlockTeleports
		if block then
			task.defer(function() shared.notify("blocked a teleport") end)
		end
	elseif kind == "purchase" then
		if Method == "UserOwnsGamePassAsync" or Method == "PlayerOwnsAsset" then
			block = Settings.OwnsSpoof ~= "off"
			if block then
				task.defer(function() shared.notify(Method .. " spoofed to " .. Settings.OwnsSpoof) end)
			end
		else
			block = Settings.BlockPurchases == true and string.find(Method, "^Signal") ~= nil
			if block then
				task.defer(function() shared.notify("blocked " .. Method) end)
			end
		end
	elseif kind == "require" then
		block = false
	end

	if replace and not block then
		local Name = self.Name
		task.defer(function() shared.notify("argument hook applied: " .. Name) end)
	end

	local final = block and (not from_executor or kind == "kick" or kind == "shutdown")
	local fake = nil
	if final then
		if kind == "loghistory" then
			fake = { }
		elseif kind == "purchase" then
			if Method == "UserOwnsGamePassAsync" or Method == "PlayerOwnsAsset" then
				fake = Settings.OwnsSpoof == "true"
			end
		elseif kind == "getattr" then
			local done, Value = pcall(UI.attr_fake, self, ...)
			if done then
				fake = Value
			end
		end
	end

	return final, replace, fake
end

