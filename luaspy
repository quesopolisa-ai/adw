find_owner = function(Log)
	Log.OwnerSearched = true
	task.spawn(function()
		local signal, Event = Log.Signal, Log.EventName
		local scanned = 0
		local callbacks = { }
		if Log.Kind == "connection" and getconnections then
			for _, record in Log.History or { } do
				if type(record.Args[1]) == "function" then
					callbacks[record.Args[1]] = true
				end
			end

			if type(Log.Args[1]) == "function" then
				callbacks[Log.Args[1]] = true
			end
		end

		local function matches(object)
			if next(callbacks) then
				local other = object[Event]
				if typeof(other) ~= "RBXScriptSignal" then
					return false
				end

				for _, Connection in getconnections(other) do
					if callbacks[Connection.Function] then
						return true
					end
				end

				return false
			end

			return object[Event] == signal
		end

		local function check(list)
			for _, object in list do
				local ok, same = pcall(matches, object)
				if ok and same then
					return object
				end

				scanned += 1
				if scanned % 4000 == 0 then
					task.wait()
				end
			end

			return nil
		end

		local found = nil
		local Gui = players.LocalPlayer.FindFirstChildOfClass(players.LocalPlayer, "PlayerGui")
		if Gui then
			found = check(Gui.GetDescendants(Gui))
		end

		if not found then
			local ok, all = pcall(game.GetDescendants, game)
			found = check(ok and all or { })
		end

		if not found and getnilinstances then
			local ok_nil, nils = pcall(getnilinstances)
			found = check(ok_nil and nils or { })
		end

		Log.Owner = found
		if found and selected == Log then
			show_details(Log, true)
			render()
		elseif not found then
			set_status("couldn't find which instance owns " .. tostring(Event))
		end
	end)
end

