function __R.serialize_table(Value, depth, seen, context)
	if seen[Value] then
		return "{} --[[ cycle ]]"
	end

	if depth > 25 then
		return "{} --[[ too deep ]]"
	end

	seen[Value] = true
	local indent = string.rep("    ", depth + 1)
	local lines = { }
	local length = rawlen(Value)
	local count = 0
	for index = 1, length do
		count += 1
		if count > 1000 then
			table.insert(lines, indent .. "-- ...")
			break
		end

		table.insert(lines, indent .. serialize(rawget(Value, index), depth + 1, seen, context) .. ",")
	end

	local keys = { }
	for key in next, Value do
		if not (type(key) == "number" and key >= 1 and key <= length and key % 1 == 0) then
			table.insert(keys, key)
		end
	end

	table.sort(keys, function(A, B)
		if type(A) == type(B) and (type(A) == "number" or type(A) == "string") then
			return A < B
		end

		return type(A) < type(B)
	end)

	for _, key in keys do
		count += 1
		if count > 1000 then
			table.insert(lines, indent .. "-- ...")
			break
		end

		local key_text
		if type(key) == "string" and string.match(key, "^[%a_][%w_]*$") then
			key_text = key
		else
			key_text = "[" .. serialize(key, depth + 1, seen, context) .. "]"
		end

		table.insert(lines, indent .. key_text .. " = " .. serialize(Value[key], depth + 1, seen, context) .. ",")
	end

	seen[Value] = nil
	if #lines == 0 then
		return "{}"
	end

	return "{\n" .. table.concat(lines, "\n") .. "\n" .. string.rep("    ", depth) .. "}"
end

