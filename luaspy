function __R.parse_value(raw)
	local Lower = string.lower(raw)
	if Lower == "true" then
		return true
	elseif Lower == "false" then
		return false
	elseif Lower == "nil" then
		return nil
	end

	local code = nil
	if string.sub(raw, 1, 1) == "{" or string.match(raw, "^[%a_][%w_]*%s*=[^=]") then
		code = string.sub(raw, 1, 1) == "{" and raw or ("{" .. raw .. "}")
	elseif string.match(raw, "^[%a_][%w_%.]*%.new%(") or string.match(raw, "^Enum%.") or string.match(raw, "^CFrame%.") or string.match(raw, "^Color3%.") then
		code = raw
	end

	if code and loadstring then
		local compiled = loadstring("return " .. code)
		if compiled then
			local ok, Value = pcall(compiled)
			if ok then
				return Value
			end
		end
	end

	local quoted = string.match(raw, '^"(.*)"$') or string.match(raw, "^'(.*)'$")
	if quoted then
		return quoted
	end

	return tonumber(raw) or raw
end

function __R.show_value(Value)
	if type(Value) == "string" then
		return '"' .. Value .. '"'
	elseif type(Value) == "table" then
		local ok, code = pcall(serialize, Value)
		return ok and (string.gsub(code, "%s+", " ")) or tostring(Value)
	end

	return tostring(Value)
end

