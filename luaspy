X.hook_function = (raw_hook or (oth and oth.hook)) and function(target, replacement, filter)
	local old
	if env.__LarpUseOth and oth and oth.hook and X.is_c(target) then
		local ok, result = pcall(oth.hook, target, replacement, filter)
		if ok then
			X.raw_insert(env.__LarpSpyHooks, {Target = target, Old = result, Oth = true})
			return result
		end

		env.__LarpOthError = tostring(result)
	end

	if env.__LarpUseOth and X.real_c_closure ~= nil and islclosure and islclosure(replacement) then
		replacement = X.real_c_closure(replacement)
	end

	old = (raw_hook or replaceclosure)(target, replacement)
	X.raw_insert(env.__LarpSpyHooks, {Target = target, Old = old})
	return old
end

X.set_identity = setthreadidentity or set_thread_identity or (syn and syn.set_thread_identity)
X.with_identity = function(fn)
	if not fn then return fn end
	return function(...)
		local low = env.__LarpLowLevel and X.set_identity
		if low then pcall(X.set_identity, 2) end
		local results = table.pack(pcall(fn, ...))
		if low then pcall(X.set_identity, 8) end
		if not results[1] then error(results[2], 0) end
		return table.unpack(results, 2, results.n)
	end
end
