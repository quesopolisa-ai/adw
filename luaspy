			end

			local block, replace, fake = __R.capture(self, Method, true, ...)
			if block then
				return fake
			end

			if replace then
				return old(self, table.unpack(replace, 1, replace.n))
			end

			return old(self, ...)
		end), UI.direct_filter(Method))
		shared.Installed[key] = true
	end)
end

